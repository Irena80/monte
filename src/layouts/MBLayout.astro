---
// MBLayout – Shared layout for all MediteranoBay pages
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  /** Highlight a nav link as current page ('upplevelser' | 'montenegro' | 'journal' | 'om') */
  activeNav?: string;
}

const {
  title,
  description = 'Vi skapar skräddarsydda företagsupplevelser i Montenegro där natur, möten och gemenskap blir en del av resan.',
  ogImage = '/images/kotorbukten.jpg',
  ogUrl = 'https://mediteranobay.com',
  activeNav = '',
} = Astro.props;
---

<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://mediteranobay.com${ogImage}`} />
  <meta property="og:locale" content="sv_SE" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style is:global>
    /* ===== TOKENS ===== */
    :root {
      --navy: #0b3c5d;
      --navy-dark: #071e2e;
      --gold: #c9a227;
      --gold-light: #e8bb3d;
      --gold-dark: #a88420;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif; color: #1a1a2e; background: #fff; -webkit-font-smoothing: antialiased; }

    /* ===== ANIMATIONS ===== */
    .fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }

    /* ===== SHARED BUTTONS ===== */
    .btn-gold { display: inline-flex; align-items: center; gap: 10px; background: var(--gold); color: #fff; font-weight: 700; font-size: 12px; letter-spacing: 0.08em; padding: 14px 28px; border-radius: 4px; text-decoration: none; text-transform: uppercase; border: none; cursor: pointer; font-family: inherit; }
    .btn-gold:hover { background: var(--gold-dark); }

    /* ===== NAV ===== */
    #navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(255,255,255,0.97); border-bottom: 1px solid rgba(0,0,0,0.07); backdrop-filter: blur(8px); }
    .nav-inner { max-width: 1280px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-icon { width: 34px; height: 34px; background: var(--navy); border-radius: 4px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .nav-logo-wordmark { display: flex; flex-direction: column; }
    .nav-logo-name { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; color: var(--navy); line-height: 1.1; text-transform: uppercase; }
    .nav-logo-sub { font-size: 8px; font-weight: 500; letter-spacing: 0.16em; color: #9ca3af; text-transform: uppercase; line-height: 1.2; }
    .nav-links { display: none; align-items: center; gap: 28px; }
    .nav-links a { font-size: 11px; font-weight: 700; color: #374151; text-decoration: none; letter-spacing: 0.1em; text-transform: uppercase; }
    .nav-links a:hover { color: var(--navy); }
    .nav-links a[aria-current="page"] { color: var(--gold); }
    .nav-cta { background: var(--gold); color: #fff; font-size: 11px; font-weight: 700; padding: 10px 20px; border-radius: 4px; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
    .nav-cta:hover { background: var(--gold-dark); }
    .hamburger { display: flex; flex-direction: column; gap: 5px; padding: 4px; background: none; border: none; cursor: pointer; }
    .hamburger span { width: 22px; height: 2px; background: #374151; border-radius: 2px; display: block; }
    .mobile-menu { display: none; border-top: 1px solid #f3f4f6; padding: 12px 24px 16px; background: #fff; }
    .mobile-menu a { display: block; padding: 10px 0; font-size: 13px; font-weight: 600; color: #374151; text-decoration: none; border-bottom: 1px solid #f3f4f6; letter-spacing: 0.05em; text-transform: uppercase; }
    .mobile-menu a:last-child { border-bottom: none; }

    /* ===== HERO (static image) ===== */
    .hero { position: relative; min-height: 72vh; display: flex; align-items: center; overflow: hidden; margin-top: 68px; }
    .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(7,30,46,0.72) 45%, rgba(7,30,46,0.28) 100%); }
    .hero-scroll { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; opacity: 0.55; }
    .hero-scroll-line { width: 1px; height: 36px; background: #fff; animation: scrollpulse 1.8s ease-in-out infinite; }
    @keyframes scrollpulse { 0%, 100% { opacity: 0.4; transform: scaleY(1); } 50% { opacity: 1; transform: scaleY(1.2); } }
    .hero-content { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; padding: 80px 32px; width: 100%; }
    .hero-kicker { font-size: 10px; font-weight: 700; letter-spacing: 0.24em; color: var(--gold); text-transform: uppercase; margin-bottom: 16px; }
    .hero-title { font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.06; color: #fff; letter-spacing: -0.025em; max-width: 620px; margin-bottom: 20px; }
    .hero-sub { font-size: clamp(0.95rem, 1.5vw, 1.05rem); color: rgba(255,255,255,0.75); max-width: 420px; line-height: 1.75; margin-bottom: 36px; }

    /* ===== INTRO SECTION ===== */
    .page-intro { padding: 88px 32px 72px; background: #fff; }
    .page-intro-inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .intro-kicker { font-size: 10px; font-weight: 700; letter-spacing: 0.22em; color: var(--gold); text-transform: uppercase; margin-bottom: 14px; }
    .intro-title { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 800; color: #0d2235; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 0; }
    .intro-body { font-size: 15px; color: #6b7280; line-height: 1.8; padding-top: 6px; }

    /* ===== PLACEHOLDER SECTION ===== */
    .placeholder-section { padding: 80px 32px; }
    .placeholder-section:nth-child(even) { background: #f8f6f1; }
    .placeholder-inner { max-width: 1280px; margin: 0 auto; }
    .placeholder-label { font-size: 10px; font-weight: 700; letter-spacing: 0.2em; color: #d1d5db; text-transform: uppercase; margin-bottom: 16px; }
    .placeholder-block { background: #f3f4f6; border: 1.5px dashed #e5e7eb; border-radius: 6px; min-height: 200px; display: flex; align-items: center; justify-content: center; }
    .placeholder-block span { font-size: 13px; color: #9ca3af; font-weight: 500; }

    /* ===== CTA BANNER ===== */
    .cta-banner { position: relative; overflow: hidden; background: #0d2235; }
    .cta-banner-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.22; }
    .cta-banner-inner { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 96px 32px; }
    .cta-banner-title { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 800; color: #fff; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 16px; max-width: 640px; }
    .cta-banner-desc { font-size: 15px; color: rgba(255,255,255,0.65); line-height: 1.75; margin-bottom: 36px; max-width: 480px; }

    /* ===== FOOTER ===== */
    .footer { background: var(--navy); padding: 64px 32px 32px; }
    .footer-inner { max-width: 1280px; margin: 0 auto; }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 48px; }
    .footer-logo-wrap { display: flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 14px; }
    .footer-logo-icon { width: 34px; height: 34px; background: rgba(255,255,255,0.1); border-radius: 4px; display: flex; align-items: center; justify-content: center; }
    .footer-logo-name { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: #fff; }
    .footer-tagline { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.7; margin-bottom: 20px; }
    .social-row { display: flex; gap: 10px; }
    .social-btn { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.2s; }
    .social-btn:hover { background: rgba(255,255,255,0.2); }
    .footer-col-label { font-size: 9px; font-weight: 800; letter-spacing: 0.2em; color: rgba(255,255,255,0.3); text-transform: uppercase; margin-bottom: 16px; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-links a { font-size: 13px; color: rgba(255,255,255,0.58); text-decoration: none; }
    .footer-links a:hover { color: #fff; }
    .footer-links li span { font-size: 13px; color: rgba(255,255,255,0.58); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 24px; font-size: 11px; color: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: space-between; }
    .footer-bottom a { color: rgba(255,255,255,0.35); text-decoration: none; }
    .footer-bottom a:hover { color: rgba(255,255,255,0.7); }

    /* ===== RESPONSIVE ===== */
    @media (min-width: 1024px) {
      .nav-links { display: flex; }
      .hamburger { display: none; }
    }
    @media (max-width: 1023px) {
      .page-intro-inner { grid-template-columns: 1fr; gap: 24px; }
      .footer-grid { grid-template-columns: 1fr 1fr 1fr; }
    }
    @media (max-width: 767px) {
      .hero { min-height: 78vh; }
      .page-intro { padding: 64px 24px 56px; }
      .placeholder-section { padding: 56px 24px; }
      .cta-banner-inner { padding: 72px 24px; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
      .footer-bottom { flex-direction: column; gap: 8px; }
    }

    /* ============================================================
       SHARED PAGE BUILDING BLOCKS — used by all modernised pages
       ============================================================ */

    /* Typography helpers */
    .pg-kicker { font-size: 10px; font-weight: 700; letter-spacing: 0.22em; color: var(--gold); text-transform: uppercase; margin-bottom: 14px; }
    .pg-h2 { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 800; color: #0d2235; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 20px; }
    .pg-h2-center { text-align: center; max-width: 100%; }
    .pg-body { font-size: 14px; color: #6b7280; line-height: 1.8; margin-bottom: 28px; }

    /* Section wrappers */
    .pg-section { padding: 88px 32px; }
    .pg-section-cream { background: #f8f6f1; }
    .pg-section-white { background: #fff; }
    .pg-inner { max-width: 1280px; margin: 0 auto; }
    .pg-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }

    /* Feature bar */
    .pg-feature-bar { padding: 22px 32px; background: #fff; border-bottom: 1px solid #f0f0f0; }
    .pg-feature-bar-inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
    .pg-feature-item { display: flex; align-items: center; justify-content: center; gap: 10px; }
    .pg-feature-icon { color: var(--gold); flex-shrink: 0; }
    .pg-feature-label { font-size: 12px; font-weight: 600; color: #374151; }

    /* Checklist */
    .pg-checks { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .pg-check { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: #374151; font-weight: 500; }
    .pg-check-icon { flex-shrink: 0; margin-top: 1px; color: var(--gold); }

    /* Image + stats block */
    .pg-img-main { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 6px 6px 0 0; display: block; }
    .pg-stats { display: grid; grid-template-columns: repeat(3,1fr); background: #0d2235; border-radius: 0 0 6px 6px; }
    .pg-stat { padding: 20px 16px; text-align: center; border-right: 1px solid rgba(255,255,255,0.1); }
    .pg-stat:last-child { border-right: none; }
    .pg-stat-num { font-size: 1.6rem; font-weight: 800; color: #fff; letter-spacing: -0.02em; line-height: 1; margin-bottom: 4px; }
    .pg-stat-label { font-size: 11px; color: rgba(255,255,255,0.55); }

    /* Image gallery */
    .pg-gallery-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
    .pg-gallery-3 img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 6px; display: block; }

    /* Program steps */
    .pg-steps { display: grid; gap: 0; margin-top: 56px; position: relative; }
    .pg-steps-4 { grid-template-columns: repeat(4,1fr); }
    .pg-steps-3 { grid-template-columns: repeat(3,1fr); }
    .pg-steps-4::before { content: ''; position: absolute; top: 24px; left: 12.5%; right: 12.5%; height: 1px; background: #e5e7eb; z-index: 0; }
    .pg-steps-3::before { content: ''; position: absolute; top: 24px; left: 16.67%; right: 16.67%; height: 1px; background: #e5e7eb; z-index: 0; }
    .pg-step { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 16px; position: relative; z-index: 1; }
    .pg-step-day { font-size: 9px; font-weight: 700; letter-spacing: 0.18em; color: var(--gold); text-transform: uppercase; margin-bottom: 8px; }
    .pg-step-circle { width: 48px; height: 48px; background: #0d2235; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; flex-shrink: 0; }
    .pg-step-title { font-size: 14px; font-weight: 800; color: #0d2235; margin-bottom: 8px; line-height: 1.2; }
    .pg-step-desc { font-size: 12px; color: #6b7280; line-height: 1.65; }

    /* Service cards */
    .pg-svc-grid { display: grid; gap: 14px; }
    .pg-svc-grid-5 { grid-template-columns: repeat(5,1fr); }
    .pg-svc-grid-3 { grid-template-columns: repeat(3,1fr); }
    .pg-svc-card { background: #fff; border-radius: 6px; overflow: hidden; transition: box-shadow 0.3s; text-decoration: none; display: flex; flex-direction: column; }
    .pg-svc-card:hover { box-shadow: 0 8px 28px rgba(13,34,53,0.12); }
    .pg-svc-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; transition: transform 0.5s ease; }
    .pg-svc-card:hover .pg-svc-img { transform: scale(1.04); }
    .pg-svc-img-wrap { overflow: hidden; flex-shrink: 0; }
    .pg-svc-body { padding: 18px 16px 20px; display: flex; flex-direction: column; flex: 1; }
    .pg-svc-icon { color: var(--gold); margin-bottom: 10px; }
    .pg-svc-title { font-size: 13px; font-weight: 800; color: #0d2235; margin-bottom: 6px; line-height: 1.2; }
    .pg-svc-desc { font-size: 12px; color: #6b7280; line-height: 1.6; flex: 1; margin-bottom: 14px; }
    .pg-svc-link { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; color: var(--gold); text-transform: uppercase; transition: gap 0.2s; }
    .pg-svc-card:hover .pg-svc-link { gap: 10px; }

    /* FAQ */
    .pg-faq-list { max-width: 760px; margin: 48px auto 0; }
    .pg-faq-item { border-bottom: 1px solid rgba(13,34,53,0.1); }
    .pg-faq-q { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 22px 0; cursor: pointer; font-size: 15px; font-weight: 700; color: #0d2235; line-height: 1.4; user-select: none; background: none; border: none; width: 100%; text-align: left; font-family: inherit; }
    .pg-faq-icon { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--navy); display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
    .pg-faq-icon svg { color: #fff; transition: transform 0.3s; }
    .pg-faq-item.open .pg-faq-icon { background: var(--gold); }
    .pg-faq-item.open .pg-faq-icon svg { transform: rotate(45deg); }
    .pg-faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .pg-faq-answer p { font-size: 14px; color: #4b5563; line-height: 1.8; padding-bottom: 22px; max-width: 640px; }
    .pg-faq-item.open .pg-faq-answer { max-height: 300px; }

    /* Testimonial */
    .pg-testimonial { padding: 80px 32px; background: #fff; }
    .pg-t-inner { max-width: 860px; margin: 0 auto; text-align: center; }
    .pg-t-quote { font-size: clamp(1.2rem, 2vw, 1.5rem); font-weight: 700; color: #0d2235; line-height: 1.5; letter-spacing: -0.01em; margin-bottom: 20px; font-style: italic; }
    .pg-t-author { font-size: 13px; color: #9ca3af; font-weight: 500; }

    /* Responsive – shared */
    @media (max-width: 1023px) {
      .pg-2col { grid-template-columns: 1fr; gap: 40px; }
      .pg-svc-grid-5 { grid-template-columns: repeat(3,1fr); }
      .pg-steps-4, .pg-steps-3 { grid-template-columns: repeat(2,1fr); gap: 32px; }
      .pg-steps-4::before, .pg-steps-3::before { display: none; }
      .pg-gallery-3 { grid-template-columns: repeat(2,1fr); }
      .pg-feature-bar-inner { grid-template-columns: repeat(2,1fr); }
    }
    @media (max-width: 767px) {
      .pg-section { padding: 64px 24px; }
      .pg-svc-grid-5, .pg-svc-grid-3 { grid-template-columns: repeat(2,1fr); }
      .pg-gallery-3 { grid-template-columns: 1fr 1fr; }
      .pg-feature-bar { padding: 18px 24px; }
    }
  </style>
  <slot name="head" />
  <!-- Page-level styles injected by each page -->
</head>
<body>

<!-- ===== NAVIGATION ===== -->
<nav id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="MediteranoBay hem">
      <div class="nav-logo-icon">
        <span style="color:#fff;font-weight:900;font-size:16px;letter-spacing:-1px;">M</span>
      </div>
      <div class="nav-logo-wordmark">
        <span class="nav-logo-name">MEDITERANOBAY</span>
        <span class="nav-logo-sub">Företagsupplevelser i Montenegro</span>
      </div>
    </a>
    <div class="nav-links">
      <a href="/upplevelser" aria-current={activeNav === 'upplevelser' ? 'page' : undefined}>Upplevelser</a>
      <a href="/montenegro" aria-current={activeNav === 'montenegro' ? 'page' : undefined}>Montenegro</a>
      <a href="/blog" aria-current={activeNav === 'journal' ? 'page' : undefined}>Journal</a>
      <a href="/om" aria-current={activeNav === 'om' ? 'page' : undefined}>Om oss</a>
      <a href="#kontakt">Kontakt</a>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="#kontakt" class="nav-cta">BOKA MÖTE</a>
      <button class="hamburger" id="menu-btn" aria-label="Öppna meny" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/upplevelser">Upplevelser</a>
    <a href="/montenegro">Montenegro</a>
    <a href="/blog">Journal</a>
    <a href="/om">Om oss</a>
    <a href="#kontakt">Kontakt</a>
  </div>
</nav>

<!-- ===== PAGE CONTENT ===== -->
<slot />

<!-- ===== FOOTER ===== -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-logo-wrap" aria-label="MediteranoBay">
          <div class="footer-logo-icon">
            <span style="color:#fff;font-weight:900;font-size:15px;">M</span>
          </div>
          <span class="footer-logo-name">MEDITERANOBAY</span>
        </a>
        <p class="footer-tagline">Vi skapar minnesvärda företagsupplevelser i Montenegro och västra Balkan.</p>
        <div class="social-row">
          <a href="https://linkedin.com/company/mediteranobay" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://instagram.com/mediteranobay" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="0.7" fill="#fff"/></svg>
          </a>
        </div>
      </div>
      <div>
        <div class="footer-col-label">Upplevelser</div>
        <ul class="footer-links">
          <li><a href="/ledningsretreat">Ledningsretreat</a></li>
