<script>
  // Mobile menu
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const open = mobileMenu.style.display === 'block';
      mobileMenu.style.display = open ? 'none' : 'block';
      menuBtn.setAttribute('aria-expanded', String(!open));
    });
  }
  // FAQ accordion (shared)
  document.querySelectorAll('.pg-faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.pg-faq-item') as HTMLElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.pg-faq-item.open').forEach(el => {
        el.classList.remove('open');
        (el.querySelector('.pg-faq-q') as HTMLElement).setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  // Fade-up on scroll
  const observer = new IntersectionObserver(
    (entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>

