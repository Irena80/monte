---
// Corporate Offsites landing page – redesigned
---

<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Corporate Offsites in Montenegro | MediteranoBay</title>
  <meta name="description" content="Vi skapar minnesvärda företagsresor, konferenser och teamupplevelser i en av Europas mest inspirerande destinationer." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://mediteranobay.com/landing/mediteranobay" />
  <meta property="og:title" content="Corporate Offsites in Montenegro | MediteranoBay" />
  <meta property="og:description" content="Vi skapar minnesvärda företagsresor, konferenser och teamupplevelser i en av Europas mest inspirerande destinationer." />
  <meta property="og:image" content="https://mediteranobay.com/images/kotorbukten.jpg" />
  <meta property="og:locale" content="sv_SE" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy: #0b3c5d;
      --navy-dark: #071e2e;
      --gold: #c9a227;
      --gold-light: #e8bb3d;
      --gold-dark: #a88420;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
      color: #1a1a2e;
      background: #fff;
      -webkit-font-smoothing: antialiased;
    }
    .fade-up {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }
    .delay-5 { transition-delay: 0.5s; }
    .delay-6 { transition-delay: 0.6s; }

    /* Nav */
    #navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: #fff; border-bottom: 1px solid #e9ecef; }
    .nav-inner { max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 70px; }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-icon { width: 36px; height: 36px; background: var(--navy); border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .nav-links { display: none; align-items: center; gap: 26px; }
    .nav-links a { font-size: 12px; font-weight: 700; color: #374151; text-decoration: none; letter-spacing: 0.06em; text-transform: uppercase; }
    .nav-links a:hover { color: var(--navy); }
    .nav-cta { background: var(--gold); color: #fff; font-size: 12px; font-weight: 700; padding: 10px 20px; border-radius: 6px; text-decoration: none; letter-spacing: 0.06em; white-space: nowrap; }
    .nav-cta:hover { opacity: 0.9; }
    .hamburger { display: flex; flex-direction: column; gap: 5px; padding: 4px; background: none; border: none; cursor: pointer; }
    .hamburger span { width: 22px; height: 2px; background: #374151; border-radius: 2px; display: block; }
    .mobile-menu { display: none; border-top: 1px solid #f3f4f6; padding: 12px 24px 16px; background: #fff; }
    .mobile-menu a { display: block; padding: 10px 0; font-size: 14px; font-weight: 600; color: #374151; text-decoration: none; border-bottom: 1px solid #f3f4f6; }
    .mobile-menu a:last-child { border-bottom: none; }

    /* Hero */
    .hero { position: relative; min-height: 88vh; display: flex; align-items: center; overflow: hidden; margin-top: 70px; }
    .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(7,30,46,0.78) 0%, rgba(7,30,46,0.5) 55%, rgba(7,30,46,0.2) 100%); }
    .hero-content { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; padding: 64px 24px; }
    .hero-title { font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.08; color: #fff; letter-spacing: -0.02em; max-width: 620px; margin-bottom: 20px; }
    .hero-sub { font-size: clamp(1rem, 1.8vw, 1.15rem); color: rgba(255,255,255,0.82); max-width: 500px; line-height: 1.65; margin-bottom: 36px; }
    .hero-btns { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
    .btn-gold { display: inline-flex; align-items: center; gap: 8px; background: var(--gold); color: #fff; font-weight: 700; font-size: 13px; letter-spacing: 0.05em; padding: 14px 28px; border-radius: 6px; text-decoration: none; border: none; cursor: pointer; }
    .btn-gold:hover { opacity: 0.9; }
    .btn-outline-white { display: inline-flex; align-items: center; gap: 10px; background: transparent; border: 2px solid rgba(255,255,255,0.55); color: #fff; font-weight: 600; font-size: 13px; letter-spacing: 0.05em; padding: 12px 22px; border-radius: 6px; cursor: pointer; }
    .btn-outline-white:hover { border-color: rgba(255,255,255,0.9); }

    /* Features bar */
    .features-bar { background: #fff; border-bottom: 1px solid #f0f0f0; padding: 48px 24px; }
    .features-grid { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: 24px; }
    .feature-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
    .feature-label { font-size: 11px; font-weight: 800; letter-spacing: 0.12em; color: #1a1a2e; text-transform: uppercase; line-height: 1.3; }
    .feature-desc { font-size: 12px; color: #6b7280; line-height: 1.5; }

    /* Packages */
    .packages-section { background: #f8f6f1; padding: 80px 24px; }
    .section-inner { max-width: 1280px; margin: 0 auto; }
    .section-label { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; color: var(--gold-dark); text-transform: uppercase; margin-bottom: 10px; }
    .section-title { font-size: clamp(1.9rem, 3.5vw, 2.6rem); font-weight: 800; color: var(--navy); letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 48px; }
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 40px; }
    .pkg-card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 14px rgba(0,0,0,0.07); }
    .pkg-img-wrap { position: relative; height: 220px; overflow: hidden; }
    .pkg-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .pkg-badge { position: absolute; top: 14px; left: 14px; width: 36px; height: 36px; background: #1a1a2e; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 15px; }
    .pkg-body { padding: 26px; }
    .pkg-title { font-size: 1.2rem; font-weight: 800; color: #1a1a2e; margin-bottom: 4px; }
    .pkg-subtitle { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; color: #9ca3af; text-transform: uppercase; margin-bottom: 16px; }
    .pkg-features { list-style: none; display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }
    .pkg-features li { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #4b5563; }
    .pkg-price { font-size: 14px; font-weight: 700; color: #1a1a2e; margin-bottom: 18px; }
    .pkg-price strong { font-size: 17px; }
    .btn-navy { display: block; text-align: center; background: var(--navy); color: #fff; font-weight: 700; font-size: 12px; letter-spacing: 0.1em; padding: 12px; border-radius: 8px; text-decoration: none; text-transform: uppercase; }
    .btn-navy:hover { opacity: 0.88; }
    .btn-outline-dark { display: inline-block; border: 1.5px solid #9ca3af; color: #374151; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; padding: 13px 36px; border-radius: 6px; text-decoration: none; text-transform: uppercase; }
    .btn-outline-dark:hover { border-color: #374151; }

    /* Why section */
    .why-section { background: #fff; padding: 80px 24px; }
    .why-section .section-title { text-align: center; margin-bottom: 56px; }
    .why-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 28px; }
    .why-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; }
    .why-icon { width: 52px; height: 52px; background: #f4f3ef; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .why-label { font-size: 11px; font-weight: 800; letter-spacing: 0.1em; color: #1a1a2e; text-transform: uppercase; line-height: 1.3; }
    .why-desc { font-size: 12px; color: #6b7280; line-height: 1.6; }

    /* Gallery */
    .gallery-section { background: #f8f6f1; padding: 64px 24px; text-align: center; }
    .gallery-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin: 32px 0; }
    .gallery-grid img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 8px; }

    /* Testimonials */
    .testimonials-section { background: #fff; padding: 80px 24px; }
    .testimonials-section .section-label { text-align: center; display: block; margin-bottom: 48px; }
    .testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-bottom: 36px; }
    .testimonial-item { display: flex; flex-direction: column; gap: 14px; }
    .quote-icon { width: 40px; height: 40px; background: #1a1a2e; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .testimonial-text { font-size: 14px; color: #374151; line-height: 1.75; font-style: italic; }
    .testimonial-author { font-size: 13px; font-weight: 600; color: #6b7280; }
    .dots { display: flex; justify-content: center; gap: 8px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; background: #d1d5db; display: inline-block; }
    .dot.active { background: var(--navy); }

    /* CTA + Form */
    .cta-section { background: var(--navy-dark); display: grid; grid-template-columns: 1fr 1fr; }
    .cta-left { position: relative; padding: 80px 48px; overflow: hidden; }
    .cta-left-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.22; }
    .cta-left-content { position: relative; z-index: 1; }
    .cta-title { font-size: clamp(1.6rem, 2.8vw, 2.4rem); font-weight: 800; color: #fff; line-height: 1.2; margin-bottom: 16px; }
    .cta-subtitle { font-size: 15px; color: rgba(255,255,255,0.7); line-height: 1.7; }
    .cta-right { background: #fff; padding: 48px 40px; }
    .form-heading { font-size: 11px; font-weight: 800; letter-spacing: 0.18em; color: var(--navy); text-transform: uppercase; margin-bottom: 28px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 0; }
    .form-label { font-size: 12px; font-weight: 600; color: #374151; }
    .form-input { border: 1px solid #e5e7eb; border-radius: 6px; padding: 10px 12px; font-size: 14px; font-family: inherit; outline: none; width: 100%; color: #1a1a2e; }
    .form-input:focus { border-color: var(--navy); }
    .form-stack { display: flex; flex-direction: column; gap: 14px; }
    .trust-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 6px; }
    .trust-item { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #9ca3af; }

    /* Footer */
    .footer { background: var(--navy); padding: 64px 24px 32px; }
    .footer-inner { max-width: 1280px; margin: 0 auto; }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 48px; }
    .footer-col-label { font-size: 10px; font-weight: 800; letter-spacing: 0.16em; color: rgba(255,255,255,0.38); text-transform: uppercase; margin-bottom: 18px; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-links a { font-size: 13px; color: rgba(255,255,255,0.62); text-decoration: none; }
    .footer-links a:hover { color: #fff; }
    .footer-links li span { font-size: 13px; color: rgba(255,255,255,0.62); }
    .footer-brand-text { font-size: 13px; color: rgba(255,255,255,0.52); line-height: 1.7; margin-bottom: 20px; }
    .social-row { display: flex; gap: 10px; }
    .social-btn { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.3); }

    /* Responsive */
    @media (min-width: 1024px) {
      .nav-links { display: flex; }
      .hamburger { display: none; }
    }
    @media (max-width: 1023px) {
      .features-grid { grid-template-columns: repeat(3, 1fr); }
      .why-grid { grid-template-columns: repeat(3, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 767px) {
      .cards-grid { grid-template-columns: 1fr; }
      .testimonials-grid { grid-template-columns: 1fr; }
      .cta-section { grid-template-columns: 1fr; }
      .cta-left { padding: 56px 24px; }
      .cta-right { padding: 40px 24px; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
      .gallery-grid img:last-child { display: none; }
      .features-grid { grid-template-columns: repeat(2, 1fr); }
      .why-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- ========== NAVIGATION ========== -->
<nav id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="MediteranoBay hem">
      <div class="nav-logo-icon">
        <span style="color:#fff;font-weight:900;font-size:18px;letter-spacing:-1px;">M</span>
      </div>
      <div>
        <div style="font-size:13px;font-weight:800;letter-spacing:0.07em;color:var(--navy);line-height:1.1;">MEDITERANOBAY</div>
        <div style="font-size:9px;font-weight:500;letter-spacing:0.14em;color:#9ca3af;text-transform:uppercase;line-height:1;">CORPORATE TRAVEL</div>
      </div>
    </a>

    <div class="nav-links">
      <a href="/">HEM</a>
      <a href="/resor/foretagsresor" style="display:flex;align-items:center;gap:3px;">FÖRETAGSRESOR
        <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </a>
      <a href="/kusten">DESTINATIONER</a>
      <a href="#paket">VÅRA PAKET</a>
      <a href="/om">OM OSS</a>
      <a href="/kontakt">KONTAKT</a>
    </div>

    <div style="display:flex;align-items:center;gap:10px;">
      <a href="#kontakt" class="nav-cta">BOKA MÖTE</a>
      <button class="hamburger" id="menu-btn" aria-label="Öppna meny" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/">HEM</a>
    <a href="/resor/foretagsresor">FÖRETAGSRESOR</a>
    <a href="/kusten">DESTINATIONER</a>
    <a href="#paket">VÅRA PAKET</a>
    <a href="/om">OM OSS</a>
    <a href="/kontakt">KONTAKT</a>
  </div>
</nav>

<!-- ========== HERO ========== -->
<section class="hero" aria-labelledby="hero-h1">
  <img class="hero-img" src="/images/kotorbukten.jpg" alt="Kotorbukten, Montenegro" loading="eager" fetchpriority="high" />
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 id="hero-h1" class="hero-title fade-up">
      Corporate Offsites<br/>in Montenegro
    </h1>
    <p class="hero-sub fade-up delay-1">
      Vi skapar minnesvärda företagsresor, konferenser och teamupplevelser i en av Europas mest inspirerande destinationer.
    </p>
    <div class="hero-btns fade-up delay-2">
      <a href="#kontakt" class="btn-gold">
        BOKA ETT KOSTNADSFRITT MÖTE
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <button class="btn-outline-white" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 19,12 5,21"/></svg>
        SE VIDEO
      </button>
    </div>
  </div>
</section>

<!-- ========== FEATURES BAR ========== -->
<section class="features-bar">
  <div class="features-grid">

    <div class="feature-item fade-up">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
      </svg>
      <div class="feature-label">NÄRA & ENKELT</div>
      <div class="feature-desc">Endast 2–3 timmars flyg från Sverige.</div>
    </div>

    <div class="feature-item fade-up delay-1">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 17l4-8 4 4 3-6 4 10H3z"/>
        <path d="M2 19c2.5-2 5-3 7-2s4 2 6 1 4-2.5 6-1.5"/>
      </svg>
      <div class="feature-label">NATUR & HAV</div>
      <div class="feature-desc">Adriatiska havet och imponerande berg.</div>
    </div>

    <div class="feature-item fade-up delay-2">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <path d="M3 9h18M9 9v12M15 9v12"/>
      </svg>
      <div class="feature-label">PREMIUM HOTELL</div>
      <div class="feature-desc">Moderna hotell och konferensanläggningar.</div>
    </div>

    <div class="feature-item fade-up delay-3">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 6v12M9 9.5C9 8.1 10.3 7 12 7s3 1.1 3 2.5S13.7 12 12 12s-3 1.4-3 2.5S10.3 17 12 17s3-1.1 3-2.5"/>
      </svg>
      <div class="feature-label">BÄTTRE VÄRDE</div>
      <div class="feature-desc">20–40% lägre kostnader än i Sydeuropa.</div>
    </div>

    <div class="feature-item fade-up delay-4">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2l8 3v7c0 5-3.5 9-8 10C7.5 21 4 17 4 12V5l8-3z"/>
        <path d="M9 12l2 2 4-4"/>
      </svg>
      <div class="feature-label">TRYGGT & SÄKERT</div>
      <div class="feature-desc">Ett stabilt och säkert resmål.</div>
    </div>

    <div class="feature-item fade-up delay-5">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="7" r="3"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>
        <circle cx="17" cy="7" r="3"/><path d="M21 21v-2a4 4 0 00-4-4"/>
      </svg>
      <div class="feature-label">PERFEKT FÖR TEAM</div>
      <div class="feature-desc">Aktiviteter året runt för starka teamupplevelser.</div>
    </div>

  </div>
</section>

<!-- ========== PACKAGES ========== -->
<section id="paket" class="packages-section">
  <div class="section-inner">
    <div class="fade-up">
      <div class="section-label">VÅRA PAKET</div>
      <h2 class="section-title">Resor som skapar resultat</h2>
    </div>

    <div class="cards-grid">

      <!-- Card 1 -->
      <div class="pkg-card fade-up delay-1">
        <div class="pkg-img-wrap">
          <img src="/images/majestic.jpg" alt="Leadership Retreat" loading="lazy" />
          <div class="pkg-badge">1</div>
        </div>
        <div class="pkg-body">
          <h3 class="pkg-title">Leadership Retreat</h3>
          <div class="pkg-subtitle">EXECUTIVE ESCAPE</div>
          <ul class="pkg-features">
            {['3 dagar / 2 nätter', '8–20 personer', 'Strategimöten i inspirerande miljö', 'Hotell 4–5★, konferenslokal, måltider', 'Båtutflykt & lokal guide'].map(f => (
              <li>
                <svg style="flex-shrink:0;margin-top:1px;" width="15" height="15" viewBox="0 0 20 20" fill="var(--gold)"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <div class="pkg-price">Från <strong>9 900</strong> SEK / person</div>
          <a href="#kontakt" class="btn-navy">LÄS MER</a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="pkg-card fade-up delay-2">
        <div class="pkg-img-wrap">
          <img src="/images/konferens.webp" alt="Build Stronger Teams" loading="lazy" />
          <div class="pkg-badge">2</div>
        </div>
        <div class="pkg-body">
