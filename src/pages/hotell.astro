---
// Hotell – moderniserad med MBLayout (innehåll oförändrat)
import MBLayout from '../layouts/MBLayout.astro';
---

<MBLayout
  title="Utbud av bästa hotell — MediteranoBay"
  description="Handplockade boenden för grupper och företag – kvalitet, läge och service i toppklass."
  ogImage="/images/mamula2.jpg"
  ogUrl="https://mediteranobay.com/hotell"
  activeNav=""
>

<Fragment slot="head">
<style is:global>
  /* ===== HOTEL ROWS ===== */
  .htl-list { max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 0; }
  .htl-row { display: grid; grid-template-columns: 1fr 1fr; min-height: 340px; border-bottom: 1px solid #f0f0f0; }
  .htl-row:last-child { border-bottom: none; }
  .htl-img-wrap { overflow: hidden; position: relative; }
  .htl-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .htl-row:hover .htl-img { transform: scale(1.02); }
  .htl-body { padding: 52px 64px; display: flex; flex-direction: column; justify-content: center; background: #fff; }
  .htl-stars { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; color: var(--gold); text-transform: uppercase; margin-bottom: 12px; }
  .htl-title { font-size: clamp(1.3rem, 2vw, 1.7rem); font-weight: 800; color: #0d2235; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 16px; }
  .htl-desc { font-size: 14px; color: #6b7280; line-height: 1.8; }

  /* ===== RESORT CARDS (bottom grid) ===== */
  .htl-resorts { padding: 88px 32px; background: #f8f6f1; }
  .htl-resorts-inner { max-width: 1280px; margin: 0 auto; }
  .htl-resort-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 48px; }
  .htl-resort-card { position: relative; overflow: hidden; border-radius: 6px; display: block; text-decoration: none; }
  .htl-resort-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .htl-resort-card:hover img { transform: scale(1.04); }
  .htl-resort-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,30,46,0.75) 0%, transparent 55%); }
  .htl-resort-title { position: absolute; bottom: 20px; left: 22px; font-size: 15px; font-weight: 800; color: #fff; letter-spacing: -0.01em; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1023px) {
    .htl-body { padding: 40px 40px; }
    .htl-resort-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .htl-row { grid-template-columns: 1fr; }
    .htl-img-wrap { min-height: 260px; }
    .htl-body { padding: 36px 24px; }
    .htl-resorts { padding: 64px 24px; }
    .htl-resort-grid { grid-template-columns: 1fr; }
  }
</style>
</Fragment>

<!-- ===== HERO ===== -->
<section class="hero" aria-labelledby="hero-h1">
  <img class="hero-img" src="/images/mamula2.jpg" alt="Hotell vid Adriatiska kusten" />
  <div class="hero-overlay"></div>
  <div class="hero-scroll" aria-hidden="true"><div class="hero-scroll-line"></div></div>
  <div class="hero-content">
    <div class="hero-kicker fade-up">Utvalda hotell</div>
    <h1 id="hero-h1" class="hero-title fade-up delay-1">
      Vårt urval av<br />hotell.
    </h1>
    <p class="hero-sub fade-up delay-2">
      Handplockade boenden för grupper och företag – kvalitet, läge och service i toppklass.
    </p>
    <a href="#kontakt" class="btn-gold fade-up delay-3">
      KONTAKTA OSS OM HOTELL
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>

<!-- ===== HOTEL LISTINGS ===== -->
<section class="pg-section pg-section-white" style="padding-bottom:0;">
  <div class="htl-list fade-up">

    <!-- 1. Mamula Island Hotel -->
    <div class="htl-row">
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/mamulahotel1.webp" alt="Mamula Island Hotel" loading="lazy" />
      </div>
      <div class="htl-body">
        <div class="htl-stars">★★★★★</div>
        <h2 class="htl-title">Montenegros häftigaste hotell – ett historiskt fort på öde ö</h2>
        <p class="htl-desc">Så fort man stiger i land på ön Mamula i Montenegro känner man historiens vingslag. Upplevelsen att bo i en utsökt restaurerad fästning från 1800-talet, belägen på sin egen ö vid inloppet till en av världens vackraste havsvikar är skäl nog att resa hit. Till Mamula Island Hotel kommer gäster även för den utsökta maten, atmosfären och för att känna historiens vingslag. Det börjar redan då du byter ditt bagage mot ett glas champagne på motorbåten på väg ut till ön.</p>
      </div>
    </div>

    <!-- 2. Lazure -->
    <div class="htl-row">
      <div class="htl-body">
        <div class="htl-stars">★★★★★</div>
        <h2 class="htl-title">Lazure Hotel &amp; Marina</h2>
        <p class="htl-desc">Med utsikt över Kotorbukten erbjuder Lazure Hotel &amp; Marina lyxigt boende, endast 2 km från Herceg Novi. Kliv in i ett klassiskt men moderniserat hotell, där de 300 år gamla väggarna har bevittnat Montenegros stora historiska händelser. Resorten har egen strand, egen pool och egen marina. När det kommer till fler bekvämligheter så finns två restauranger, en säsongsöppen strandbar samt en lobbybar. Väldisponibla konferensanläggningar finns att tillgå även för team och företagsbehov.</p>
      </div>
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/lazure.webp" alt="Lazure Hotel & Marina" loading="lazy" />
      </div>
    </div>

    <!-- 3. The Chedi -->
    <div class="htl-row">
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/chedi2.jpg" alt="The Chedi Luštica Bay" loading="lazy" />
      </div>
      <div class="htl-body">
        <div class="htl-stars">★★★★★ · The Leading Hotels of the World</div>
        <h2 class="htl-title">The Chedi Luštica Bay</h2>
        <p class="htl-desc">Där det mjuka azurblå havet möter de majestätiska bergen hittar du The Chedi Luštica Bay – ett lyxigt femstjärnigt hotell i Montenegro. Beläget vid den magnifika montenegrinska kusten, 16 km från Tivat, erbjuder The Chedi 111 exceptionellt eleganta rum och sviter, två restauranger, två barer, flexibla möteslokaler, en privat strand, ett asiatiskt inspirerat spa, inomhuspool och en infinitypool utomhus.</p>
      </div>
    </div>

    <!-- 4. Palmon Bay -->
    <div class="htl-row">
      <div class="htl-body">
        <div class="htl-stars">★★★★</div>
        <h2 class="htl-title">Hotel and Spa Palmon Bay</h2>
        <p class="htl-desc">Palmon Bay Spa 4* är ett nytt och modernt hotell beläget i Igalo, precis vid havet. Hotellet har 163 rum, varav många med havsutsikt. Alla luftkonditionerade rum har en möblerad balkong med utsikt över inloppet till Boka Kotorska-bukten. Gäster kan njuta av mat och dryck i någon av hotellets restauranger. Spa- och wellnesscentret erbjuder finsk och infraröd bastu, bubbelpool, hamam och ett fitnesscenter.</p>
      </div>
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/palmon.jpg" alt="Hotel and Spa Palmon Bay" loading="lazy" />
      </div>
    </div>

    <!-- 5. Iberostar -->
    <div class="htl-row">
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/ib.jpg" alt="Iberostar hotell med privat strand" loading="lazy" />
      </div>
      <div class="htl-body">
        <div class="htl-stars">★★★★ · Privat strand</div>
        <h2 class="htl-title">Iberostar hotell med privat strand</h2>
        <p class="htl-desc">Med direkt, privat tillgång till stranden, 26 km från Dubrovniks flygplats och nära Kotor, Perast och Herceg Novi. Njut av lokal gastronomi och medelhavsmat och missa inte den oförglömliga utsikten från Rooftop Bar och Beach Snack Bar med utsikt över havet. Upptäck Montenegros unika mysterium!</p>
      </div>
    </div>

    <!-- 6. Hotel Budva -->
    <div class="htl-row">
      <div class="htl-body">
        <div class="htl-stars">★★★★</div>
        <h2 class="htl-title">Hotel Budva</h2>
        <p class="htl-desc">Hotel Budva ligger i centrala Budva, precis vid strandpromenaden och bara några steg från sandstranden och småbåtshamnen i Slovenska. Här finns en restaurang, bar och ett hälsocenter. Konferensanläggning med integrerad, toppmodern ljud- och videoutrustning.</p>
      </div>
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/hotel-budva.jpg" alt="Hotel Budva" loading="lazy" />
      </div>
    </div>

    <!-- 7. Splendid -->
    <div class="htl-row">
      <div class="htl-img-wrap">
        <img class="htl-img" src="/images/splendid.jpg" alt="Splendid Konferens & Spa" loading="lazy" />
      </div>
      <div class="htl-body">
        <div class="htl-stars">★★★★★ · Konferens & Spa</div>
        <h2 class="htl-title">Splendid Konferens &amp; Spa</h2>
        <p class="htl-desc">Det lyxiga 5-stjärniga hotellet Splendid ligger på en lång sandstrand i hjärtat av Bečići, bara 2 km från Budvas gamla stadskärna. Magnifikt spa med uppvärmda inomhuspooler, bastur, bubbelpooler och ångbad med Swarovski-kristaller. Stor konferenslokal med kapacitet för upp till 1&nbsp;000 personer och flera mötesrum för upp till 200 personer.</p>
      </div>
    </div>

  </div>
</section>

<!-- ===== SPEKTAKULÄRA RESORT ===== -->
<section class="htl-resorts">
  <div class="htl-resorts-inner">
    <div class="fade-up">
      <div class="pg-kicker">Spektakulära resort</div>
      <h2 class="pg-h2">Exklusiva resorts<br />längs kusten.</h2>
    </div>
    <div class="htl-resort-grid fade-up delay-1">

      <a href="https://www.portomontenegro.com/" target="_blank" rel="noopener noreferrer" class="htl-resort-card">
        <img src="/images/portotivat.jpg" alt="Porto Montenegro" loading="lazy" />
        <div class="htl-resort-overlay"></div>
        <span class="htl-resort-title">Porto Montenegro</span>
      </a>

      <a href="https://portonovi.com/" target="_blank" rel="noopener noreferrer" class="htl-resort-card">
        <img src="/images/onlyportonovi.webp" alt="One & Only Portonovi" loading="lazy" />
        <div class="htl-resort-overlay"></div>
        <span class="htl-resort-title">One &amp; Only Portonovi</span>
      </a>

      <a href="/boka" class="htl-resort-card">
        <img src="/images/lustica.webp" alt="Luštica Resort" loading="lazy" />
        <div class="htl-resort-overlay"></div>
        <span class="htl-resort-title">Luštica Resort</span>
      </a>

    </div>
  </div>
</section>

<!-- ===== CTA (Lord Byron quote) ===== -->
<section class="cta-banner" id="kontakt">
  <img class="cta-banner-bg" src="/images/kotorbukten.jpg" alt="" aria-hidden="true" loading="lazy" />
  <div class="cta-banner-inner" style="text-align:center;">
    <p class="fade-up" style="font-size:clamp(1rem,1.5vw,1.2rem);color:rgba(255,255,255,0.55);letter-spacing:0.14em;text-transform:uppercase;margin-bottom:20px;">Lord Byron</p>
    <h2 class="cta-banner-title fade-up delay-1" style="max-width:800px;margin:0 auto 24px;font-style:italic;font-size:clamp(1.3rem,2.5vw,2rem);">
      "At the birth of our planet, the most beautiful encounter between the land and the sea must have happened at the coast of Montenegro."
    </h2>
    <a href="/kontakt" class="btn-gold fade-up delay-2" style="display:inline-flex;">
      KONTAKTA OSS OM HOTELL
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>

</MBLayout>
