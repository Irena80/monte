---
import Layout from '../layouts/PageLayout.astro';

const metadata = {
  title: 'Boka ett samtal – MediteranoBay',
  description: 'Boka ett möte med oss för att prata företagsresor, gruppresor eller sportresor till Montenegro.',
};
---

<Layout metadata={metadata}>
  <section class="py-10 sm:py-14" data-section="calendly">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900">Boka ett samtal</h1>
      <p class="mt-3 text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">Välj den tid som passar er. Bokningen sker via Calendly och bekräftelse skickas direkt till er kalender.</p>
      <div class="mt-6">
        <a href="https://calendly.com/mediteranobay" target="_blank" rel="noopener" class="text-blue-700 font-semibold underline underline-offset-4">Öppna i ny flik</a>
      </div>
    </div>
    <div class="max-w-6xl mx-auto px-4 mt-8">
      <!-- Calendly inline widget begin -->
      <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
      <div class="calendly-inline-widget w-full rounded-xl shadow-lg ring-1 ring-slate-200" data-url="https://calendly.com/mediteranobay" style="min-width:320px; height: 1000px;"></div>
      <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
      <!-- Calendly inline widget end -->
    </div>
  </section>
</Layout>
