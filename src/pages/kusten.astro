---
import Layout from '~/layouts/PageLayout.astro';
import { kustDestinations } from '~/data/kustenDestinations';
---

  
<Layout metadata={{ title: 'Kusten' }}>
  <!-- Hero Section with full-bleed video -->
  <section class="relative w-full min-h-[520px] sm:min-h-[560px] md:min-h-[640px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="auto" aria-hidden="true">
        <source src="/videos/vildamng.webm" type="video/webm" />
        <source src="/videos/vildamng.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/35 to-black/65 z-10"></div>
    <div class="relative z-20 px-4 w-full max-w-4xl text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight tracking-tight text-white drop-shadow-[0_4px_18px_rgba(0,0,0,0.55)]">
        Upptäck <span class="text-amber-300 md:text-amber-500">kontrasternas</span> land
      </h1>
      <p class="text-lg md:text-2xl text-white/90 max-w-2xl mx-auto mb-8 leading-relaxed">
        Upplev kusten året runt – äventyr, natur och kultur för den aktiva och nyfikna resenären.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/boka" class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold bg-white/15 hover:bg-white/25 text-white backdrop-blur-sm border border-white/20 shadow transition text-lg">
          Boka
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
        <a href="/resor/gruppresor" class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold bg-white/10 hover:bg-white/20 text-white backdrop-blur-sm border border-white/15 shadow transition text-lg">
          Gruppresor
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <style>
        @media (prefers-reduced-motion: reduce){ section[data-reduced-motion] video { display:none; } }
      </style>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-4 text-blue-1000">Adriatiska havets juvel</h2>
      <p class="text-lg md:text-xl text-gray-700">
        Låt oss ta dig med på en upptäcktsresa, från Adriatiska kusten till den montenegrinska landsbygden. Ett noggrant utvalt urval av oförglömliga upplevelser, personliga turer och exklusiva gourmetresor. Upptäck regionens kulinariska mästerverk, njut av förstklassiga lokala viner och låt dig förföras av skräddarsydda cocktails som speglar Montenegros unika charm och kultur.
      </p>
    </div>
<!-- Grid Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
  {kustDestinations.map(d => (
    <div class="flex flex-col md:flex-row bg-blue-50 rounded-xl shadow-md overflow-hidden" data-destination={d.slug}>
      <img src={d.image} alt={d.imageAlt} class="w-full md:w-1/2 h-80 object-cover" loading="lazy" decoding="async" />
      <div class="p-5 flex flex-col justify-center">
        <h3 class="text-xl font-bold mb-1 text-blue-900">{d.title}</h3>
        <p class="text-gray-700 mb-2 text-sm">{d.excerpt}</p>
        <a href={`/kusten/${d.slug}`} class="inline-flex items-center text-blue-700 font-semibold group text-sm">
          Läs mer
          <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  ))}
</div>
  </section>

  <!-- Inspiration Section -->
  <section class="py-20 bg-blue-50">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-2 text-blue-900">Letar du efter fler idéer till din resa?</h2>
      <p class="text-lg text-gray-700">Utforska den fantastiska kusten och dess dolda skatter</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <a href="/kusten/vinprovning" class="group bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col items-center hover:shadow-xl transition">
        <img src="/images/vin2.webp" alt="Vinupplevelser" class="w-full h-56 object-cover group-hover:scale-[1.02] transition" loading="lazy" decoding="async" />
        <div class="p-6 w-full">
          <h3 class="text-xl font-bold mb-2 text-blue-900 flex items-center gap-2">Vinprovning <svg class="w-4 h-4 text-blue-700 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></h3>
          <p class="text-gray-700">Kustnära vingårdar, lokala druvor och utvalda pairing-upplevelser.</p>
        </div>
      </a>
      <a href="/kusten/matupplevelser" class="group bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col items-center hover:shadow-xl transition">
        <img src="/images/muslje.jpg" alt="Matupplevelser" class="w-full h-56 object-cover group-hover:scale-[1.02] transition" loading="lazy" decoding="async" />
        <div class="p-6 w-full">
          <h3 class="text-xl font-bold mb-2 text-blue-900 flex items-center gap-2">Matupplevelser <svg class="w-4 h-4 text-blue-700 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></h3>
          <p class="text-gray-700">Smaka kustens råvaror – fisk, olivolja, ost och moderna tolkningar.</p>
        </div>
      </a>
      <a href="/kusten/yahting" class="group bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col items-center hover:shadow-xl transition">
        <img src="/images/jedrenje.webp" alt="Yahting & Segling" class="w-full h-56 object-cover group-hover:scale-[1.02] transition" loading="lazy" decoding="async" />
        <div class="p-6 w-full">
          <h3 class="text-xl font-bold mb-2 text-blue-900 flex items-center gap-2">Yahting & Segling <svg class="w-4 h-4 text-blue-700 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></h3>
          <p class="text-gray-700">Upplev Montenegros kust från vattnet och njut av en dag på en lyxyacht.</p>
        </div>
      </a>
    </div>
  </section>
</Layout>