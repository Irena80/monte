---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/inlandet.astro

import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

import Steps from '~/components/widgets/Steps.astro';

import Content from '~/components/widgets/Content.astro';

import OfferCard from '~/components/OfferCard.astro';


const metadata = {
  title: 'Inlandet',
};


// Inlandet – erbjudanden (3 kort)
const offers = [
  {
    slug: 'durmitor-adventure',
    title: 'DURMITOR TEAMBULDING',
    discount: 'Äventyr',
    hotel: 'Nationalpark Durmitor',
    location: 'Žabljak, Montenegro',
    image: '/images/Durmitor.jpg',
    alt: 'Durmitor berg och sjö',
    href: '/durmitor'
  },
  {
    slug: 'kolasin-vinter',
    title: 'VINTER I KOLAŠIN',
    discount: 'Skidåkning',
    hotel: 'Kolašin Ski Resort',
    location: 'Kolašin, Montenegro',
    image: '/images/kolasin.jpg',
    alt: 'Kolašin vinterlandskap',
    href: '/kontakt'
  },
  {
    slug: 'tara-aventyr',
    title: 'TARA ÄVENTYR',
    discount: 'Rafting',
    hotel: 'Tara River Canyon',
    location: 'Tara, Montenegro',
    image: '/images/tara.webp',
    alt: 'Tara äventyr i kanjonen',
    href: '/tara'
  }
];


---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      { text: 'Boka', icon: 'tabler:run', href: '/boka' },
    ]}
    image={{
      src: '~/assets/images/priroda.webp',
      alt: 'Caos Image',
    }}
  >
      <Fragment slot="title">
  Året runt<span class="hidden sm:inline"> </span> <span class="text-blue-900 dark:text-white highlight">äventyr</span>
    </Fragment>
    <Fragment slot="subtitle">
      Låt oss guida dig till Montenegros bästa pärlor - en av Europas mest spännande och mångsidiga destination! Upplev landets bäst bevarade skidhemlighet, djupdyk i Europas sista orörda vildmark och njut av en aktiv semester. 
    </Fragment>
  </Hero>
  
  <!-- Inlandet Erbjudanden: matchar Gruppresor-upplägg -->
  <section id="erbjudanden" class="py-20 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Inlandets höjdpunkter</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight">Några av våra erbjudanden</h2>
          <p class="mt-5 max-w-2xl text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">Durmitor, Kolašin och Tara – ikoniska platser för aktiv natur, vinteräventyr och storslagna kanjoner.</p>
        </div>
        <div>
          <a href="/resor" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 dark:hover:bg-slate-200 transition shadow">Se alla resepaket <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {offers.map(o => (
          <OfferCard
            href={o.href}
            slug={o.slug}
            title={o.title}
            discount={o.discount}
            hotel={o.hotel}
            location={o.location}
            image={o.image}
            alt={o.alt}
          />
        ))}
      </div>
    </div>
  </section>
  <!-- Content Widget **************** -->
  <Content
    isReversed={true}
    items={[
      {
        title: 'Europas bäst bevarade skidhemlighet',
        description:
          'Djupt inbäddad bland Europas sista orörda vildmark finns en dold pärla som väntar på att upptäckas. En sann bergsparadis inbäddad bland majestätiska höjder och imponerande djup. <br> <br> Omgiven av den imponerande bergskedjan Bjelasica har Kolašin med rätta förtjänat sitt rykte som en av de mest spektakulära skid- och vintersportdestinationerna i denna del av världen. Till skillnad från andra berg, har Bjelašicas vulkaniska ursprung resulterat i vita vintrar, gröna somrar och strömmande bäckar i överflöd. Toppar når över 2 200 meter och tack vare den närliggande nationalparken Biogradska Gora gör karga landskap och slingrande pister Kolašin Montenegros svar på de schweiziska alperna.',
        icon: 'tabler:mountain',
      },
    ]}
    image={{
      src: '~/assets/images/planina1.jpg',
      alt: 'Features Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Kolašin Skidresort</h3>
      <a href="https://www.kolasinvalleys.com/" class="text-sm text-blue-500">Kolašin Valleys</a> <!-- Moved button here -->
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
  isAfterContent
    items={[
      {
        title: '5 nationalparker',
        description:
          'Ge dig in i Montenegros inland och upplev den fascinerande vilda sidan av detta lilla land, representerad av dess fem unika nationalparker, som tillsammans utgör 8 % av landets totala yta. Dessa parker är kanske landets mest populära sevärdheter! När man jämför dem med den vackra kustlinjen blir det tydligt att detta verkligen är en enastående destination. <br> Nationalparkerna Durmitor, Skadarsjön, Lovćen, Biogradska Gora och Prokletije kännetecknas av dramatiska bergslandskap, magnifika glaciärsjöar, en otrolig biologisk mångfald och mycket mer. <br> Oavsett var i Montenegro du befinner dig är du aldrig långt från någon av dessa naturskatter – och en rundtur genom dem är verkligen värd upplevelsen!',
        icon: 'tabler:mountain',
      },
    ]}
    image={{
      src: '~/assets/images/biograd.jpg',
      alt: 'Features Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Upplev UNESCOs naturarv </h3>
    </Fragment>
  </Content>


  <!-- Content Widget **************** -->
  <Content
  isReversed={true}
    items={[
      {
        title: 'De mest kända vandringslederna i Montenegro',
        description:
          'Montenegro är ett paradis för vandrare och äventyrare, med enastående naturliga landskap och spektakulära utsikter. Här är några av de mest kända vandringslederna i landet.<br> <br> Förutom Kotors stadsmurar och fästningen Sveti Ivan, varifrån den berömda utsikten över Boka Kotorska-bukten breder ut sig, samt Ivanova Korita och Njegoš-mausoleet på Lovćen, Savin Kuk på Durmitor och Svarta sjön, kan du vandra genom den nästan overkliga Lukavica-dalen till Kapetanovo-sjön. <br> <br> Ta dig sedan genom Mrtvica-kanjonen och Önskans port. Du kan också upptäcka det hjärtformade Trnovačko-sjön och uppleva Orjen-berget under en fullmånenatt. ' ,
        icon: 'tabler:mountain',
      },
    ]}
    image={{
      src: '~/assets/images/hiking4.jpg',
      alt: 'Features Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Majestätiska berg </h3>
    </Fragment>
  </Content>

 <!-- Content Widget **************** -->
 <Content
 isAfterContent
 items={[
   {
     title: 'Canyoning i Montenegro',
     description:
       'Canyoning är det mest spännande sättet att utforska Montenegros floder och berg! Förbered dig på att klättra över hala klippor, hoppa från svindlande höjder och dyka ner i kanjonens iskalla vatten!',
     icon: 'tabler:tree',
   },
 ]}
 image={{
   src: '~/assets/images/tara.webp',
   alt: 'Benefits Image',
 }}
>
 <Fragment slot="content">
   <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Canyoning</h3>
   
 </Fragment>


</Content>

  <!-- Add space between image and title -->
   <!-- Add FlexCards -->
  

   <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-5xl mb-2 text-center">Salig utbud av nationalparker</h2>
 
 
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-4 m-2">
    <!-- Hrid sjön -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/hrid.jpg" alt="Hrid sjön" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Hrid sjön</h3>
        <p class="text-white/90 text-sm mt-1">Hrid-sjön ligger i ett spektakulärt landskap med höga tallar, blekta stammar och spännande klippformationer. En stilla plats för avkoppling.</p>
      </div>
    </a>

    <!-- Bukumirsko-sjön -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/buka.jpg" alt="Bukumirsko-sjön" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Bukumirsko-sjön</h3>
        <p class="text-white/90 text-sm mt-1">Legendarisk bergssjö på 1443 m höjd. Bada, slå läger vid vassen och njut av det natursköna landskapet.</p>
      </div>
    </a>

    <!-- Piva-sjön (filnamn med mellanslag) -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/piva%20.jpg" alt="Piva-sjön" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Piva-sjön</h3>
        <p class="text-white/90 text-sm mt-1">Konstgjord sjö omgiven av skogar och kalkstensplatåer, med kanjoner formade av Tara, Piva, Komarnica och Sušica.</p>
      </div>
    </a>

    <!-- Lipa grottan -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/lipa.jpg" alt="Lipa grottan" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Lipa grottan</h3>
        <p class="text-white/90 text-sm mt-1">Ett av Montenegros största grottsystem nära Cetinje – salonger och gångar över 2,5 km under jord.</p>
      </div>
    </a>
  </div>
   <!-- Add space between image and title -->
  
  
  <br>
  <br>
  
  <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-5xl mb-2 text-center">Majestätiska berg</h2>
 
 
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-4 m-2">
    <!-- Durmitor -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/Durmitor.jpg" alt="Durmitor" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Durmitor</h3>
        <p class="text-white/90 text-sm mt-1">UNESCO-listad nationalpark i norr, omsluten av floden Tara och dess världsberömda kanjon.</p>
      </div>
    </a>

    <!-- Tara äventyr -->
    <a href="/tara" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/tara.webp" alt="Tara äventyr" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Tara äventyr</h3>
        <p class="text-white/90 text-sm mt-1">Rafting, zipline och storslagna vyer i Europas djupaste kanjon.</p>
      </div>
    </a>

    <!-- Lovćen -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/lovcen.webp" alt="Lovćen" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Lovćen</h3>
        <p class="text-white/90 text-sm mt-1">Ikoniska vyer över Boka-bukten och Njegoš-mausoleet – Montenegros symboliska hjärta.</p>
      </div>
    </a>

    <!-- Biogradska Gora -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/biograd.jpg" alt="Biogradska Gora" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Biogradska Gora</h3>
        <p class="text-white/90 text-sm mt-1">Urtida skogar, stilla sjöar och gröna somrar i nationalparken nära Kolašin.</p>
      </div>
    </a>

    <!-- Prokletije -->
    <a href="/resor" class="group relative block rounded-2xl overflow-hidden shadow ring-1 ring-slate-200/70 focus:outline-none focus:ring-2 focus:ring-blue-600">
      <img src="/images/prokletije3.jpg" alt="Prokletije" loading="lazy" decoding="async" class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/10 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 transition-all duration-300">
        <h3 class="text-white text-lg font-bold">Prokletije</h3>
        <p class="text-white/90 text-sm mt-1">Höga toppar, djupa dalar och glaciärsjöar – hem för Montenegros högsta topp Zla Kolata.</p>
      </div>
    </a>
  </div>
 <!-- Steps Widget ****************** -->

 <Steps
 id="resume"
 title="Intressant fakta"
 items={[
   {
     title: ` Europas djupaste kanjon <br /> <span class="font-normal">1,333m - Floden Taras kanjon</span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   {
     title: `Europas största vingård <br /> <span class="font-normal">Den imponerande vingården på 23 km2 med 11,5 miljoner vinrankor är den största vingårdsplantagen i hela Europa </span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   {
     title: `Europas äldsta olivträd <br /> <span class="font-normal">Finns i staden Bar  </span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   
   {
     title: `Längsta sandstrand vid Adriatiska kusten <br /> <span class="font-normal">13km - Long Beach Ulcinj  </span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   {
     title: `Störta sjön på Balkan <br /> <span class="font-normal">530km2 - Sjön Skadar   </span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   {
     title: `Högsta bergstopp <br /> <span class="font-normal">2,534m - Zla Kolata, Prokletije   </span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   {
     title: `Kusten <br /> <span class="font-normal">294km med 117 stränder   </span> <br /> <span class="text-sm font-normal"></span>`,
     icon: 'tabler:settings',
   },
   
 ]}
 classes={{ container: 'max-w-3xl' }}
/>
 



  
</Layout>

<style>
.same-size {
  width: 100%;
  height: auto;
}
</style>