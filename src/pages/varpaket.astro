---
import Layout from '../layouts/PageLayout.astro';

const metadata = {
  title: 'Vårpaket till Montenegro – Företagsresor & gruppresor',
  description:
    'Planera vårens konferens- eller gruppresa till Montenegro. Blomstrande natur, ljusa dagar och aktivitetspaket med vandring, cykling och kuststäder.',
  image: '/images/spring montenegro.jpg'
};
---

<Layout metadata={metadata}>
  <section class="px-4 pt-6 md:pt-10">
    <div class="max-w-6xl mx-auto">
      <div class="overflow-hidden rounded-2xl">
        <img src="/images/spring montenegro.jpg" alt="Vår i Montenegro – kust och natur" class="w-full h-auto object-cover" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="px-4 py-8 md:py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight mb-5">
        Vårpaket till Montenegro – Konferensresa vid Adriatiska havet
      </h1>
      <p class="text-slate-700 md:text-lg mb-8">
        Våren i Montenegro bjuder på ljusare dagar och lagom temperatur – en energigivande period som lämpar sig för både konferens och aktiviteter.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 md:gap-4 mb-10">
        <img src="/images/hn3.jpg" alt="Hamn och kust" class="rounded-xl aspect-[4/3] object-cover" loading="lazy" />
        <img src="/images/biciklo.jpg" alt="Cykling längs kusten" class="rounded-xl aspect-[4/3] object-cover" loading="lazy" />
        <img src="/images/kajak.webp" alt="Kajak och vattensport" class="rounded-xl aspect-[4/3] object-cover hidden sm:block" loading="lazy" />
      </div>

      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mb-4">Därför välja vårpaket</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-700 mb-10">
        <li>Lagom temperatur och längre dagar</li>
        <li>Aktiviteter: vandring, cykling, kustupplevelser</li>
        <li>Konferenshotell vid havet</li>
        <li>Nära till flygplatserna Tivat och Podgorica</li>
      </ul>

      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mb-4">Program (3 dagar)</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-700 mb-8">
        <li>Dag 1: Ankomst, transfer, välkomstmiddag vid vattnet</li>
        <li>Dag 2: Konferens, eftermiddagstur i Kotor</li>
        <li>Dag 3: Vandring & vattensport, avskedsmiddag</li>
      </ul>

      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mb-4">Vanliga frågor</h2>
      <div class="space-y-6 mb-8">
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">Vad kostar paketet?</h3>
          <p class="text-slate-700">Kontakta oss för offert och upplägg anpassat efter gruppstorlek och datum.</p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">När är bästa tiden?</h3>
          <p class="text-slate-700">Mars–maj bjuder på stabilt väder och bra aktivitetsförutsättningar.</p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">Kan vi anpassa programmet?</h3>
          <p class="text-slate-700">Ja, vi skräddarsyr helt efter era behov.</p>
        </div>
      </div>

      <div class="mt-2">
  <a href="/contact" class="inline-flex items-center rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-white">
          Begär offert på vårpaket
        </a>
      </div>
    </div>
  </section>
</Layout>
