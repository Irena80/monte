---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/hercegnovi.astro

import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
 
 
 
 const metadata = {
   title: 'Yachting i Montenegro',
 };
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  
 
   
    
    image={{
      src: '~/assets/images/jedrenje.webp',
      alt: 'Caos Image',
    }}
  >
  <Fragment slot="title">
     <span class="hidden sm:inline">Segling i</span>  <span

      class="text-accent dark:text-white highlight">Adriatiska havet</span
    > 
  </Fragment>
    <Fragment slot="subtitle">
       Upptäck en av världens vackraste vikar, segla i skärgården, besök grannlandet Kroatien eller varför inte segla över till Italien.
    </Fragment>

    <Fragment slot="actions">
      <a
        href="/yahting/events"
        class="inline-flex items-center justify-center rounded-full bg-blue-900 text-white px-6 py-3 text-sm font-semibold shadow hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-800/40"
      >
        8 skäl att segla i Montenegro
      </a>
    </Fragment>

    
  </Hero>




  <div class="max-w-6xl mx-auto px-4 mt-8 text-center">
    <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Populära upplägg</p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight dark:text-white sm:text-5xl mb-2">Utvalda seglingsresor och paket</h2>
  </div>
  
  <div class="relative mx-auto max-w-7xl px-4 md:px-3 py-12 md:py-16 lg:py-10 text-default">
    <!-- ComponentLeft -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="order-2 md:order-1">
        <h2 class="text-2xl font-bold text-blue-600 mb-4">Sunset Sailing Boka Bay</h2>
        <p class="text-gray-700">
          Upplev Boka-buktens magi i solnedgången med ett glas vin i handen. Perfekt som avslutning på en konferensdag eller för par i gruppen.
        </p>
        <div class="mt-4">
          <p class="flex items-center text-gray-700">
            <span class="iconify mr-2" data-icon="tabler:map-pin"></span> Tid: 3 timmar | Avgång från Herceg Novi
          </p>
          <p class="flex items-center text-gray-700">
            <span class="iconify mr-2" data-icon="tabler:check"></span> Ingår: Kapten, snacks, vin/öl, musik, flytvästar
          </p>
        </div>
      </div>
      
      <div class="order-1 md:order-2">
        <img src="/images/jedrenje.jpg" alt="Segling i Kotorbukten" class="rounded-lg shadow-lg w-full h-80 object-cover" />
      </div>
    </div>
   
  
    <!-- ComponentRight -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mt-12">
      <div class="order-1">
        <img src="/images/jedrenje3.webp" alt="Utforska den pittoreska bukten" class="rounded-lg shadow-lg w-full h-80 object-cover" />
      </div>
      <div class="order-2">
        <h2 class="text-2xl font-bold text-blue-600 mb-4">Heldag till Blue Cave & Lustica</h2>
        <p class="text-gray-700">
          Ett heldagsäventyr till Montenegros mest ikoniska kustpärlor. Bad i Blue Cave, lunch på Lustica, besök i små byar längs vägen.
        </p>
        <div class="mt-4">
          <p class="flex items-center text-gray-700">
            <span class="iconify mr-2" data-icon="tabler:map-pin"></span>6 timmar | Avgång från Zanjice eller Herceg Novi
          </p>
          <p class="flex items-center text-gray-700">
    <span class="iconify mr-2" data-icon="tabler:check"></span> Ingår: Kapten & guide, badstopp, lunch i lokal fiskrestaurang, vatten/snacks   </p>
          </div>
      </div>
    </div>
  </div>
  <div class="relative mx-auto max-w-7xl px-4 md:px-3 py-12 md:py-16 lg:py-10 text-default">
    <!-- ComponentLeft -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="order-2 md:order-1">
        <h2 class="text-2xl font-bold text-blue-600 mb-4">Luxury Sailing – Privat katamaran</h2>
        <p class="text-gray-700">
          Njut av en exklusiv seglingsupplevelse på en modern katamaran med egen besättning. Perfekt för ledningsgrupper eller mindre team.
        </p>
        <div class="mt-4">
          <p class="flex items-center text-gray-700">
            <span class="iconify mr-2" data-icon="tabler:map-pin"></span>Heldag | För grupper upp till 12 personer 
          </p>
          <p class="flex items-center text-gray-700">
    <span class="iconify mr-2" data-icon="tabler:check"></span> Privat båt, kapten + värd, lunch & dryck, badstopp, snorkelutrustning  </p>
          </div>
      </div>
      <div class="order-1 md:order-2">
        <img src="/images/jedrenje4.webp" alt="Privat katamaran i Adriatiska havet" class="rounded-lg shadow-lg w-full h-80 object-cover" />
      </div>
    </div>
   <!-- ComponentRight -->
   <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mt-12">
    <div class="order-1">
      <img src="/images/jedrenje3.webp" alt="Utforska den pittoreska bukten" class="rounded-lg shadow-lg w-full h-80 object-cover" />
    </div>
    <div class="order-2">
      <h2 class="text-2xl font-bold text-blue-600 mb-4">Teambuilding på havet</h2>
      <p class="text-gray-700">
        Lär er grunderna i segling som team! Aktiv teambuilding med gemensamma utmaningar, navigation och samarbete – ledd av certifierad instruktör.
      </p>
      <div class="mt-4">
        <p class="flex items-center text-gray-700">
          <span class="iconify mr-2" data-icon="tabler:map-pin"></span> Halvdag | Interaktiv segling-  Perfekt som del i kickoff
        </p>
        <p class="flex items-center text-gray-700">
  <span class="iconify mr-2" data-icon="tabler:check"></span> Ingår: Instruktör, segelbåt, säkerhetsutrustning, diplom  </p>
        </div>
    </div>
  </div>
   
    
  </div>

  <!-- Process: Så här går en seglingsresa till -->
  <section id="process" class="py-24 bg-white dark:bg-slate-900 border-t border-slate-200/70 dark:border-slate-700/40">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-12 gap-12">
      <!-- Left Intro -->
      <div class="lg:col-span-6">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight tracking-tight">
          Så här går en seglingsresa till
        </h2>
        <p class="mt-6 text-lg text-slate-600 dark:text-slate-300 max-w-xl leading-relaxed">
          Smidigt, tryggt och socialt. Perfekt för både nybörjare och vana seglare.
        </p>
        <div class="mt-10">
          <a href="/contact" class="inline-flex items-center justify-center rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-8 py-4 shadow focus:outline-none focus:ring-2 focus:ring-blue-600 transition">Kontakta oss</a>
        </div>
      </div>
      <!-- Steps Right -->
      <div class="lg:col-span-6 grid sm:grid-cols-2 gap-y-12 gap-x-10">
        <div class="relative pl-0">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">1</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Samling i marina</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">Genomgång, säkerhet och rutt.</p>
            </div>
          </div>
        </div>
        <div class="relative pl-0">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">2</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Avgång</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">Låt vinden visa vägen till nya upplevelser längs Adriatiska kusten.
</p>
            </div>
          </div>
        </div>
        <div class="relative pl-0">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">3</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Badstopp & snorkel</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">Tid för bad och upplevelser.</p>
            </div>
          </div>
        </div>
        <div class="relative pl-0">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">4</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Lunch</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">Ombord eller strandrestaurang.</p>
            </div>
          </div>
        </div>
        <div class="relative pl-0">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">5</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Eftermiddagstur</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">Sol, vyer och musik i lugnt tempo.</p>
            </div>
          </div>
        </div>
        <div class="relative pl-0">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">6</div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Tillbaka till marina</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">Avslut och möjlighet till gemensam middag.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
 
 
 
 

 
   
   
 </Layout>
