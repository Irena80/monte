---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
const metadata = {
  title: 'Kontakta oss',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Kontakta oss" title="Hör av dig till oss!" />
<section class="py-16 px-4 max-w-2xl mx-auto">
    
    <p class="text-center text-lg mb-10">
      Har du en idé, ett team eller ett syfte med resan? <br />Låt oss hjälpa dig skapa något minnesvärt.
    </p>

    <form 
      action="https://formspree.io/f/xovlzkgz" 
      method="POST"
      class="space-y-6 bg-white p-6 rounded-xl shadow-lg"
    >
    <!-- 🟢 Redirect till tack-sida -->
  <input type="hidden" name="_redirect" value="https://www.mediteranobay.com/tack" />
      <div>
        <label for="namn" class="block font-medium text-gray-700">Namn *</label>
        <input type="text" id="namn" name="namn" required class="w-full mt-1 px-4 py-2 border rounded-md" />
      </div>

      <div>
        <label for="företag" class="block font-medium text-gray-700">Företag / Grupp</label>
        <input type="text" id="företag" name="företag" class="w-full mt-1 px-4 py-2 border rounded-md" />
      </div>

      <div>
        <label for="email" class="block font-medium text-gray-700">E-post *</label>
        <input type="email" id="email" name="email" required class="w-full mt-1 px-4 py-2 border rounded-md" />
      </div>

      <div>
        <label for="meddelande" class="block font-medium text-gray-700">Vad vill ni få hjälp med?</label>
        <textarea id="meddelande" name="meddelande" rows="5" class="w-full mt-1 px-4 py-2 border rounded-md"></textarea>
      </div>

      <button type="submit" class="w-full bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition">
        Skicka förfrågan
      </button>
    </form>

    <div class="mt-10 text-center text-sm text-gray-500">
      Eller mejla oss direkt: <a href="mailto:info@mediteranobay.com" class="text-blue-600 underline">info@mediteranobay.com</a>
    </div>
  </section>
<!-- Features Widget *************** -->

<Features
id="features"
tagline="Varför boka med oss"
title="Stora grupper, teambuildning eller kanske kompisgäng som vill få nya upplevelser"
subtitle="Vi tror på magin i att förvandla idéer till fantastiska upplevelser. Grundat av passionerade reseentusiaster erbjuder vi inspirerande och utmanande grupp- och eventresor till privatpersoner och företag. Upplev Montenegros finaste resmål genom unika boenden, aktiviteter och måltidsupplever."
items={[
  {
    title: 'Helhetsupplevelsen',
    description:
      'Vår ambiton är att sammanföra Skandinavien med Montenegro. Genom att paketera resor som en helhetsupplevelse från start till mål erbjuder vi ett genomtänkt innehåll, engagemang och en stor dos kreativitet. Välj mellan redan färdiga helhetslösningar eller skräddarsydda paket.',
    icon: 'tabler:brand-tailwind',
  },
  {
    title: 'Trygghet',
    description:
      'Att resa med MediteranoBay är tryggt. Genom att ställa statliga garantier till Kammarkollegiet får ni en trygg och verifierad paketresa.  Utifrån vår omfattande lokalkännedom samarbetar vi endast med seriösa leverantörer och partners. Våra duktiga reseledare på plats hjälper er så att er resa blir precis som ni tänkt Er.',
    icon: 'tabler:components',
  },
  
  {
    title: 'Lokal kännedom',
    description:
      '  Utifrån vår omfattande lokalkännedom samarbetar vi endast med seriösa leverantörer och partners och kan därmed erbjuda bästa möjliga pris när du bokar din resa med oss. Våra duktiga reseledare på plats hjälper er under hela resan så att er resa blir precis som ni tänkt Er.',
    icon: 'tabler:arrows-right-left',
  },
 
  {
    title: 'Klimatsmart resa',
    description:
      'Vikten av att kunna leverera hållbara resepaket med fokus på miljö och klimatavtryck värdesätter vi högt. Därför erbjuder vi klimatkompensation på samtliga av våra resor.',
    icon: 'tabler:rocket',
  },
  {
    
  },
  {
    
  },
]}
/>
  <!-- Features2 Widget ************** -->

  <Features2
    title="Låt oss hjälpa till!"
    items={[
      {
        title: 'Support',
        description: `Chatta med oss för förfrågningar kring resor, planeringen inför resan, bokningen eller om ni har frågor som rör betalning, ändringar mm.`,
      },
     
      {
        title: 'Kontakt',
        description: '<a href="tel:+46765885325" class="underline">+46 76 588 53 25</a>',
        icon: 'tabler:headset',
      },
      {
        title: 'E-post',
        description: '<a href="mailto:info@mediteranobay.com" class="text-blue-500">info@mediteranobay.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Mediteranobay travel',
        description: 'Stockholm, Sverige',
        icon: 'tabler:map-pin',
      },

    ]}
  />
  
</Layout>
