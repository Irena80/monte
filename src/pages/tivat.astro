---
import Layout from '../layouts/PageLayout.astro';

const metadata = {
  title: 'Konferensresa till Tivat – Företagsresor Montenegro',
  description:
    'Paket – Konferensresa till Tivat. Företagsresor till Montenegro med 4* hotell, havsnära konferensrum, gångavstånd till Porto Montenegro, teambuilding och utflykter i Kotorbukten.',
  image: '/images/Tivat.webp'
};
---

<Layout metadata={metadata}>
  <!-- Hero: stor bild + rubrik -->
  <section class="px-4 pt-6 md:pt-10">
    <div class="max-w-6xl mx-auto">
      <div class="overflow-hidden rounded-2xl">
        <img src="/images/Tivat.webp" alt="Tivat – Porto Montenegro och havsnära konferens" class="w-full h-auto object-cover" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="px-4 py-8 md:py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight mb-5">
        Konferensresa till Tivat – Företagsresor vid Adriatiska havet
      </h1>
      <p class="text-slate-700 md:text-lg mb-8">
        I Tivat får ni en modern bas för konferensen – nära flygplatsen, havet och exklusiva Porto Montenegro. Perfekt för effektiva möten och inspirerande aktiviteter i Kotorbukten.
      </p>

      <!-- Liten, stilren bildgrid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 md:gap-4 mb-10">
        <img src="/images/portomontenegro.jpg" alt="Porto Montenegro" class="rounded-xl aspect-[4/3] object-cover" loading="lazy" />
        <img src="/images/paragliding.webp" alt="Teambuilding och aktiviteter" class="rounded-xl aspect-[4/3] object-cover" loading="lazy" />
        <img src="/images/kotorbukten.jpg" alt="Kotorbukten nära Tivat" class="rounded-xl aspect-[4/3] object-cover hidden sm:block" loading="lazy" />
      </div>

      <!-- USP -->
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mb-4">Varför Tivat</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-700 mb-10">
        <li>4-stjärnigt hotell med mötesrum och havsnära läge</li>
        <li>10 minuter från Tivat flygplats</li>
        <li>Teambuilding: segling, RIB-båt, vinprovning</li>
        <li>Gångavstånd till Porto Montenegro och nära Kotor</li>
      </ul>

      <!-- Program -->
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mb-4">Program (3 dagar)</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-700 mb-8">
        <li>Dag 1: Ankomst, transfer, välkomstmiddag i Porto Montenegro</li>
        <li>Dag 2: Konferens, eftermiddagstur till Kotor</li>
        <li>Dag 3: Segling & teambuilding, avskedsmiddag vid havet</li>
      </ul>

      <!-- FAQ -->
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mb-4">Vanliga frågor</h2>
      <div class="space-y-6 mb-8">
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">Vad kostar resan?</h3>
          <p class="text-slate-700">Från ca 8 900 SEK per person (3 dagar, helpension).</p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">Hur tar man sig dit?</h3>
          <p class="text-slate-700">Närmaste flygplats är Tivat (10 min), alternativt Podgorica (90 min).</p>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-1">Kan vi anpassa programmet?</h3>
          <p class="text-slate-700">Ja, alla resor skräddarsys.</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-2">
        <a href="/kontakt" class="inline-flex items-center rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-white">
          Begär offert på konferensresa till Tivat
        </a>
      </div>
    </div>
  </section>
</Layout>
