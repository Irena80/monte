---
import Layout from '~/layouts/PageLayout.astro';
export interface Props { q?: string }
const q = Astro.url.searchParams.get('q') || '';
---

<Layout metadata={{ title: q ? `Sök: ${q}` : 'Sök' }}>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-extrabold mb-6">Sök</h1>
    <form method="GET" action="/search" class="mb-8">
      <input type="search" name="q" value={q} placeholder="Sök på sidan..." class="w-full border rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-amber-400" />
    </form>
    {q && (
      <p class="text-sm text-gray-500 mb-6">Visar 0 resultat för <strong>{q}</strong>. (Indexering ej implementerad ännu.)</p>
    )}
    {!q && <p class="text-gray-600">Skriv något i sökrutan för att börja.</p>}
  </section>
</Layout>
