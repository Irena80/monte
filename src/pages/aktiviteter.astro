---
// Aktiviteter – moderniserad med MBLayout (innehåll oförändrat)
import MBLayout from '../layouts/MBLayout.astro';
---

<MBLayout
  title="Aktiviteter i Montenegro — MediteranoBay"
  description="Året runt-upplevelser mellan hav och berg – vandring, segling, canyoning, kultur och mycket mer."
  ogImage="/images/hiking.webp"
  ogUrl="https://mediteranobay.com/aktiviteter"
  activeNav=""
>

<Fragment slot="head">
<style is:global>
  /* ===== ACTIVITY CARDS ===== */
  .act-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
  .act-card { position: relative; border-radius: 6px; overflow: hidden; display: block; text-decoration: none; }
  .act-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .act-card:hover img { transform: scale(1.04); }
  .act-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,30,46,0.85) 0%, rgba(7,30,46,0.1) 55%); transition: opacity 0.3s; }
  .act-body { position: absolute; bottom: 0; left: 0; right: 0; padding: 18px 20px; }
  .act-title { font-size: 14px; font-weight: 800; color: #fff; margin-bottom: 5px; line-height: 1.2; letter-spacing: -0.01em; }
  .act-desc { font-size: 12px; color: rgba(255,255,255,0.78); line-height: 1.55; }
  .act-loc { font-size: 11px; color: rgba(255,255,255,0.65); margin-top: 2px; }

  /* AUDIO TOGGLE */
  .audio-toggle { position: absolute; bottom: 28px; right: 28px; z-index: 4; display: inline-flex; align-items: center; gap: 8px; border-radius: 100px; background: rgba(255,255,255,0.85); color: #0d2235; padding: 8px 16px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; border: none; cursor: pointer; transition: background 0.2s; font-family: inherit; }
  .audio-toggle:hover { background: #fff; }

  /* RESPONSIVE */
  @media (max-width: 1023px) {
    .act-grid { grid-template-columns: repeat(2,1fr); }
  }
  @media (max-width: 767px) {
    .act-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
  }
</style>
</Fragment>

<!-- ===== HERO (video) ===== -->
<section class="hero" aria-labelledby="hero-h1">
  <video id="heroVideo" class="hero-img" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
    <source src="/videos/video5.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <button id="audioToggle" class="audio-toggle" type="button">
    <svg id="muteIcon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
    <svg id="soundIcon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 010 14.14"/><path d="M15.54 8.46a5 5 0 010 7.07"/></svg>
    Lyssna på video
  </button>
  <div class="hero-scroll" aria-hidden="true"><div class="hero-scroll-line"></div></div>
  <div class="hero-content">
    <div class="hero-kicker fade-up">Aktiviteter</div>
    <h1 id="hero-h1" class="hero-title fade-up delay-1">
      Aktiviteter<br />i Montenegro.
    </h1>
    <p class="hero-sub fade-up delay-2">
      Året runt-upplevelser mellan hav och berg – vandring, segling, canyoning, kultur och mycket mer.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;" class="fade-up delay-3">
      <a href="#aktiviteter" class="btn-gold">
        SE AKTIVITETER
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <a href="#kontakt" style="display:inline-flex;align-items:center;gap:8px;border:1.5px solid rgba(255,255,255,0.5);color:#fff;font-weight:700;font-size:12px;letter-spacing:0.08em;padding:13px 24px;border-radius:4px;text-decoration:none;text-transform:uppercase;">
        Kontakta oss
      </a>
    </div>
  </div>
</section>

<!-- ===== UTVALDA AKTIVITETER ===== -->
<section class="pg-section pg-section-white" id="aktiviteter">
  <div class="pg-inner">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:48px;" class="fade-up">
      <div>
        <div class="pg-kicker">Utvalda aktiviteter</div>
        <h2 class="pg-h2" style="margin-bottom:0;">Några av våra toppaktiviteter.</h2>
      </div>
      <a href="/resor" class="btn-gold" style="flex-shrink:0;">
        Upptäck mer
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="pg-svc-grid pg-svc-grid-3 fade-up delay-1">

      <a href="/kusten/vinprovning" class="act-card">
        <img src="/images/savina.jpg" alt="Vingårdsprovning Savina" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Savina Vingård</div>
          <div class="act-loc">Herceg-Novi</div>
        </div>
      </a>

      <a href="/kusten" class="act-card">
        <img src="/images/zicara.jpeg" alt="Kotor linbana" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Bokabuktens pärlor</div>
          <div class="act-loc">Montenegro</div>
        </div>
      </a>

      <a href="/kontakt" class="act-card">
        <img src="/images/dyka.jpg" alt="Poseidons stad – dykning" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Poseidons stad</div>
          <div class="act-loc">Luštica</div>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ===== ALLA AKTIVITETER ===== -->
<section class="pg-section pg-section-cream">
  <div class="pg-inner">
    <div class="fade-up" style="text-align:center;margin-bottom:48px;">
      <div class="pg-kicker">Destination för alla årstider</div>
      <h2 class="pg-h2 pg-h2-center">Aktiviteter för alla smaker.</h2>
    </div>
    <div class="act-grid fade-up delay-1">

      <div class="act-card">
        <img src="/images/jedrenje.webp" alt="Båtutflykter" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Båtutflykter &amp; kustäventyr</div>
          <div class="act-desc">Upptäck Montenegros kust med båtutflykter till avlägsna stränder, grottor och öar.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/divljapriroda.jpg" alt="Vild natur" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Vild natur &amp; äventyr</div>
          <div class="act-desc">Vandra genom orörd natur, upptäck gömda dalar och känn friheten i Montenegros vildmark.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/perast2.webp" alt="Kultur & historia" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Kultur &amp; historia</div>
          <div class="act-desc">Utforska Montenegros rika kulturarv och historiska platser.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/kajak.jpg" alt="Vattensporter" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Vattensporter &amp; strandliv</div>
          <div class="act-desc">Snorkling, dykning, kajakpaddling och vindsurfing längs Montenegros vackra kustlinje.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/brodovi.jpg" alt="Fiske" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Fiske &amp; naturupplevelser</div>
          <div class="act-desc">Fiskeutflykter i Montenegros sjöar och floder. Rikt djurliv och stillhet i naturen.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/zicara.jpeg" alt="Linbana & utsikt" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Zicara – Linbana &amp; utsikt</div>
          <div class="act-desc">Ta linbanan upp i bergen och njut av storslagen utsikt över landskapet.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/jedrenje4.webp" alt="Segling" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Segling &amp; havsäventyr</div>
          <div class="act-desc">Upplev Adriatiska havet med segling, kajak eller SUP – äventyr och avkoppling i ett.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/hiking.webp" alt="Vandring & Trekking" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Vandring &amp; Trekking</div>
          <div class="act-desc">Vandra genom Montenegros spektakulära landskap med panoramavyer och orörd natur.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/vin2.webp" alt="Vinprovning" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Vinprovning &amp; smakupplevelser</div>
          <div class="act-desc">Besök vingårdar, smaka på lokala viner och njut av Montenegros kulinariska traditioner.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/unesco1.webp" alt="UNESCO världsarv" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Kultur &amp; historia</div>
          <div class="act-desc">Utforska världsarv, gamla städer och Montenegros rika historia.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/muslje.jpg" alt="Lokala smaker" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Lokala smaker</div>
          <div class="act-desc">Smaka på nybakat bröd och andra lokala delikatesser från små byar och marknader.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/mimoza.webp" alt="Festival & tradition" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Festival &amp; tradition</div>
          <div class="act-desc">Upplev färgstarka festivaler och traditioner som sätter guldkant på resan.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/cykla.jpg" alt="Cykla i Montenegro" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Cykla i Montenegro</div>
          <div class="act-desc">Upptäck Montenegro på två hjul – längs kusten, i bergen eller genom vackra landskap.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/dyka.jpg" alt="Dykning" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Dykning</div>
          <div class="act-desc">Dyk ner i Montenegros undervattensvärld – vrak, grottor och färgstarka rev.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/ridning.jpg" alt="Ridning" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Ridning</div>
          <div class="act-desc">Upplev Montenegros landskap från hästryggen längs byar, dalar och gröna ängar.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/rafting2.webp" alt="Rafting" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Rafting</div>
          <div class="act-desc">Spännande rafting i Tara-kanjonen, Europas djupaste kanjon, genom Durmitor nationalpark.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/kolasinski.jpg" alt="Skidåkning" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Skidåkning</div>
          <div class="act-desc">Snösäkra backar och vackra vyer i Kolašin. Perfekt för hela familjen.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/kanjon1.webp" alt="Canyoning" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Canyoning</div>
          <div class="act-desc">Hoppa, simma och klättra genom forsande vatten och vilda raviner i Montenegros kanjoner.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/paragliding.webp" alt="Paragliding" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Paragliding</div>
          <div class="act-desc">Flyg fritt över Montenegros berg och sjöar. Oförglömliga vyer för nybörjare och erfarna.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/flygfiske.webp" alt="Flygfiske" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Flygfiske</div>
          <div class="act-desc">Flugfiske i Montenegros orörda floder och sjöar i kristallklara vatten omgivna av natur.</div>
        </div>
      </div>

      <div class="act-card">
        <img src="/images/dipovi.jpg" alt="Quad-turer" loading="lazy" />
        <div class="act-overlay"></div>
        <div class="act-body">
          <div class="act-title">Quad-turer</div>
          <div class="act-desc">Utforska Luštica-halvön på fyrhjuling – offroad genom byar, kullar och längs kusten.</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ===== INTRESSEANMÄLAN / CTA ===== -->
<section class="cta-banner" id="kontakt">
  <img class="cta-banner-bg" src="/images/kotorbukten.jpg" alt="" aria-hidden="true" loading="lazy" />
  <div class="cta-banner-inner" style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">
    <div>
      <h2 class="cta-banner-title fade-up">Intresseanmälan</h2>
      <p class="cta-banner-desc fade-up delay-1">Berätta om era önskemål — vi hör av oss inom 24 timmar och skapar ett förslag anpassat för er grupp.</p>
    </div>
    <div class="fade-up delay-2">
      <form action="/tack" method="POST" style="display:flex;flex-direction:column;gap:10px;">
        <input type="text" name="namn" placeholder="Namn" required style="width:100%;background:rgba(255,255,255,0.95);border:1px solid transparent;border-radius:4px;padding:12px 14px;font-size:13px;font-family:inherit;outline:none;color:#1a1a2e;" />
        <input type="email" name="email" placeholder="E-post" required style="width:100%;background:rgba(255,255,255,0.95);border:1px solid transparent;border-radius:4px;padding:12px 14px;font-size:13px;font-family:inherit;outline:none;color:#1a1a2e;" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <input type="text" name="antal" placeholder="Antal resenärer" style="width:100%;background:rgba(255,255,255,0.95);border:1px solid transparent;border-radius:4px;padding:12px 14px;font-size:13px;font-family:inherit;outline:none;color:#1a1a2e;" />
          <input type="text" name="datum" placeholder="Önskat resedatum" style="width:100%;background:rgba(255,255,255,0.95);border:1px solid transparent;border-radius:4px;padding:12px 14px;font-size:13px;font-family:inherit;outline:none;color:#1a1a2e;" />
        </div>
        <textarea name="onskemål" placeholder="Berätta om era önskemål" rows="3" style="width:100%;background:rgba(255,255,255,0.95);border:1px solid transparent;border-radius:4px;padding:12px 14px;font-size:13px;font-family:inherit;outline:none;color:#1a1a2e;resize:vertical;"></textarea>
        <button type="submit" class="btn-gold-full">
          SKICKA INTRESSEANMÄLAN
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </button>
      </form>
      <p style="font-size:11px;color:rgba(255,255,255,0.35);margin-top:10px;text-align:center;">Vi hanterar dina personuppgifter enligt GDPR.</p>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const btn = document.getElementById('audioToggle') as HTMLButtonElement | null;
  const muteIcon = document.getElementById('muteIcon') as HTMLElement | null;
  const soundIcon = document.getElementById('soundIcon') as HTMLElement | null;
  const lastTextNode = btn?.lastChild;

  if (video && btn && muteIcon && soundIcon && lastTextNode && lastTextNode.nodeType === Node.TEXT_NODE) {
    function syncLabel() {
      if (video.muted) {
        muteIcon.style.display = '';
        soundIcon.style.display = 'none';
        lastTextNode.textContent = ' Lyssna på video';
      } else {
        muteIcon.style.display = 'none';
        soundIcon.style.display = '';
        lastTextNode.textContent = ' Stäng av ljud';
      }
    }

    syncLabel();
    btn.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.play().catch(() => {});
      syncLabel();
    });
  }
</script>

</MBLayout>
