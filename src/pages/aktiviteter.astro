---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/aktiviteter.astro
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Utforska',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Kusten',
        href: '/kusten',
        target: '_blank',
        icon: 'tabler:sun',
      },
      { text: 'Inlandet', icon:'tabler:mountain', href: 'resor/gruppresor/inlandet' },
    ]}
  >
    <Fragment slot="title">
      Upptäck<span class="hidden sm:inline"> och utforska</span> den vilda <span class="text-blue-800 md:text-blue-900 dark:text-white highlight">Montenegro</span>
    </Fragment>
    <Fragment slot="subtitle">
      Upplev nöjen året runt med äventyr för den medvetna, aktiva och ständigt nyfikna.
    </Fragment>
    <Fragment slot="image">
      <!-- Video for all screens using video1.mp4 -->
      <video autoplay muted playsinline loop class="block md:hidden w-full h-auto">
        <source src="/images/video1.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      <video autoplay muted playsinline loop class="hidden md:block w-full h-auto">
        <source src="/images/video1.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </Fragment>
  </Hero>
  
  <!-- Utvalt utbud -->
  <section id="utvalt-utbud" class="py-14 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8 md:mb-12">
        <div>
          <h2 class="text-3xl md:text-5xl font-serif font-medium text-slate-900 leading-tight">Utvalda aktiviteter</h2>
          <p class="mt-3 text-slate-600 text-base md:text-lg">Några av våra toppaktiviteter.</p>
        </div>
        <div>
          <a href="/resor" class="inline-flex items-center gap-2 rounded-full bg-rose-500 hover:bg-rose-600 text-white px-5 py-2.5 text-sm font-semibold shadow transition">Upptäck mer <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>
      <div class="grid gap-8 md:gap-10 md:grid-cols-3">
        <!-- Card 1: Vingård -->
        <a href="/kusten/vinprovning" class="group relative block rounded-xl overflow-hidden shadow ring-1 ring-slate-200/70">
          <img src="/images/savina.jpg" alt="Vingårdsprovning Savina" class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/20 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white">Vinarija Savina</h3>
            <p class="text-sm text-slate-100/95">Herceg-Novi</p>
          </div>
          <div class="absolute bottom-4 right-4 rounded-full bg-white/90 backdrop-blur px-3 py-1.5 text-[13px] font-semibold text-slate-900">30€</div>
        </a>
        <!-- Card 2: Kotor linbana -->
        <a href="/kusten" class="group relative block rounded-xl overflow-hidden shadow ring-1 ring-slate-200/70">
          <img src="/images/zicara.jpeg" alt="Kotor linbana" class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/20 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white">Biser Boke Kotorske</h3>
            <p class="text-sm text-slate-100/95">Montenegro</p>
          </div>
          <div class="absolute bottom-4 right-4 rounded-full bg-white/90 backdrop-blur px-3 py-1.5 text-[13px] font-semibold text-slate-900">100€</div>
        </a>
        <!-- Card 3: Dykning -->
        <a href="/kontakt" class="group relative block rounded-xl overflow-hidden shadow ring-1 ring-slate-200/70">
          <img src="/images/dyka.jpg" alt="Posejdonov grad – dykning" class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/20 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white">Posejdonov grad</h3>
            <p class="text-sm text-slate-100/95">Luštica</p>
          </div>
          <div class="absolute bottom-4 right-4 rounded-full bg-white/90 backdrop-blur px-3 py-1.5 text-[13px] font-semibold text-slate-900">120€</div>
        </a>
      </div>
    </div>
  </section>


   <!-- Bildgalleri med beskrivningar, vivamedia.se-inspirerad layout -->
  <section data-section="gallery" class="py-20 bg-white">
    
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold mb-12 text-blue-1000 text-center">Destination för alla årstider</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-12">
          <!-- Båtutflykter -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/jedrenje.webp" alt="Båtutflykter" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Båtutflykter & kustäventyr</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Upptäck Montenegros kust med båtutflykter till avlägsna stränder, grottor och öar. Perfekt för både avkoppling och äventyr.</p>
          </div>
        </div>
          <!-- Divlja priroda -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/divljapriroda.jpg" alt="Vild natur" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Vild natur & äventyr</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Vandra genom orörd natur, upptäck gömda dalar och känn friheten i Montenegros vildmark.</p>
          </div>
        </div>
        <!-- Kultur & historia -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/perast2.webp" alt="Kultur & historia" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Kultur & historia</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Utforska Montenegros rika kulturarv, besök historiska platser och lär dig om landets traditioner och folkkultur.</p>
          </div>
        </div>
        <!-- Vattensporter -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/kajak.jpg" alt="Vattensporter" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Vattensporter & strandliv</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Njut av vattensporter som snorkling, dykning, kajakpaddling och vindsurfing längs Montenegros vackra kustlinje. Perfekt för både familjer och äventyrslystna.</p>
          </div>
        </div>
        <!-- Fiske -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/brodovi.jpg" alt="Fiske" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Fiske & naturupplevelser</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Följ med på fiskeutflykter i Montenegros sjöar och floder. Upptäck det rika djurlivet och njut av stillheten i naturen.</p>
          </div>
        </div>
         <!-- Zicara -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/zicara.jpeg" alt="Zicara" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Zicara – Linbana & utsikt</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Ta linbanan upp i bergen och njut av storslagen utsikt över landskapet. Perfekt för både äventyraren och den som vill ta det lugnt.</p>
          </div>
        </div>
      
        <!-- Jedrenje -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/jedrenje4.webp" alt="Segling" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Segling & havsäventyr</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Upplev Adriatiska havet med segling, kajak eller SUP – äventyr och avkoppling i ett.</p>
          </div>
        </div>
       <!-- Vandring & Trekking -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/hiking.webp" alt="Vandring & Trekking" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Vandring & Trekking</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Vandra genom Montenegros spektakulära landskap. Upptäck panoramavyer, frodiga skogar och orörd natur på välmarkerade leder.</p>
      </div>
    </div>
        <!-- Vinprovning -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/vin2.webp" alt="Vinprovning" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Vinprovning & smakupplevelser</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Besök vingårdar, smaka på lokala viner och njut av Montenegros kulinariska traditioner.</p>
          </div>
        </div>
        <!-- UNESCO -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/unesco1.webp" alt="Kultur & historia" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Kultur & historia</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Utforska världsarv, gamla städer och Montenegros rika historia.</p>
          </div>
        </div>
      
        <!-- Fiske -->            
        <!-- Bröd -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/muslje.jpg" alt="Bröd" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Lokala smaker</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Smaka på nybakat bröd och andra lokala delikatesser från små byar och marknader.</p>
          </div>
        </div>
        <!-- Mimoza -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/mimoza.webp" alt="Mimoza" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Festival & tradition</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Upplev färgstarka festivaler och traditioner som sätter guldkant på resan.</p>
          </div>
        </div>
        <!-- Cykla -->
        <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
          <img src="/images/cykla.jpg" alt="Cykla" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <h3 class="text-lg font-semibold text-white mb-2">Cykla i Montenegro</h3>
            <p class="text-sm text-slate-100/95 leading-snug">Upptäck Montenegro på två hjul – cykla genom vackra landskap, längs kusten eller i bergen. Passar både familjer och äventyrslystna.</p>
          </div>
        </div>
          <!-- Dykning -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/dyka.jpg" alt="Dykning" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Dykning</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Dyk ner i Montenegros undervattensvärld och utforska vrak, grottor och färgstarka rev. Upptäck det fascinerande vraket av ångfartyget Tihany och andra marina äventyr.</p>
      </div>
    </div>
    <!-- Ridning -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/ridning.jpg" alt="Ridning" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Ridning</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Upplev Montenegros landskap från hästryggen. Följ organiserade ridturer genom byar, dalar och gröna ängar för en oförglömlig naturupplevelse.</p>
      </div>
    </div>
    <!-- Rafting -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/rafting2.webp" alt="Rafting" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Rafting</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Följ med på spännande rafting i Tara-kanjonen, Europas djupaste kanjon. Känn adrenalinet i det kristallklara vattnet genom Durmitor nationalpark.</p>
      </div>
    </div>
    <!-- Skidåkning -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/kolasinski.jpg" alt="Skidåkning" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Skidåkning</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Njut av snösäkra backar och vackra vyer i Kolašin. Skidåkning, snöskoter och längdskidåkning för hela familjen i Montenegros berg.</p>
      </div>
    </div>
            <!-- Canyoning -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/kanjon1.webp" alt="Canyoning" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Canyoning</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Ge dig ut på canyoning i Montenegros dramatiska kanjoner. Hoppa, simma och klättra genom forsande vatten och vilda raviner.</p>
      </div>
    </div>
    <!-- Paragliding -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/paragliding.webp" alt="Paragliding" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Paragliding</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Flyg fritt över Montenegros berg och sjöar. Paragliding bjuder på oförglömliga vyer och frihetskänsla för både nybörjare och erfarna.</p>
      </div>
    </div>
    <!-- Flygfiske -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/flygfiske.webp" alt="Flygfiske" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Flygfiske</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Prova flugfiske i Montenegros orörda floder och sjöar. Fiska i kristallklara vatten omgivna av vacker natur och rikt djurliv.</p>
      </div>
    </div>
    <!-- Quad-turer -->
    <div class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-xl hover:scale-[1.02] transition bg-white">
      <img src="/images/dipovi.jpg" alt="Quad-turer" class="w-full h-64 object-cover rounded-3xl transition duration-500 group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-900/30 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-5">
        <h3 class="text-lg font-semibold text-white mb-2">Quad-turer</h3>
        <p class="text-sm text-slate-100/95 leading-snug">Utforska Luštica-halvön och Montenegros landsbygd på fyrhjuling. Spännande offroad-turer genom byar, kullar och längs kusten.</p>
      </div>
    </div>
    
      </div>
    </div>
  </section>
  
  <!-- Booking Form Section -->
  <section data-section="interest-form" class="py-16 bg-blue-50">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-lg p-8">
      <h2 class="text-2xl font-bold mb-4 text-blue-900 text-center">Intresseanmälan</h2>
      <form action="https://formspree.io/f/yourid" method="POST" class="space-y-4">
        <input type="text" name="namn" placeholder="Namn" required class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-blue-200" />
        <input type="email" name="email" placeholder="E-post" required class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-blue-200" />
        <input type="text" name="antal" placeholder="Antal resenärer" class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-blue-200" />
        <input type="text" name="datum" placeholder="Önskat resedatum" class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-blue-200" />
        <textarea name="önskemål" placeholder="Berätta om era önskemål" rows="4" class="w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-blue-200"></textarea>
        <button type="submit" class="w-full px-6 py-3 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition">Skicka intresseanmälan</button>
      </form>
      <p class="text-xs text-gray-500 mt-4 text-center">
