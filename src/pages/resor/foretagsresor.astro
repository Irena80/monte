---
import Layout from '~/layouts/PageLayout.astro';

// Removed Hero2 in favor of custom full-bleed hero

import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';



const metadata = {
  title: 'Företagsresor',
};
---
<Layout metadata={metadata}>
  

  <!-- Full-bleed hero like screenshot: background image, overlay, centered heading -->
  <section data-section="hero" class="relative w-full h-[86vh] min-h-[640px] overflow-hidden">
    <!-- Background image -->
    <img
      src="/images/petrovac.png"
      alt="Yacht along Montenegro coast"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/35"></div>
    <!-- Bottom fade to white -->
    <div class="absolute inset-x-0 bottom-0 h-56 sm:h-64 bg-gradient-to-b from-transparent to-white"></div>

    <!-- Centered content -->
    <div class="relative h-full flex items-center justify-center px-6 z-10">
      <div class="w-full max-w-3xl text-center">
        <h1 class="text-white text-[2rem] sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] drop-shadow-[0_6px_22px_rgba(0,0,0,0.55)]">
          Företagsresor till <br />
          <span class="text-white">Montenegro</span>
        </h1>
        <p class="mt-3 text-white/90 text-[0.95rem] sm:text-base md:text-lg leading-relaxed max-w-xl mx-auto">
          Kombinera affärer med avkoppling på Adriatiska havets pärla
        </p>
        <div class="mt-6 flex items-center justify-center">
          <a href="/contact" class="inline-flex items-center rounded bg-slate-900/90 hover:bg-slate-900 text-white px-5 py-2.5 text-sm font-semibold shadow focus:outline-none focus:ring-2 focus:ring-white/40">
            Få offert för företagsresa
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Varför Montenegro section (matches screenshot) -->
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-14 md:mb-20 max-w-3xl mx-auto text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight mb-4">
          Varför Montenegro för företagsresor?
        </h2>
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
          Montenegro erbjuder den perfekta balansen mellan professionella möten och teambuilding i spektakulär miljö. Det lilla landet med de stora kontrasterna – där du kan bada i det kristallklara Adriatiska havet på förmiddagen och vandra bland dramatiska bergstoppar på eftermiddagen. Korta avstånd. Stora upplevelser.
        </p>
      </div>

      <div class="grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <!-- Lyxyachter -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <!-- simple yacht icon -->
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 17c2 2 4 .5 6 .5s4 1.5 6 0 4 1.5 6 0" stroke-linecap="round"/>
              <path d="M4 15h12l-2.5-4.5-5-2.5L6 10l-2 5z" stroke-linejoin="round"/>
              <path d="M13 8V4l-3 2"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Lyxyachter</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Exklusiva teambuilding-<br/>aktiviteter på privata yachter</p>
        </div>

        <!-- Moderna lokaler -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <!-- building icon -->
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="6" y="4" width="12" height="16" rx="1"/>
              <path d="M9 8h2M13 8h2M9 12h2M13 12h2M9 16h6"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Moderna lokaler</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Konferenslokaler med<br/>toppmodern teknologi</p>
        </div>

        <!-- Teambuilding -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <!-- team icon -->
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="8" r="3"/>
              <path d="M4 19c0-3 3-5 8-5s8 2 8 5"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Teambuilding</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Skräddarsydda aktiviteter för<br/>att stärka teamet</p>
        </div>

        <!-- Full service -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <!-- briefcase icon -->
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="7" width="18" height="12" rx="2"/>
              <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Full service</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Vi sköter all planering från start<br/>till mål</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Paketerbjudanden (teaser grid, like screenshot) -->
  <section id="paket" class="py-20 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Aktuella kampanjer</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight">Några av våra erbjudanden</h2>
          <p class="mt-5 max-w-2xl text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">Exklusivt utvalda hotell & upplevelser för företagsresor. Perfekt för grupper som vill kombinera kvalitet, läge och minnesvärd service.</p>
        </div>
        <div>
          <a href="/boka?from=/resor/foretagsresor" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 dark:hover:bg-slate-200 transition shadow">Se alla resepaket <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-10">
        <!-- Kotor Bay card -->
        <a href="/erbjudanden/konferensresa-kotor-bay" class="group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow hover:shadow-lg transition focus:outline-none focus:ring-2 focus:ring-blue-400/40">
          <div class="relative w-full aspect-[16/10] overflow-hidden">
            <img src="/images/boka-bay-lustica.jpg" alt="Kotor Bay" class="absolute inset-0 w-full h-full object-cover transition group-hover:scale-105 duration-300" loading="lazy" decoding="async" />
          </div>
          <div class="p-5">
            <h3 class="text-lg md:text-xl font-semibold tracking-tight text-slate-900 dark:text-white">KONFERENSRESA TILL KOTOR</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm mt-1">4★ hotell med konferensrum</p>
            <p class="text-slate-500 dark:text-slate-400 text-sm">Kotorbukten, Montenegro</p>
          </div>
        </a>

        <!-- Budva card -->
  <a href="/erbjudanden/foretagsresa-budva" class="group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow hover:shadow-lg transition focus:outline-none focus:ring-2 focus:ring-blue-400/40">
          <div class="relative w-full aspect-[16/10] overflow-hidden">
            <img src="/images/budva1.jpg" alt="Hotel Budva" class="absolute inset-0 w-full h-full object-cover transition group-hover:scale-105 duration-300" loading="lazy" decoding="async" />
          </div>
          <div class="p-5">
            <h3 class="text-lg md:text-xl font-semibold tracking-tight text-slate-900 dark:text-white">FÖRETAGSRESA TILL BUDVA</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm mt-1">5★ hotell & moderna möteslokaler</p>
            <p class="text-slate-500 dark:text-slate-400 text-sm">Budva, Montenegro</p>
          </div>
        </a>

        <!-- Durmitor card -->
  <a href="/erbjudanden/teambuilding-durmitor" class="group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow hover:shadow-lg transition focus:outline-none focus:ring-2 focus:ring-blue-400/40">
          <div class="relative w-full aspect-[16/10] overflow-hidden">
            <img src="/images/Durmitor.jpg" alt="Durmitor nationalpark" class="absolute inset-0 w-full h-full object-cover transition group-hover:scale-105 duration-300" loading="lazy" decoding="async" />
          </div>
          <div class="p-5">
            <h3 class="text-lg md:text-xl font-semibold tracking-tight text-slate-900 dark:text-white">TEAMBUILDING I DURMITOR</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm mt-1">Rafting, zipline & bergsvandringar</p>
            <p class="text-slate-500 dark:text-slate-400 text-sm">Zabljak, Montenegro</p>
          </div>
        </a>
      </div>
    </div>
  </section>


  <!-- Features Widget ************** -->

  

  <!-- Content Widget **************** -->

  <Content
    title="Urval av några upplevelser"
    subtitle="Här presenterar vi ett urval av några av våra populäraste upplevelser som vi arrangerar för företagsgrupper i  Montenegro.  Intresserad av något helt annat? Kontakta oss gärna och berätta om era önskemål."
    isReversed
    classes={{ container: 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade' }}
    items={[
      {
        title: 'Kust- och bergsupplevelse på en dag',
        description:
          'På en dag kan man uppleva den lilla orten Rosas underbara havsmiljö och njuta av dykning, fiske, segling och därefter fortsätta äventyret med att cykla, vandra eller till och med åka skidor i en helt annan miljö bland de vackra landskapen i Orjenas sluttningar. <br>'
      },
    
    ]}
    image={{
      src: '/images/jedrenje4.webp',
      alt: 'Startup Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Två upplevelser på en dag <br /><span class="text-2xl">Kombinera jobb och äventyr</span>
      </h3>
      <div class="mt-4">
        <a href="/upplevelser/tva-upplevelser-pa-en-dag" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 transition shadow">
          Läs mer
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  
  <Content
    isAfterContent={true}
    classes={{ container: 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade' }}
    items={[
      {
        title: 'Upplev Gamla Stan',
        description: `Gamla Stan i Herceg Novi är en av regionens bäst bevarade medeltida städer och finns upptagen på UNESCOS världsarvslista. Med guide promenerar vi i stadens trånga gränder, kullerstensbelagda torg och gator. Vi avslutar turen med en stärkande brunch på ringmuren, där vi bjuds på en utsikt över bukten och gamla stans takåsar.`,
      },
     
    ]}
    image={{
      src: '/images/stari-grad3.jpg',
      alt: 'SaaS Businesses Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Stadsvandring <br /><span class="text-2xl">Guidad tur med brunch</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    classes={{ container: 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade' }}
    items={[
      {
        title: 'Utforska den orörda skönheten',
        description: `Montenegro är en perfekt destination för segling på grund av dess 295 mil kust, milt medelhavsklimat och naturlig skönhet och rik historia. Adriatiska havet är djupt, kristallklart och det är lätt att navigera eftersom det finns så få grund. Varje ö har sin egen historia att berätta. Historien av denna seglings destination går tillbaka till 9: e århundradet. Under den tiden har det har formats av ortodoxa, islamiska och Adriatiska influenser såväl som Centraleuropeiska. En vacker kust och hav med stor hjälp av gynnsamma vindar gör den utmärkt för segling. `,
      },
     
    ]}
    image={{
      src:'/images/jedrenje2.webp',
      alt: 'Portfolio Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Segling <br /><span class="text-2xl">Res genom natur och historia</span>
      </h3>
      <div class="mt-4">
        <a href="/yahting#process" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 transition shadow">
          Segling
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    classes={{ container: 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade' }}
    items={[
      {
        title: 'Upplev den vilda naturen',
        description: `En oförglömlig offroad upplevelse där vi på en dag kan uppleva Montenegros mångfacitterande skönhet. Vi kör på nervkittlande serpentinvägar och når Montenegros högsta berg, passerar Boka Bay som påminner om Norges dramatiska fjordlandskap och gör stopp i lokala byar där vi får provsmaka på lokala delikatesser`,
      },
     
    ]}
    image={{
      src:'/images/planina.jpg',
      alt: 'Small Business Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Naturäventyr <br /><span class="text-2xl">Jeeptur i bergen</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
  
  <!-- Företagspaket pricing section (after Naturäventyr) -->
  <section id="foretagspaket" class="py-20 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 md:mb-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900">Företagspaket</h2>
        <p class="mt-2 text-sm md:text-base text-slate-600">Skräddarsydda paket för alla typer av företagsevent</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Konferenspaket -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm hover:shadow transition">
          <h3 class="text-lg md:text-xl font-semibold text-slate-900">Standard konferenspaket</h3>
          <div class="mt-2 text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">Från 15 000 kr</div>
          <p class="text-xs text-slate-500">per person</p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Flyg tur & retur</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>4* hotell, 3 nätter</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Konferenslokal med utrustning</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Helpension</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Flygplatstransfer</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Kaffepauser</li>
          </ul>
          <div class="mt-8">
            <a href="/boka?paket=konferens" class="w-full inline-flex justify-center items-center rounded-lg bg-slate-900 text-white px-5 py-3 text-sm font-semibold hover:bg-slate-700 transition">Boka paket</a>
          </div>
        </div>

        <!-- Teambuilding Deluxe (highlighted) -->
        <div class="relative rounded-2xl border-2 border-blue-600/30 bg-white p-6 md:p-8 shadow-md hover:shadow-lg transition scale-[1.02]">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block rounded-full bg-blue-600 text-white text-xs font-semibold px-3 py-1 shadow">Populärast</span>
          <h3 class="text-lg md:text-xl font-semibold text-slate-900">Teambuilding Deluxe</h3>
          <div class="mt-2 text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">Från 22 000 kr</div>
          <p class="text-xs text-slate-500">per person</p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Flyg tur & retur</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>5* hotell, 4 nätter</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Yachtutflykt hel dag</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>3 teambuilding-aktiviteter</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Helpension + gallamiddag</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Professionell eventkoordinator</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Transport under hela resan</li>
          </ul>
          <div class="mt-8">
            <a href="/boka?paket=teambuilding-deluxe" class="w-full inline-flex justify-center items-center rounded-lg bg-slate-900 text-white px-5 py-3 text-sm font-semibold hover:bg-slate-700 transition">Boka paket</a>
          </div>
        </div>

        <!-- VIP Executive -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm hover:shadow transition">
          <h3 class="text-lg md:text-xl font-semibold text-slate-900">VIP Executive</h3>
          <div class="mt-2 text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">Från 35 000 kr</div>
          <p class="text-xs text-slate-500">per person</p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Business class flyg</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Lyxhotell suite, 5 nätter</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Privat yacht charter 2 dagar</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Exklusiva upplevelser</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Michelin-restauranger</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>Personlig concierge 24/7</li>
            <li class="flex items-start gap-2"><span class="mt-1 inline-block h-4 w-4 rounded-full bg-green-500"></span>VIP-transport hela resan</li>
          </ul>
          <div class="mt-8">
            <a href="/boka?paket=vip-executive" class="w-full inline-flex justify-center items-center rounded-lg bg-slate-900 text-white px-5 py-3 text-sm font-semibold hover:bg-slate-700 transition">Boka paket</a>
          </div>
        </div>
      </div>
    </div>
  </section>
 
  
   
  
<!-- BlogLatestPost Widget **************** -->

<!-- Varför oss / Value Proposition (redesigned with image) -->
<section id="varfor-oss" class="py-24 bg-white border-t border-slate-100">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <!-- Copy -->
      <div>
