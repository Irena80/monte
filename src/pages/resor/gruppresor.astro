---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/resor/gruppresor.astro
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import ImageCard1 from '~/components/ImageCard1.astro';
import OfferCard from '~/components/OfferCard.astro';

const metadata = {
  title: 'Gruppresor',
};
// Data för erbjudanden
const offers = [
  {
    slug: 'late-summer-budva',
    title: 'HÖST I BUDVA',
    discount: '20% rabatt',
    hotel: 'Hotel Budva',
    location: 'Budva, Montenegro',
    image: '/images/hotel-budva.jpg',
    alt: 'Pool och terrass vid Hotel Budva med utsikt',
    href: '/erbjudanden/sensommar-budva'
  },
  {
    slug: 'hostlov-herceg-novi',
    title: 'HÖSTLOVET i Herceg Novi',
    discount: '25% rabatt',
    hotel: 'Lazure Hotel & Marina',
    location: 'Herceg Novi, Montenegro',
    image: '/images/lazure.webp',
    alt: 'Lazure Hotel & Marina med palmer och spegelblank pool',
    href: '/erbjudanden/hostlov-herceg-novi'
  },
  {
    slug: 'julledighet-Tivat',
    title: 'JULLEDIGHET I TIVAT',
    discount: '35% rabatt',
    hotel: 'Hotel Astoria, Tivat',
    location: 'Tivat, Montenegro',
    image: '/images/Astoria.webp',
    alt: 'Turkos pool med solsängar och parasoll vid havet',
    href: '/erbjudanden/jullov-tivat'
  }
];
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->
  <Hero
    
    actions={[
      { text: 'Boka', icon: 'tabler:run', href: '/boka' },
    ]}
  >
    <Fragment slot="title">
      Aktiva <span class="hidden xl:inline"></span> <span class="text-blue-900 dark:text-white highlight"> gruppresor </span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Upptäck kontrasternas land </span> en äkta skattkista inramad av Adriatiska havets kristallklara vatten och Balkans majestätiska berg.
      </span>
    </Fragment>
    <Fragment slot="image">
      <!-- Static bild ersätter video -->
      <picture class="block w-full">
        <source srcset="/images/Montenegro-Boats_luka.jpg" type="image/jpeg" />
        <img
          src="/images/Montenegro-Boats_luka.jpg"
          alt="Båtar i montenegrinsk hamn"
          class="w-full h-auto object-cover"
          loading="eager"
          decoding="async"
        />
      </picture>
    </Fragment>
  </Hero>

  <!-- Lyxiga erbjudanden först -->
  <section id="erbjudanden" class="py-20 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Aktuella kampanjer</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight">Några av våra erbjudanden</h2>
          <p class="mt-5 max-w-2xl text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">Exklusivt utvalda hotell & upplevelser med tidsbegränsade rabatter. Perfekt för grupper som vill kombinera kvalitet, läge och minnesvärd service.</p>
        </div>
        <div>
          <a href="/resor" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 dark:hover:bg-slate-200 transition shadow">Se alla resepaket <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {offers.map(o => (
          <OfferCard
            href={o.href}
            slug={o.slug}
            title={o.title}
            discount={o.discount}
            hotel={o.hotel}
            location={o.location}
            image={o.image}
            alt={o.alt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Process: Ny layout -->
  <section id="process" class="py-24 bg-white dark:bg-slate-900 border-t border-slate-200/70 dark:border-slate-700/40">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-12 gap-12">
      <!-- Left Intro -->
      <div class="lg:col-span-6">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight tracking-tight">Välj mellan redan färdiga
          <span class="block">resepaket eller kontakta oss för</span>
          <span class="block">en skräddarsydd upplevelse!</span>
        </h2>
        <p class="mt-6 text-lg text-slate-600 dark:text-slate-300 max-w-xl leading-relaxed">Låt oss hjälpa dig att skapa en oförglömlig resa!</p>
        <div class="mt-10">
          <a href="/contact" class="inline-flex items-center justify-center rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-8 py-4 shadow focus:outline-none focus:ring-2 focus:ring-blue-600 transition">Kontakta oss</a>
        </div>
      </div>
      <!-- Steps Right -->
      <div class="lg:col-span-6 grid sm:grid-cols-2 gap-y-12 gap-x-10">
        {[
          { num: '1', title: 'Välj paket', desc: 'Utforska våra färdiga upplägg eller hör av dig för att skapa en skräddarsydd lösning.' },
          { num: '2', title: 'Anpassa', desc: 'Lägg till aktiviteter, logi och måltider efter gruppens mål.' },
          { num: '3', title: 'Bekräfta', desc: 'Vi säkrar datum, partners och logistik.' },
          { num: '4', title: 'Res & upplev', desc: 'Vi finns på plats och koordinerar allt för smidig upplevelse.' }
        ].map(step => (
          <div class="relative pl-0">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-700 dark:text-blue-300 text-2xl font-semibold">{step.num}</div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">{step.title}</h3>
                <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-xs">{step.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Destination / Inspiration blocks -->
  <section id="destinationer" class="py-20 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 space-y-24">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start">
        <div class="md:col-span-5 order-2 md:order-1">
          <h2 class="text-3xl md:text-4xl font-serif font-medium text-slate-900 dark:text-white mb-5">Upplev kusten</h2>
          <div class="prose prose-slate dark:prose-invert max-w-none text-base leading-relaxed">
            <p>Lilla Montenegro är en äkta skattkista, inramad av Adriatiska havets kristallklara vatten och Balkans berg. Längs den nästan 30 mil långa kustlinjen gömmer sig pärlor som Herceg Novi, Tivat, Kotor, Budva och Bar.</p>
            <p>Historia i varje gränd – stenhus, planteringar och hamnar där kultur och modern livsstil möts.</p>
            <p>Aktiva dagar och sociala kvällar: vandring, båtutflykter, gastronomi och avkoppling i samma region.</p>
          </div>
          <a href="/kusten" class="inline-flex items-center gap-2 mt-6 text-blue-700 dark:text-blue-300 font-medium hover:underline">Läs mer <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
        <div class="md:col-span-7 order-1 md:order-2">
          <img src="/images/brod.jpg" alt="Kustupplevelser Montenegro" class="w-full aspect-[4/3] md:aspect-[16/10] rounded-xl object-cover shadow" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start">
        <div class="md:col-span-7">
          <img src="/images/lukavica.webp" alt="Montenegrinska berg" class="w-full aspect-[4/3] md:aspect-[16/10] rounded-xl object-cover shadow" loading="lazy" decoding="async" />
        </div>
        <div class="md:col-span-5">
          <h2 class="text-3xl md:text-4xl font-serif font-medium text-slate-900 dark:text-white mb-5">Berg och land</h2>
          <div class="prose prose-slate dark:prose-invert max-w-none text-base leading-relaxed">
            <p>Utforska toppar över 2000 meter, dramatiska kanjoner och gömda grottor. Åk längs serpentinvägar och känn hur landskapet skiftar på korta avstånd.</p>
            <p>Traditionellt hantverk, katuns, lokala rätter och stilla skogar – autentiska inslag som bygger minnen.</p>
            <p>Perfekt mix för grupper som vill ha äventyr på dagen och social kvalitetstid på kvällen.</p>
          </div>
          <a href="/inlandet" class="inline-flex items-center gap-2 mt-6 text-blue-700 dark:text-blue-300 font-medium hover:underline">Läs mer <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <div class="relative mx-auto max-w-6xl px-4 md:px-3 py-12 md:py-16 lg:py-10 text-default">
    <!-- Intro block återinsatt före Gastronomisk biltur -->
    <div class="mb-12 md:mb-16 text-center md:text-left">
      <h2 class="text-3xl md:text-4xl font-serif font-medium text-slate-900 dark:text-white leading-snug">
        Letar du efter en unik upplevelse?
      </h2>
      <p class="mt-4 text-lg md:text-xl text-slate-600 dark:text-slate-300 font-light">
        Sätt siktet på Montenegro och upplev kontrasternas land!
      </p>
    </div>
    <div class="flex flex-col md:flex-row items-start mb-10">
      <img src="../images/lustica1.JPG" alt="Montenegros häftigaste hotell" class="w-full md:w-1/2 h-[300px] md:h-[360px] object-cover rounded-xl shadow" />
      <div class="mt-4 md:mt-0 md:ml-8">
        <h2 class="text-2xl font-bold">Gastronimsk biltur</h2>
        <p> <br>Med fyrhjulsdrivna jeepar upptäcker vi Montenegros grönskande landskap med berg och djupa dalar. Längs vägen gör vi  olika stopp, där det första blir på en traditionell ”olivolje-kvarn” som har ägts av samma familj sedan 1600-talet. De två andra stoppen är vid en apelsinodling och besök på en vinkällare, där vi självklart får provsmaka och lära oss mer om gårdens druvor. På det sista stoppet får vi provsmaka ’pršut’ som är ett kallskuret kött välkänt för Balkan.</p>
      </div>
    </div>
    <div class="flex flex-col md:flex-row items-start mb-10">
      <img src="../images/masline.webp"  class="w-full md:w-1/2 h-[300px] md:h-[360px] object-cover rounded-xl shadow" />
      <div class="mt-4 md:mt-0 md:ml-8">
        <h2 class="text-2xl font-bold">Vandra bland olivlundar</h2>
        <p>  <br>Besök den familjeägda ekologiska olivgården Moric på Luštica-halvön och lär dig allt om olivodling, skörd och hantverksmässiga metoder för olivoljeproduktion. Vandra bland nästan 1 000 olivträd som är över 300 år gamla och njut av hemlagade specialiteter och välkomstdrinkar i den genuina atmosfären på den gamla stenpressen!</p>
      </div>
    </div>
    <div class="flex flex-col md:flex-row items-start mb-10">
      <img src="../images/divljapriroda.jpg" alt="Från sadeln, upptäck Montenegros natursköna charm" class="w-full md:w-1/2 h-[300px] md:h-[360px] object-cover rounded-xl shadow" />
      <div class="mt-4 md:mt-0 md:ml-8">
        <h2 class="text-2xl font-bold">Äventyrliga aktiviteter </h2>
        <p> <br> Montenegro är ett paradis för den aktiva resenären. Låt då din vilda sida leda dig till att utforska stigar som motorfordon inte kan nå. Prova på cykling, klättring eller varför inte en ridtur. Alternativen är många.</p>
      </div>
    </div>
    <div class="flex flex-col md:flex-row items-start mb-4">
      <img src="../images/perast2.webp"  class="w-full md:w-1/2 h-[300px] md:h-[360px] object-cover rounded-xl shadow" />
      <div class="mt-4 md:mt-0 md:ml-8">
        <h2 class="text-2xl font-bold">Segla och utforska </h2>
        <p>  <br>Under din båttur i Montenegro kan du hoppa över till ön Katič för dykning, utforska fortet på Mamula, eller hitta avskildhet på obebodda Stari Ulcinj. Den gamla staden Herceg Novi från 1300-talet är också väl värd ett besök, liksom stenstranden i Dobrec, som bara är tillgänglig med båt. <br>  <br> Från imponerande berg och antika städer till vackra stränder med kristallklart vatten. Unesco har utsett världsarvsplatser i Perast och Kotor. Se till att vandra uppför den branta kullen för att se Kotors imponerande venetianska fästning med fantastisk utsikt över bukten!</p>
      </div>
    </div>
  
  </div>
<br>
  




<style>
  .component-left,
  .component-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 2rem;
  }
  .component-left img,
  .component-right img {
    width: 50%;
    height: auto;
  }
  .component-left .content,
  .component-right .content {
    padding: 1rem;
    width: 50%;
  }

  @media (max-width: 768px) {
    .component-left,
    .component-right {
      flex-direction: column;
    }
    .component-left img,
    .component-right img {
      width: 100%;
    }
    .component-left .content,
    .component-right .content {
      width: 100%;
      padding: 1rem 0;
    }
  }
</style>

<script>
  (function () {
    try {
      const params = new URLSearchParams(window.location.search);
      // If an explicit internal origin is provided via ?from=, keep default behavior
      if (params.has('from')) return;
      const ref = document.referrer;
      let sameOrigin = false;
      if (ref) {
        try { sameOrigin = new URL(ref).origin === window.location.origin; } catch { /* ignore parse errors */ }
      }
      if (!sameOrigin) {
        // Ensure that pressing the browser back button returns to index instead of leaving the site
        history.pushState({ redirectBackToHome: true }, '', window.location.href);
        window.addEventListener('popstate', function () {
          window.location.href = '/';
        });
      }
    } catch {
      // noop
    }
  })();
</script>