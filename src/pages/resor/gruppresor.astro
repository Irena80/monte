      const ref = document.referrer;
      let sameOrigin = false;
      if (ref) {
        try { sameOrigin = new URL(ref).origin === window.location.origin; } catch { /* ignore parse errors */ }
      }
      if (!sameOrigin) {
        // Ensure that pressing the browser back button returns to index instead of leaving the site
        history.pushState({ redirectBackToHome: true }, '', window.location.href);
        window.addEventListener('popstate', function () {
          window.location.href = '/';
        });
      }
    } catch {
      // noop
    }
  })();
</script>