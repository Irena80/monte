---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/resor/gruppresor.astro
import Layout from '~/layouts/PageLayout.astro';
import OfferCard from '~/components/OfferCard.astro';

const metadata = {
  title: 'Gruppresor',
};
// Data för erbjudanden
const offers = [
  {
    slug: 'late-summer-budva',
    title: 'HÖST I BUDVA',
    discount: '20% rabatt',
    hotel: 'Hotel Budva',
    location: 'Budva, Montenegro',
    image: '/images/hotel-budva.jpg',
    alt: 'Pool och terrass vid Hotel Budva med utsikt',
    href: '/erbjudanden/sensommar-budva'
  },
  {
    slug: 'hostlov-herceg-novi',
    title: 'HÖSTLOVET i Herceg Novi',
    discount: '25% rabatt',
    hotel: 'Lazure Hotel & Marina',
    location: 'Herceg Novi, Montenegro',
    image: '/images/lazure.webp',
    alt: 'Lazure Hotel & Marina med palmer och spegelblank pool',
    href: '/erbjudanden/hostlov-herceg-novi'
  },
  {
    slug: 'julledighet-Tivat',
    title: 'JULLEDIGHET I TIVAT',
    discount: '35% rabatt',
    hotel: 'Hotel Astoria, Tivat',
    location: 'Tivat, Montenegro',
    image: '/images/Astoria.webp',
    alt: 'Turkos pool med solsängar och parasoll vid havet',
    href: '/erbjudanden/jullov-tivat'
  }
];
---

<Layout metadata={metadata}>
  <!-- Hero: full-bleed yacht image with overlay like the screenshot -->
  <section data-section="hero" class="relative w-full h-[86vh] min-h-[640px] overflow-hidden">
    <img
      src="/images/sailing.jpg"
      alt="Yacht på Adriatiska havet"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/25"></div>
    <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent to-white"></div>

    <div class="relative h-full flex items-center justify-center px-6 z-10 text-center">
      <div class="w-full max-w-3xl">
        <h1 class="text-white text-[2rem] sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] drop-shadow-[0_6px_22px_rgba(0,0,0,0.55)]">
          Gruppresor till <br />
          <span class="text-white">Montenegro</span>
        </h1>
        <p class="mt-4 text-white/95 text-[1.05rem] sm:text-lg md:text-xl leading-snug font-semibold max-w-3xl mx-auto">
          Upplev Adriatiska havets pärla tillsammans med dina vänner, familj eller grupp
        </p>
        <div class="mt-6 flex items-center justify-center">
          <a href="#erbjudanden" class="inline-flex items-center rounded bg-slate-900/90 hover:bg-slate-900 text-white px-5 py-2.5 text-sm font-semibold shadow focus:outline-none focus:ring-2 focus:ring-white/40">
            Se alla gruppresor
          </a>
        </div>
      </div>
    </div>
  </section>

 <!-- Varför resa i grupp: section under hero -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10 md:mb-14">
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900">Varför resa i grupp till Montenegro?</h2>
        <p class="mt-2 text-sm md:text-base text-slate-600">Skapa minnen för livet tillsammans med de du älskar</p>
      </div>

      <div class="grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-4">
        <!-- Dela upplevelser -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="9" cy="8" r="3"/>
              <circle cx="17" cy="9" r="2.5"/>
              <path d="M3 19c0-3.2 3.4-5 6-5s6 1.8 6 5"/>
              <path d="M14.5 14.5c2.7 0 5.5 1.5 5.5 4.5"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Dela upplevelser</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Fantastiska minnen blir ännu<br/>bättre när de delas med nära<br/>och kära</p>
        </div>

        <!-- Stärk banden -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 21s-7-4.5-9.5-8A5.5 5.5 0 1112 7a5.5 5.5 0 119.5 6c-2.5 3.5-9.5 8-9.5 8z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Stärk banden</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Gemensamma äventyr skapar<br/>starkare relationer</p>
        </div>

        <!-- Oförglömliga minnen -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="6" width="18" height="14" rx="2"/>
              <circle cx="12" cy="13" r="3.5"/>
              <path d="M8 6l2-3h4l2 3"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Oförglömliga minnen</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Upplev spektakulära platser<br/>och äventyr tillsammans</p>
        </div>

        <!-- Bekvämt & enkelt -->
        <div class="text-center rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow transition">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-900 ring-1 ring-inset ring-blue-200">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 21s6-6.5 6-11a6 6 0 10-12 0c0 4.5 6 11 6 11z"/>
              <circle cx="12" cy="10" r="2.5"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900">Bekvämt & enkelt</h3>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">Vi ordnar allt så ni kan fokusera<br/>på att ha kul</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Lyxiga erbjudanden först -->
  <section id="erbjudanden" class="py-20 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Aktuella kampanjer</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight">Några av våra erbjudanden</h2>
          <p class="mt-5 max-w-2xl text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">Exklusivt utvalda hotell & upplevelser med tidsbegränsade rabatter. Perfekt för grupper som vill kombinera kvalitet, läge och minnesvärd service.</p>
        </div>
        <div>
          <a href="/resor" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 dark:hover:bg-slate-200 transition shadow">Se alla resepaket <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {offers.map(o => (
          <OfferCard
            href={o.href}
            slug={o.slug}
            title={o.title}
            discount={o.discount}
            hotel={o.hotel}
            location={o.location}
            image={o.image}
            alt={o.alt}
          />
        ))}
      </div>
    </div>
  </section>

 

  <!-- Destination / Inspiration blocks -->
  <section id="destinationer" class="py-20 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 space-y-24">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start">
        <div class="md:col-span-5 order-2 md:order-1">
          <h2 class="text-3xl md:text-4xl font-serif font-medium text-slate-900 dark:text-white mb-3">Upplev kusten</h2>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">Historiska städer, kristallklart vatten och mysiga hamnar – perfekt för grupper som vill kombinera bad, mat och kultur.</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Strosa i Kotor & Budva – UNESCO-miljöer med charm i varje gränd</span></li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Båtutflykter till vikar, stränder och små öar</span></li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Gastronomi vid havet – färsk fisk, oliver och lokala viner</span></li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Kvällsliv & strandpromenader för alla smaker</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/kusten" class="inline-flex items-center justify-center rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 shadow">Utforska kusten</a>
            <a href="#grupppaket" class="inline-flex items-center justify-center rounded-full bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold px-6 py-3 shadow">Se paket</a>
          </div>
        </div>
        <div class="md:col-span-7 order-1 md:order-2">
          <div class="relative">
            <img src="/images/brod.jpg" alt="Kustupplevelser Montenegro" class="w-full aspect-[4/3] md:aspect-[16/10] rounded-xl object-cover shadow" loading="lazy" decoding="async" />
            <span class="absolute top-3 left-3 rounded-full bg-white/90 text-slate-900 text-xs font-semibold px-3 py-1 shadow">Kusten</span>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start">
        <div class="md:col-span-7">
          <div class="relative">
            <img src="/images/lukavica.webp" alt="Montenegrinska berg" class="w-full aspect-[4/3] md:aspect-[16/10] rounded-xl object-cover shadow" loading="lazy" decoding="async" />
            <span class="absolute top-3 left-3 rounded-full bg-white/90 text-slate-900 text-xs font-semibold px-3 py-1 shadow">Bergen</span>
          </div>
        </div>
        <div class="md:col-span-5">
          <h2 class="text-3xl md:text-4xl font-serif font-medium text-slate-900 dark:text-white mb-3">Berg och land</h2>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">Äventyr i storslagna landskap – från canyoner och toppar till stilla skogar och byliv.</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Vandring i nationalparker och panoramautsikter</span></li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Rafting i Tara-floden & zipline över canyoner</span></li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Jeepsafari, grottor och dolda smultronställen</span></li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Lokala byar (katuns), traditioner och matupplevelser</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/inlandet" class="inline-flex items-center justify-center rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 shadow">Utforska inlandet</a>
            <a href="#grupppaket" class="inline-flex items-center justify-center rounded-full bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold px-6 py-3 shadow">Se paket</a>
          </div>
        </div>
      </div>
    </div>
  </section>

   <!-- Grupppaket: pricing grid (moved below destinationer) -->
  <section id="grupppaket" class="py-20 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10 md:mb-14">
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900">Grupppaket</h2>
        <p class="mt-2 text-sm md:text-base text-slate-600">Paket anpassade för grupper om minst 8 personer</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Kust & Kultur -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
          <div class="flex items-center gap-2 text-slate-900 font-semibold">
            <span>🏝️</span>
            <span>Kust & Kultur</span>
          </div>
          <div class="mt-3">
            <div class="text-slate-900 font-extrabold text-xl">Från 8 900 kr</div>
            <div class="text-xs text-slate-500">per person</div>
          </div>
          <ul class="mt-5 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Flyg tur & retur</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Hotell 4*, 5 nätter</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Frukost dagligen</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Båtutflykt hel dag</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Guidad tur i Kotor & Budva</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Flygplats transfers</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Svensktalande guide</li>
          </ul>
          <div class="mt-6">
            <a href="/boka" class="block w-full text-center rounded bg-slate-900 text-white px-4 py-2.5 text-sm font-semibold hover:bg-slate-800">Boka paket</a>
          </div>
        </div>

        <!-- Äventyr & Action (highlight) -->
        <div class="relative rounded-2xl border-2 border-blue-600 bg-white p-6 md:p-8 shadow-sm">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block rounded-full bg-blue-600 text-white text-xs font-semibold px-3 py-1">Populärast</span>
          <div class="flex items-center gap-2 text-slate-900 font-semibold">
            <span>⛰️</span>
            <span>Äventyr & Action</span>
          </div>
          <div class="mt-3">
            <div class="text-slate-900 font-extrabold text-xl">Från 11 900 kr</div>
            <div class="text-xs text-slate-500">per person</div>
          </div>
          <ul class="mt-5 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Flyg tur & retur</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Hotell 4*, 6 nätter</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Halvpension</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Rafting i Tara-floden</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Zip-line äventyr</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Båtutflykt & snorkling</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Jeepsafari i bergen</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>All transport inkluderad</li>
          </ul>
          <div class="mt-6">
            <a href="/boka" class="block w-full text-center rounded bg-blue-600 text-white px-4 py-2.5 text-sm font-semibold hover:bg-blue-700">Boka paket</a>
          </div>
        </div>

        <!-- Premium All-Inclusive -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
          <div class="flex items-center gap-2 text-slate-900 font-semibold">
            <span>💎</span>
            <span>Premium All‑Inclusive</span>
          </div>
          <div class="mt-3">
            <div class="text-slate-900 font-extrabold text-xl">Från 16 900 kr</div>
            <div class="text-xs text-slate-500">per person</div>
          </div>
          <ul class="mt-5 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Flyg tur & retur</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Lyxhotell 5*, 7 nätter</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Helpension + dryck</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>Privat yatcharter 2 dagar</li>
