---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/resor/sportresor.astro
import Layout from '~/layouts/PageLayout.astro';

import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Sportresor',
};
---

<Layout metadata={metadata}>
 
  <!-- Full-bleed hero like Företagsresor -->
  <section data-section="hero" class="relative w-full h-[86vh] min-h-[640px] overflow-hidden">
    <img
      src="/images/zipline.webp"
      alt="Aktiva sportresor i Montenegro"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent to-white"></div>

    <div class="relative h-full flex items-center justify-center px-6 z-10">
      <div class="w-full max-w-3xl text-center">
        <h1 class="text-white text-[2rem] sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] drop-shadow-[0_6px_22px_rgba(0,0,0,0.55)]">
          Sportresor till <br />
          <span class="text-white">Montenegro</span>
        </h1>
        <p class="mt-3 text-white/90 text-[0.95rem] sm:text-base md:text-lg leading-relaxed max-w-xl mx-auto">
          Aktiva resor för lag, klubbar och grupper året runt – kombinera träning, natur och hav
        </p>
        <div class="mt-6 flex items-center justify-center">
          <a href="#kampanjer" class="inline-flex items-center rounded bg-slate-900/90 hover:bg-slate-900 text-white px-5 py-2.5 text-sm font-semibold shadow focus:outline-none focus:ring-2 focus:ring-white/40">
            Se sportpaket
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Widget **************** -->
  <Content
    title="Utforska äventyrslandet Montenegro"
    subtitle=" <span class='font-bold'> Träningsresor året runt!</span> Kombinera den fantastiska naturen, stärk gemenskapen och ta del av spännande sportevenemang för en aktiv och hälsosam livsstil. Vi erbjuder ett brett utbud av utomhusaktiviteter för både grupper och företag. Vandra genom natursköna landskap på våren och hösten, njut av simning och vattensporter på sommaren eller susa nerför skidbackarna på vintern."
    isReversed
  >
  </Content>

  <!-- Content Widget **************** -->
  <Content
    id="about"
    columns={3}
    classes={{ container: 'sport-icons' }}
    items={[
   
      {
        icon: 'tabler:play-football',
        callToAction: {
          target: '_blank',
          text: 'Fotboll',
          href: '#',
        },
      },
      {
        icon: 'tabler:ball-volleyball',
        callToAction: {
          target: '_blank',
          text: 'Volleyboll',
          href: '#',
        },
      },
      {
        icon: 'tabler:ball-tennis',
        callToAction: {
          target: '_blank',
          text: 'Tennis',
          href: '#',
        },
      },
      {
        icon: 'tabler:play',
        callToAction: {
          target: '_blank',
          text: 'Paddel',
          href: '#',
        },
      },
      {
        icon: 'tabler:golf',
        callToAction: {
          target: '_blank',
          text: 'Golf',
          href: '#',
        },
      },
      
      {
        icon: 'tabler:bike',
        callToAction: {
          target: '_blank',
          text: 'Cykling',
          href: '#',
        },
      },
      
    ]}
    image={{
      src: '/images/cykla.jpg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Träningsläger</h2>
      <p>
        Spela tennis på samma bana där Novak Djokovic brukar träna. Eller varför inte en paddelturnering med klubben? När man är ett gäng som spelar tillsammans hemma är det kul att åka utomlands, bo bra och ha tillgång till bra banor för olika aktiviteter. Spela på förmiddagen, ta ett dopp på eftermiddagen och ät gott på kvällen.
      </p>
    
      <p>
        Resa solo eller med sällskap. Att röra sig på semestern och ha en aktiv resa i grupp innebär hos oss att komma närmare resmålet, den goda maten och uppleva natur och gemenskap. Vi har träningsresor i härliga miljöer.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    id="about"
    columns={3}
    classes={{ container: 'sport-icons' }}
    items={[
      {
        icon: 'tabler:sailboat',
        callToAction: {
          target: '_blank',
          text: 'Segling',
          href: '#',
        },
      },
      {
        icon: 'tabler:scuba-diving',
        callToAction: {
          target: '_blank',
          text: 'Dykning',
          href: '#',
        },
      },
      {
        icon: 'tabler:swiming',
        callToAction: {
          target: '_blank',
          text: 'Simning',
          href: '#',
        },
      },
      {
        icon: 'tabler:waterpolo',
        callToAction: {
          target: '_blank',
          text: 'Vattenpolo',
          href: '#',
        },
      },
      {
        icon: 'tabler:snowboarding',
        callToAction: {
          target: '_blank',
          text: 'Vindsurfing',
          href: '#',
        },
      },
      {
        icon: 'tabler:kayak',
        callToAction: {
          target: '_blank',
          text: 'Kajak',
          href: '#',
        },
      },
      {
        icon: 'tabler:kayak',
        callToAction: {
          target: '_blank',
          text: 'Rafting',
          href: '#',
        },
      },
      {
        icon: 'tabler:kayak',
        callToAction: {
          target: '_blank',
          text: 'Canyoning',
          href: '#',
        },
      },
      {
        icon: 'tabler:fish',
        callToAction: {
          target: '_blank',
          text: 'Flygfiske',
          href: '#',
        },
      },
    
    ]}
    image={{
      src: '/images/sailing.jpg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Vattensporter</h2>
      <p>
        Lugna vatten gör de närliggande stränderna perfekta för både aktiva och avkopplande simmare. Oavsett om du gillar stand-up paddleboarding, föredrar kajakpaddling eller letar efter ett äventyr till havs, kommer våra vattensportaktiviteter att ge dig energi och hålla dig uppfriskad.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    id="about"
    columns={3}
    classes={{ container: 'sport-icons' }}
    items={[
      {
        icon: 'tabler:trekking',
        callToAction: {
          target: '_blank',
          text: 'Klättring',
          href: '#',
        },
      },
      {
        icon: 'tabler:parachute',
        callToAction: {
          target: '_blank',
          text: 'Paragliding',
          href: '#',
        },
      },
      {
        icon: 'tabler:line',
        callToAction: {
          target: '_blank',
          text: 'Zipline',
          href: '#',
        },
      },
      {
        icon: 'tabler:walk',
        callToAction: {
          target: '_blank',
          text: 'Vandring',
          href: '#',
        },
      },
      {
        icon: 'tabler:trekking',
        callToAction: {
          target: '_blank',
          text: 'Trekking',
          href: '#',
        },
      },
      {
        icon: 'tabler:ski-jumping',
        callToAction: {
          target: '_blank',
          text: 'Skidåkning',
          href: '#',
        },
      },
    ]}
    image={{
      src: '/images/klättring.jpg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Klättring & Vandring</h2>
      <p>
        Upptäckt den omtalande vandringsstigen som har rankats som en av världens bästa destinationer – Via Dinarica!
      </p>
      <br />
      <p>
        Vill du vandra längs denna imponerande vandrings- och trekkingled, som förbinder de naturliga och kulturella sevärdheterna i Dinariderna? Kom till Montenegro!
      </p>
      <br />
      <p>
        Eller varför inte boka en skidsemester i den  oupptäckta Kolašin.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Aktuella kampanjer / Erbjudanden för sportresor -->
  <section id="kampanjer" class="relative mx-auto max-w-7xl px-4 md:px-6 lg:px-8 mt-8 md:mt-20">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-[11px] tracking-[0.15em] font-semibold text-amber-600 mb-3 uppercase">Aktuella kampanjer</p>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">Sportresor för alla årstider</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg">
        Exklusivt utvalda träningsanläggningar & upplevelser med tidsbegränsade rabatter. Perfekt för lag och grupper som vill kombinera kvalitet, klimat och professionella faciliteter.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:gap-10 md:grid-cols-2 xl:grid-cols-3">
      <!-- Card 1: Höstcamp -->
      <div class="rounded-2xl overflow-hidden bg-white ring-1 ring-slate-200 shadow-sm">
        <div class="aspect-[16/10] w-full overflow-hidden bg-slate-100">
          <img src="/images/yoga.jpg" alt="Yoga vid havet under höstcamp" loading="lazy" class="h-full w-full object-cover"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-slate-900">Höstcamp: Yoga & Återhämtning</h3>
          <p class="mt-1 text-sm text-slate-500">Luštica Bay, Montenegro</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>7 dagars yogaprogram</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Meditation vid havet</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Hälsosam mat</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Spa-behandlingar</li>
          </ul>
          <div class="mt-6">
            <a href="/resor/sportresor/hostcamp" class="inline-flex w-full items-center justify-center rounded bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 text-sm font-semibold">Läs mer</a>
          </div>
        </div>
      </div>

      <!-- Card 2: Klättring & Vandring -->
      <div class="rounded-2xl overflow-hidden bg-white ring-1 ring-slate-200 shadow-sm">
        <div class="aspect-[16/10] w-full overflow-hidden bg-slate-100">
          <img src="/images/klättring.jpg" alt="Höstlig vandring i bergen" loading="lazy" class="h-full w-full object-cover"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-slate-900">Klättring & Vandring i Höst</h3>
          <p class="mt-1 text-sm text-slate-500">Durmitor & Luštica, Montenegro</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Guidad klättring</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Vandringsturer</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Camping i naturen</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Fotograferingssafari</li>
          </ul>
          <div class="mt-6">
            <a href="/resor/sportresor/klattring-vandring-host" class="inline-flex w-full items-center justify-center rounded bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 text-sm font-semibold">Läs mer</a>
          </div>
        </div>
      </div>

      <!-- Card 3: Gruppaktivitet vid Havet -->
      <div class="rounded-2xl overflow-hidden bg-white ring-1 ring-slate-200 shadow-sm">
        <div class="aspect-[16/10] w-full overflow-hidden bg-slate-100">
          <img src="/images/dipovi.jpg" alt="Gruppaktivitet och gemenskap vid havet" loading="lazy" class="h-full w-full object-cover"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-slate-900">Gruppaktivitet vid havet</h3>
          <p class="mt-1 text-sm text-slate-500">Budva & Kotorbukten, Montenegro</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Teambuilding aktiviteter</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Vattensporter</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>BBQ på stranden</li>
            <li class="flex gap-2"><svg class="w-4 h-4 text-green-600 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>Båttur i bukten</li>
          </ul>
          <div class="mt-6">
            <a href="/resor/sportresor/gruppaktivitet" class="inline-flex w-full items-center justify-center rounded bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 text-sm font-semibold">Läs mer</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vandringsleder (custom stacked cards to match screenshot) -->
  <section class="relative mx-auto max-w-4xl px-4 md:px-6 lg:px-8 py-12 md:py-16">
    <h2 class="text-center text-2xl md:text-3xl font-bold text-slate-900">Fem bästa vandringsleder på Luštica</h2>
    <div class="mt-8 space-y-5">
      {[
        { title: 'GORNJI KLINCI – OBOSNIK', length: '4.1 km', time: '1:20', exp: 'Högsta toppen av Luštica halvön' },
        { title: 'RADOVIĆI – BABUNCI – TIĆI ŽANJICE', length: '12.3 km', time: '3:15', exp: 'Historisk vandringsled, olivlundar, Žanjice-stranden' },
        { title: 'KRAŠIĆI – Mr. KRAŠIĆI – GOŠIĆI', length: '3.7 km', time: '1:45', exp: 'Den gamla byn Krašići, gamla gångstigen, den stora gamla cisternen och S:t Nikolaus kyrkan.' },
        { title: 'SOLILA – GRABOVAC', length: '4.2 km', time: '1:30', exp: 'Tivat Solia, österrikisk-ungerska fästning Grabovac' },
        { title: 'LUŠTICA GOLF AREA', length: '6 km', time: '1:20', exp: 'Magnifik utsikt över Kotorbukten' },
      ].map((it) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm">
          <div class="text-sm md:text-base font-semibold tracking-wide text-slate-900">{it.title}</div>
          <div class="mt-2 text-xs md:text-sm text-slate-600">
            <span>Längd: {it.length}</span>
            <span class="mx-2">|</span>
            <span>Tid: {it.time}</span>
          </div>
          <div class="mt-2 text-xs md:text-sm text-slate-600">
            <span class="font-semibold text-slate-700">Upplev:</span> {it.exp}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA band to match screenshot -->
  <section class="mt-16 md:mt-24 bg-slate-100">
    <div class="max-w-4xl mx-auto px-4 py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900">Välj mellan redan färdiga resepaket eller kontakta oss för en skräddarsydd upplevelse!</h2>
      <p class="mt-3 text-sm md:text-base text-slate-600">Låt oss hjälpa dig att skapa en oförglömlig resa!</p>
      <div class="mt-6 flex items-center justify-center gap-4">
        <a href="/contact" class="inline-flex items-center justify-center rounded bg-slate-900 text-white px-6 py-3 text-sm font-semibold hover:bg-slate-800">Kontakta oss</a>
        <a href="/boka" class="inline-flex items-center justify-center rounded bg-white text-slate-900 border border-slate-300 px-6 py-3 text-sm font-semibold hover:bg-slate-50">Resepaket</a>
      </div>
    </div>
  </section>
</Layout>
<style is:global>
  /* Force 3-column icon grid on mobile for sport sections */
  @media (max-width: 639px) {
    .sport-icons .grid.mx-auto { 
      /* Use 2 columns on very small screens to avoid cramping */
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 1rem 1rem;
    }
    .sport-icons .flex.flex-row.max-w-md { flex-direction: column; align-items: center; text-align: center; }
    .sport-icons .flex.flex-row.max-w-md h3 { font-size: 0.75rem; line-height: 1.05; }
    .sport-icons .flex.flex-row.max-w-md p { display: none; }

    /* Ensure text stacks above image and avoid overlap on mobile */
    .sport-icons .md\:flex > :first-child { position: relative; z-index: 10; }
    .sport-icons .md\:flex > :last-child { position: relative; z-index: 0; margin-top: 1rem; }
    .sport-icons img { display: block; max-width: 100%; height: auto; }
  }

  /* Prevent icon/text overlap in sport icon lists (all viewports) */
  .sport-icons .flex.flex-row.max-w-md { align-items: center; gap: 0.5rem; }
  .sport-icons .flex.flex-row.max-w-md > div:first-child { flex: 0 0 2rem; display: flex; justify-content: center; }
  .sport-icons .flex.flex-row.max-w-md svg { display: block; }
  .sport-icons .flex.flex-row.max-w-md h3,
  .sport-icons .flex.flex-row.max-w-md p { margin-left: 0; }
</style>