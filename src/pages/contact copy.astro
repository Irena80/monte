---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Kontakta oss | MediteranoBay',
  description: 'Kontakta MediteranoBay för att begära offert, boka möte eller ställa frågor om våra företags- och gruppresor till Montenegro.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 px-4 max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold text-center mb-6">📩 Kontakta oss</h1>
    <p class="text-center text-lg mb-10">
      Har du en idé, ett team eller ett syfte med resan? <br />Låt oss hjälpa dig skapa något minnesvärt.
    </p>

    <form 
      action="https://formspree.io/f/YOUR_FORM_ID" 
      method="POST"
      class="space-y-6 bg-white p-6 rounded-xl shadow-lg"
    >
      <div>
        <label for="namn" class="block font-medium text-gray-700">Namn *</label>
        <input type="text" id="namn" name="namn" required class="w-full mt-1 px-4 py-2 border rounded-md" />
      </div>

      <div>
        <label for="företag" class="block font-medium text-gray-700">Företag / Grupp</label>
        <input type="text" id="företag" name="företag" class="w-full mt-1 px-4 py-2 border rounded-md" />
      </div>

      <div>
        <label for="email" class="block font-medium text-gray-700">E-post *</label>
        <input type="email" id="email" name="email" required class="w-full mt-1 px-4 py-2 border rounded-md" />
      </div>

      <div>
        <label for="meddelande" class="block font-medium text-gray-700">Vad vill ni få hjälp med?</label>
        <textarea id="meddelande" name="meddelande" rows="5" class="w-full mt-1 px-4 py-2 border rounded-md"></textarea>
      </div>

      <button type="submit" class="w-full bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition">
        Skicka förfrågan
      </button>
    </form>

    <div class="mt-10 text-center text-sm text-gray-500">
      Eller mejla oss direkt: <a href="mailto:hello@mediteranobay.com" class="text-blue-600 underline">hello@mediteranobay.com</a>
    </div>
  </section>
</Layout>