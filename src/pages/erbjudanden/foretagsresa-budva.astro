---
import Layout from '../../layouts/PageLayout.astro';
import CTAButton from '../../components/ui/CTAButton.astro';

const metadata = {
  title: 'Företagsresa till Budva – Sol, konferens och nattliv',
  description: 'Företagsresa till Budva med 5★ hotell, moderna möteslokaler, stränder och gamla stan. Teambuilding: båtturer, vandring, vinprovning.',
  image: '/images/hotel-budva.jpg',
  ogImage: '/images/hotel-budva.jpg'
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 pt-16 md:pt-24">
      <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Paket 2</p>
  <h1 class="mt-3 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight text-center">Företagsresa till Budva – Sol, konferens och nattliv</h1>
  <p class="mt-6 text-base md:text-lg max-w-none text-slate-600 dark:text-slate-300 leading-relaxed">Budva är Montenegros mest kända kuststad. MediteranoBay kombinerar moderna konferenshotell med stadens strandliv och rika kulturarv.</p>
    </div>
    <div class="max-w-6xl mx-auto px-4 mt-6">
      <img src="/images/budva1.jpg" alt="Budva" class="w-full aspect-[16/7] object-cover rounded-xl shadow" loading="eager" decoding="async" />
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-12">
      <div class="md:col-span-5 space-y-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Innehåll</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>5-stjärniga hotell med moderna möteslokaler</li>
            <li>Direkttransfer från Tivat (30 min)</li>
            <li>Stränder, gamla stan och livligt nattliv</li>
            <li>Teambuilding: båtturer, bergsvandring, vinprovning</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Program (3 dagar)</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>Dag 1: Ankomst, check-in, stadsvandring i Budvas gamla stad</li>
            <li>Dag 2: Konferens + eftermiddag på stranden</li>
            <li>Dag 3: Båttur till Sveti Stefan & vinprovning</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">FAQ</h2>
          <dl class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <div>
              <dt class="font-semibold">Vad kostar resan?</dt>
              <dd>Från 14 500 SEK per person (3 dagar, helpension).</dd>
            </div>
            <div>
              <dt class="font-semibold">Hur tar man sig dit?</dt>
              <dd>Flyg till Tivat eller Podgorica, transfer ordnas.</dd>
            </div>
            <div>
              <dt class="font-semibold">Är Budva bra för större grupper?</dt>
              <dd>Ja, hotellen har kapacitet för 200+ deltagare.</dd>
            </div>
          </dl>
        </div>
        <CTAButton href="/contact" variant="primary">Begär offert på företagsresa till Budva</CTAButton>
      </div>
      <div class="md:col-span-7 space-y-8">
        <img src="/images/Stari grad Budva.jpeg" alt="Budvas gamla stad" class="w-full rounded-xl object-cover shadow" loading="lazy" decoding="async" />
        <img src="/images/mogren.jpg" alt="Mogren strand" class="w-full rounded-xl object-cover shadow" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
</Layout>
