---
import Layout from '../../layouts/PageLayout.astro';
import CTAButton from '../../components/ui/CTAButton.astro';

const metadata = {
  title: 'Teambuilding i Durmitor – Natur och äventyr för företag',
  description: 'Durmitor Nationalpark med rafting, zipline, hiking och lokala lodger. Perfekt för aktiv teambuilding i UNESCO-miljö.',
  image: '/images/durmitor2.jpg',
  ogImage: '/images/durmitor2.jpg'
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 pt-16 md:pt-24">
      <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Paket 3</p>
  <h1 class="mt-3 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight text-center">Teambuilding i Durmitor – Natur och äventyr för företag</h1>
  <p class="mt-6 text-base md:text-lg max-w-none text-slate-600 dark:text-slate-300 leading-relaxed">För företag som vill stärka laget med aktivitet och naturupplevelser. Durmitor Nationalpark erbjuder rafting, bergsvandringar och unika konferensmöjligheter i en UNESCO-skyddad miljö.</p>
    </div>
    <div class="max-w-6xl mx-auto px-4 mt-6">
      <img src="/images/durmitor2.jpg" alt="Durmitor Nationalpark" class="w-full aspect-[16/7] object-cover rounded-xl shadow" loading="eager" decoding="async" />
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-12">
      <div class="md:col-span-5 space-y-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Innehåll</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>Hotell & lodger i nationalparken</li>
            <li>Teambuilding: forsränning, zipline, hiking</li>
            <li>Tara Canyon – Europas djupaste kanjon</li>
            <li>Lokal gastronomi med gårdsproducerad mat</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Program (3 dagar)</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>Dag 1: Ankomst, middag med lokala specialiteter</li>
            <li>Dag 2: Konferens på morgonen + rafting i Tara-floden</li>
            <li>Dag 3: Vandring i bergen + avslutande middag</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">FAQ</h2>
          <dl class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <div>
              <dt class="font-semibold">Vad kostar resan?</dt>
              <dd>Från 10 900 SEK per person (3 dagar, helpension).</dd>
            </div>
            <div>
              <dt class="font-semibold">Hur tar man sig dit?</dt>
              <dd>Transfer från Podgorica (2,5 tim) ingår.</dd>
            </div>
            <div>
              <dt class="font-semibold">Passar det alla åldrar?</dt>
              <dd>Ja, aktiviteter anpassas efter gruppens nivå.</dd>
            </div>
          </dl>
        </div>
        <CTAButton href="/contact" variant="primary">Begär offert på teambuilding i Durmitor</CTAButton>
      </div>
      <div class="md:col-span-7 space-y-8">
        <img src="/images/tara4.jpg" alt="Tara Canyon" class="w-full rounded-xl object-cover shadow" loading="lazy" decoding="async" />
        <img src="/images/zipline.webp" alt="Zipline Tara" class="w-full rounded-xl object-cover shadow" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
</Layout>
