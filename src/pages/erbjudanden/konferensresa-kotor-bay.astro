---
import Layout from '~/layouts/PageLayout.astro';
import CTAButton from '~/components/ui/CTAButton.astro';

const metadata = {
  title: 'Konferensresa till Kotor Bay – Företagsresor vid Adriatiska havet',
  description: 'Företagsresor till Kotor Bay med 4★ hotell, konferensrum med havsutsikt och aktiviteter som segling, vinprovning och vandring.',
  image: '/images/kotorbukten.jpg',
  ogImage: '/images/kotorbukten.jpg'
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 pt-16 md:pt-24">
      <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Paket 1</p>
  <h1 class="mt-3 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight text-center">Konferensresa till Kotor</h1>
  <p class="mt-6 text-base md:text-lg max-w-none text-slate-600 dark:text-slate-300 leading-relaxed">Upplev Adriatiska havet. Här får ni en unik kombination av havsnära konferensmöjligheter, historisk stadsmiljö och inspirerande aktiviteter.</p>
    </div>
    <div class="max-w-6xl mx-auto px-4 mt-6">
      <img src="/images/boka-bay-lustica.jpg" alt="Kotor Bay" class="w-full aspect-[16/7] object-cover rounded-xl shadow" loading="eager" decoding="async" />
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-12">
      <div class="md:col-span-5 space-y-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Innehåll</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>4-stjärnigt hotell med konferensrum och havsutsikt</li>
            <li>20 minuter från Tivat flygplats</li>
            <li>Teambuilding: segling, vinprovning, vandring i bergen</li>
            <li>Utflykter till UNESCO-staden Kotor och pittoreska Perast</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Program (3 dagar)</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            <li>Dag 1: Ankomst, transfer, välkomstmiddag vid vattnet</li>
            <li>Dag 2: Konferens, eftermiddagstur i Kotor stad</li>
            <li>Dag 3: Segling & teambuilding, avskedsmiddag</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">FAQ</h2>
          <dl class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <div>
              <dt class="font-semibold">Vad kostar resan?</dt>
              <dd>Från 12 500 SEK per person (3 dagar, helpension).</dd>
            </div>
            <div>
              <dt class="font-semibold">Hur tar man sig dit?</dt>
              <dd>Närmaste flygplatser: Tivat (20 min), Podgorica(90 min).</dd>
            </div>
            <div>
              <dt class="font-semibold">Kan vi anpassa programmet?</dt>
              <dd>Ja, alla resor skräddarsys.</dd>
            </div>
          </dl>
        </div>
        <CTAButton href="/contact" variant="primary">Begär offert på konferensresa till Kotor Bay</CTAButton>
      </div>
      <div class="md:col-span-7 space-y-8">
        <img src="/images/drvored.png" alt="Kotor stad" class="w-full rounded-xl object-cover shadow" loading="lazy" decoding="async" />
        <img src="/images/Kotor City.jpeg" alt="Perast" class="w-full rounded-xl object-cover shadow" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
</Layout>
