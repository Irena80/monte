---
import Layout from '~/layouts/PageLayout.astro';
import CTAButton from '~/components/ui/CTAButton.astro';

const metadata = {
  title: 'Jullov i Tivat – Grupp & företagsresa',
  description: 'Fira jullovet vid Adriatiska havet med bas i Tivat. Boende på Hotel Astoria och skräddarsytt program för avkoppling, kultur och aktiviteter.',
  image: '/images/Astoria%20.webp',
  ogImage: '/images/Astoria%20.webp'
};

const hotel = {
  name: 'Hotel Astoria',
  location: 'Tivat, Montenegro',
  nights: 4,
  roomType: 'Dubbelrum (del i dubbel) – uppgradering möjlig',
  board: 'Frukostbuffé',
  highlights: [
    'Centralt läge nära Porto Montenegro',
    'Stilfull atmosfär & närhet till havet',
    'Perfekt utgångspunkt för vinterutflykter'
  ]
};

const includedActivities = [
  { title: 'Välkomstkväll', desc: 'Lokala smaker och genomgång av vistelsens program.' },
  { title: 'Utflykt till Kotor', desc: 'UNESCO–stad med julstämning och historiska miljöer.' },
  { title: 'Båt eller kustpromenad', desc: 'Lugna vinterdagar i bukten – välj tempo efter gruppen.' },
  { title: 'Aktiv förmiddag', desc: 'Lätt vandring på Vrmac eller välgörande wellnesspass.' },
  { title: 'Gastronomisk kväll', desc: 'Fokus på lokala råvaror och regionala viner.' }
];

const addOns = [
  'Dagsutflykt till Lovćen & Njeguši',
  'Vinprovning inland',
  'Zipline vid Kotorbukten (väderberoende)',
  'Heldag med privat båt (väderberoende)',
  'Cykeltur runt Tivatbukten'
];

const flights = [
  { route: 'Stockholm – Tivat (via hub)', approx: 'Från ca 4–5h total restid' },
  { route: 'Göteborg/Köpenhamn – Dubrovnik', approx: 'Direkt 2h 30m + transfer ~45m' },
  { route: 'Köpenhamn – Podgorica', approx: 'Via hub, ca 5h total restid' }
];

const why = [
  'Mild vinter vid kusten – skön paus från nordiskt klimat',
  'Färre besökare ger närhet till sevärdheter och vyer',
  'Flexibla upplägg för grupper som vill kombinera city & natur',
  'Snabb offert, tydlig logistik och lokal support'
];
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 pt-16 pb-10 md:pt-24 md:pb-16">
      <p class="text-sm uppercase tracking-wide text-amber-600 font-semibold">Erbjudande</p>
      <h1 class="mt-3 text-3xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight">Jullov i Tivat</h1>
      <p class="mt-6 text-base md:text-lg max-w-2xl text-slate-600 dark:text-slate-300 leading-relaxed">Byt vintermörker mot Adriatiskt ljus. Bo bekvämt i Tivat och välj mellan stillsam avkoppling, kustpromenader och korta utflykter till kulturstäder som Kotor och Perast.</p>
    </div>
    <div class="max-w-6xl mx-auto px-4">
      <img src="/images/Astoria%20.webp" alt="Hotel Astoria i Tivat" class="w-full aspect-[16/7] object-cover rounded-xl shadow" loading="eager" decoding="async" />
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-12">
      <div class="md:col-span-5 space-y-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Boende</h2>
          <div class="p-5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/40 backdrop-blur-sm">
            <h3 class="text-lg font-semibold">{hotel.name}</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">{hotel.location}</p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
              <li><strong>Nätter:</strong> {hotel.nights}</li>
              <li><strong>Rum:</strong> {hotel.roomType}</li>
              <li><strong>Måltider:</strong> {hotel.board}</li>
            </ul>
            <ul class="mt-4 space-y-1 text-sm text-slate-600 dark:text-slate-300">
              {hotel.highlights.map(h => <li>• {h}</li>)}
            </ul>
          </div>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Varför nu?</h2>
          <ul class="space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            {why.map(w => <li class="flex gap-2"><span class="text-amber-600">●</span><span>{w}</span></li>)}
          </ul>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Flyg & rutter</h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
            {flights.map(f => <li><strong>{f.route}</strong> – {f.approx}</li>)}
          </ul>
          <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Exakta flyg & tider bekräftas vid offert. Transfer ordnas enligt behov.</p>
        </div>
      </div>

      <div class="md:col-span-7 space-y-12">
        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Aktiviteter som ingår</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {includedActivities.map(a => (
              <div class="p-5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/40 shadow-sm">
                <h3 class="font-semibold text-slate-900 dark:text-white text-sm mb-1">{a.title}</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{a.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-serif font-medium text-slate-900 dark:text-white mb-4">Populära tillval</h2>
          <ul class="grid sm:grid-cols-2 gap-3 text-sm text-slate-600 dark:text-slate-300">
            {addOns.map(o => <li class="flex gap-2"><span class="text-amber-600">+</span><span>{o}</span></li>)}
          </ul>
        </div>

        <div class="p-6 rounded-xl bg-gradient-to-br from-slate-900 to-slate-700 text-white shadow relative overflow-hidden">
          <div class="relative z-10">
            <h3 class="text-xl font-semibold mb-2">Redo att få offert?</h3>
            <p class="text-sm text-slate-200 leading-relaxed max-w-md mb-4">Skicka era önskemål så återkommer vi inom 24h med tydlig prisbild, förslag och alternativa aktivitetsupplägg för julledigheten.</p>
            <CTAButton href="/kontakt" variant="primary">Kontakta oss</CTAButton>
          </div>
          <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_70%_30%,#ffffff33,transparent_60%)]"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>
