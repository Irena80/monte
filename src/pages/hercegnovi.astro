---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/hercegnovi.astro

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
// Removed Content/TitleBlock to use index-style custom layout





const metadata = {
  title: 'Herceg Novi',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  
  actions={[
    {
      variant: 'primary',
      text: 'Festivaler',
      href: 'https://www.hercegfest.me/en/festivals/',
      target: '_blank',
      icon: 'tabler:sun',
    },
    { text: 'Virtuell promenad', icon:'tabler:stairs', href: 'https://virtualtours.virtualno360.hr/F17tWnGjbU/43435577p&348.89h&79.41t' },
  ]}
   
   
  
    
    image={{
      src: '~/assets/images/HN pogled zaliv.jpg',
      alt: 'Caos Image',
    }}
  >
  <Fragment slot="title">
     <span class="hidden sm:inline">Staden som du längtar till</span>  <span

      class="text-blue-900">Herceg Novi</span
    > 
  </Fragment>
    <Fragment slot="subtitle">
      Vid en av världens vackraste vikar, Kotorbukten, hittar du Herceg Novi! Solens, grönskans och festivalernas stad. 
    </Fragment>

  
  </Hero>

  

  <!-- Stats Widget ****************** -->

  <Stats
    title="Snabb statistik"
    stats={[
      { title: 'Soldagar om året', amount: '250+' },
      { title: 'Trappsteg', amount: '100 001' },
      { title: 'Kartlagda stigar för aktiv semester', amount: '250 km' },
      { title: 'Strandpromenad' , amount: '6 km' },
      { title: 'Antal stränder' , amount: '70+' },
      { title: 'Kust' , amount: '18 km' },
     
    ]}
  />

  <!-- Intro-block: stor rubrik + text (vänster) och stor bild (höger) -->
  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12 mt-8 md:mt-12 lg:mt-16">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <!-- Textkolumn -->
      <div class="order-2 md:order-1">
        <h2 class="font-serif uppercase text-slate-900 dark:text-white tracking-tight leading-[0.95] text-[clamp(2.25rem,6vw,5.5rem)]">
          Solens och grönskans stad
        </h2>
        <p class="mt-6 text-gray-700 text-base md:text-lg">
          Medelhavsklimat, parker och blå vyer. Herceg Novi sägs vara en av Adriatiska havets vackraste kuststäder – en urban oas av grönska och blå vyer, idealisk för både grupp- och konferensresor.
        </p>
        <p class="mt-4 text-gray-700 text-base md:text-lg">
          Stränder, trädgårdar och ett starkt gastronomiskt utbud gör destinationen enkel att anpassa efter syfte och grupp. Med genomtänkt innehåll och lokal närvaro skapar vi minnesvärda upplevelser.
        </p>
      </div>
      <!-- Bildkolumn -->
      <div class="order-1 md:order-2">
        <img 
          src="/images/hn3.webp"
          alt="Herceg Novi – solens och grönskans stad" 
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
          class="rounded-2xl w-full h-64 sm:h-80 md:h-[560px] lg:h-[680px] object-cover"
        />
      </div>
    </div>
  </div>

  
  <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-5xl mb-2 text-center mt-12 md:mt-16">Saker att göra i Herceg Novi</h2>
  
  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-10">
    <!-- Block 1: Stadsvandring i gamla stan -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <img 
        src="/images/hn.jpg"
        alt="Stadsvandring i gamla stan" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover"
      />
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="bg-blue-900 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M5 7v10a2 2 0 002 2h10a2 2 0 002-2V7" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Stadsvandring i gamla stan</h3>
        </div>
        <p class="text-gray-600">Medeltida gränder & pampiga torg</p>
        <p class="text-gray-700">
          Upptäck Herceg Novis ringmur, strosa på kullerstensgator och genom vackra torg kantade av palats, kyrkor och kloster. Perfekt halvdag för gruppen att landa och lära känna staden.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Guidad tur med lokala highlights</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Caféstopp på charmiga uteserveringar</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Flexibel längd och tempo</span></li>
        </ul>
        
      </div>
    </div>

    <!-- Block 2: Segling i fjorden -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <div class="space-y-4 order-2 md:order-1">
        <div class="flex items-center gap-2">
          <div class="bg-cyan-500 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 18l6-6 4 4 8-8" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Segling genom Europas sydligaste fjord</h3>
        </div>
        <p class="text-gray-600">Båtturer, bukter & badstopp</p>
        <p class="text-gray-700">
          Glid längs kusten till gömda stränder och fiskebyar. Simma i Blue Cave, besök ön Our Lady of the Rock och njut av vyerna över Kotorbukten.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Privat båt eller större utflykt</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Badstopp och lunch i Perast</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Anpassas efter väder & grupp</span></li>
        </ul>
        
      </div>
      <img 
        src="/images/jedrenje3.webp"
        alt="Segling genom fjorden" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover order-1 md:order-2"
      />
    </div>
  </div>
  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-4 md:py-8 lg:py-4">
    <!-- Block 3: Middag med havsutsikt -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <img 
        src="/images/verige.jpg"
        alt="Middag med havsutsikt" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover"
      />
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="bg-amber-500 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3v5h6v-5c0-1.657-1.343-3-3-3z" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Middag med havsutsikt</h3>
        </div>
        <p class="text-gray-600">Takbarer, terrasser & solnedgång</p>
        <p class="text-gray-700">
          Avsluta dagen på en takterrass med panoramavy över bukten. Cocktailmingel i solnedgången följt av middag under bar himmel – vi ordnar detaljerna.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Förslag på restauranger & menyer</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>DJ eller livemusik på begäran</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Gruppstorlek från liten till stor</span></li>
        </ul>
        
      </div>
    </div>

    <!-- Block 4: Roadtrip till Orjen -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <div class="space-y-4 order-2 md:order-1">
        <div class="flex items-center gap-2">
          <div class="bg-green-600 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l6 6-6 6M21 7l-6 6 6 6" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Roadtrip till Orjen</h3>
        </div>
        <p class="text-gray-600">Vandring & MTB i naturpark</p>
        <p class="text-gray-700">
          Upplev serpentinvägar, storslagna vyer och aktiva äventyr. Orjen bjuder på leder för både vandring och mountainbike i varierad terräng.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Rutter för olika nivåer</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Möjlighet till guide & transfer</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Fantastiska fotostopp</span></li>
        </ul>
        
      </div>
      <img 
        src="/images/orjen1.png"
        alt="Roadtrip till Orjen" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover order-1 md:order-2"
      />
    </div>

    <!-- Block 5: Besök vingården Savina Castle -->
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <img 
        src="/images/savina.jpg"
        alt="Savina vingård" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover"
      />
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="bg-rose-500 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A4 4 0 006 12.03V21h12v-8a4 4 0 00-3.248-3.832z" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Besök vingården Savina Castle</h3>
        </div>
        <p class="text-gray-600">Vin, utsikt & berättelser</p>
        <p class="text-gray-700">
          Rundtur och provning med fokus på lokala druvor. Fantastisk miljö med utsikt över Herceg Novi – en perfekt eftermiddag för gruppen.
        </p>
        <ul class="space-y-2">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Guidning av vingården</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Matchande smårätter</span></li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span><span>Nära stad & kust</span></li>
        </ul>
        
      </div>
    </div>
  </div>


    <!-- Utvalda aktiviteter – erbjudanden-stil kort -->
  <section class="relative mx-auto max-w-7xl px-4 md:px-6 lg:px-8 mt-8 md:mt-16">
    <div class="text-center">
      <p class="text-[11px] tracking-[0.15em] font-semibold text-amber-600 uppercase">Utvalda aktiviteter</p>
      <h2 class="mt-2 text-3xl md:text-5xl font-semibold md:font-bold tracking-tight text-slate-900 dark:text-white leading-tight"> Utvalda aktiviteter i Herceg Novi</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg">Här delar vi med oss av flera tips på aktiviteter i Montenegro</p>
    </div>
    <div class="mt-10 grid gap-6 sm:gap-8 md:grid-cols-2 xl:grid-cols-3">
      <!-- Overlay Card 1 -->
      <a href="/utflykter" class="group relative block rounded-2xl overflow-hidden bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600">
        <img src="/images/HNkula.webp" alt="Fästningarna i Herceg Novi" loading="lazy" decoding="async" class="h-72 sm:h-80 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
          <div>
            <h3 class="text-white text-xl sm:text-2xl font-extrabold leading-tight drop-shadow">Fästningarna i Herceg Novi</h3>
            <p class="text-white/90 text-sm sm:text-base">Herceg Novi, Montenegro</p>
          </div>
          
        </div>
      </a>

      <!-- Overlay Card 2 -->
      <a href="/kusten" class="group relative block rounded-2xl overflow-hidden bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600">
        <img src="/images/perast2.webp" alt="Perast – Boka Kotors pärla" loading="lazy" decoding="async" class="h-72 sm:h-80 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
          <div>
            <h3 class="text-white text-xl sm:text-2xl font-extrabold leading-tight drop-shadow">Bokas gömda juvel– Perast</h3>
            <p class="text-white/90 text-sm sm:text-base">Perast, Montenegro</p>
          </div>
          
        </div>
      </a>

      <!-- Overlay Card 3 -->
      <a href="/kusten" class="group relative block rounded-2xl overflow-hidden bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600">
        <img src="/images/kotor.jpg" alt="Medeltida by i Boka Kotorska" loading="lazy" decoding="async" class="h-72 sm:h-80 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
          <div>
            <h3 class="text-white text-xl sm:text-2xl font-extrabold leading-tight drop-shadow">Vandra genom historien</h3>
            <p class="text-white/90 text-sm sm:text-base">Kotorbukten UNESCO, Montenegro</p>
          </div>
         
        </div>
      </a>
    </div>
  </section>
  
   
<!-- Steps2 Widget ****************** -->

<Steps2
  title="Äventyret startar här"
  subtitle="Välkommen till Herceg Novi, där Adriatiska havet smälter samman med riklig naturgrönska. Mellan historiska fästningar och livliga gränder gömmer sig en stad som förtrollar med charm och historia."
  isReversed={true}
  callToAction={{
    text: 'Kontakta oss',
    href: 'contact',
  }}
   
  items={[
    {
      title: 'Flyg',
      description: 'Direktflyg finns från mars till november till Dubrovnik eller Tivat och resan tar ca 2,5 tim. Alternativ flyg med mellanlandning från  Skandinavien till huvudstaden Podgorica i Montenegro går dagligen. Flygresan tar ca 4-5 tim. <br> Är ni en större företagsgrupp på ca 100 personer och uppåt, kan vi hjälpa Er att privatchartra Ert egna flyg, som avgår direkt från er närmaste avrese-ort till Tivat i Montenegro.',
      icon: 'tabler:plane',
    },
    {
      title: 'Transfertider',
      description:
        'Från Tivats flygplats till Herceg Novi är det ca 15 minuters transfer. Från Dubrovnik är det ca 30 min bilväg.',
      icon: 'tabler:message-star',
    },
    {
      title: 'Hotell och boende i Montenegro',
      description:
        'I den charmiga orten Herceg Novi finns 4* hotell med utmärkta konferensmöjligheter för grupper upp till flera hundra personer. I närheten ligger resort Porto Novi med 5* hotell.',
      icon: 'tabler:award',
    },
  ]}

/>
</Layout>
