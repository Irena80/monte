---
import Features3 from '~/components/widgets/Features3.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import CTAButton from '~/components/ui/CTAButton.astro';

const metadata = {
  title: 'Om oss – MediteranoBay',
  description: 'Vi skapar aktiva grupp- och företagsresor till Montenegro med lokal expertis, hållbara val och starkt fokus på upplevelser.',
};
---

<Layout metadata={metadata}>
  <!-- Full-bleed hero matching Företagsresor -->
  <section data-section="hero" class="relative w-full h-[70vh] min-h-[560px] overflow-hidden">
    <!-- Background image -->
    <img
      src="/images/Irena.jahta.png"
      alt="Irena på jahta"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/35"></div>
    <!-- Bottom fade to white -->
    <div class="absolute inset-x-0 bottom-0 h-56 sm:h-64 bg-gradient-to-b from-transparent to-white"></div>

    <!-- Centered content -->
    <div class="relative h-full flex items-center justify-center px-6 z-10">
      <div class="w-full max-w-3xl text-center">
        <h1 class="text-white text-[2rem] sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] drop-shadow-[0_6px_22px_rgba(0,0,0,0.55)]">Om MediteranoBay</h1>
        <p class="mt-3 text-white/90 text-[0.95rem] sm:text-base md:text-lg leading-relaxed max-w-xl mx-auto">
          Vi skapar aktiva och meningsfulla grupp- och företagsresor i Montenegro – med lokal närvaro, hållbara val och upplevelser som bygger relationer.
        </p>
        <div class="mt-6 flex items-center justify-center">
          <a href="/contact" class="inline-flex items-center rounded bg-slate-900/90 hover:bg-slate-900 text-white px-5 py-2.5 text-sm font-semibold shadow focus:outline-none focus:ring-2 focus:ring-white/40">
            Kontakta oss
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Features3 Widget ************** -->

  <div data-section="ambition" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <Features3
      title="Vår ambition"
      subtitle="Vi erbjuder aktiva upplevelseresor för grupper och företag till Montenegro – landet där kusten och bergen möts. Vårt mål är att skapa unika reseupplägg som kombinerar den dramatiska naturen, den orörda vildmarken och den historiska kusten – allt inom nära räckhåll."
    />
  </div>
  <!-- Sea Image Divider (larger for visibility) -->
  <section data-section="divider-sea" class="relative w-full h-72 sm:h-96 lg:h-[520px] overflow-hidden">
    <picture class="absolute inset-0 w-full h-full">
      <source srcset="/images/jedrenje3.webp" type="image/webp" />
      <img
        src="/images/jedrenje3.webp"
        alt="Segelbåt på klart vatten i Montenegro"
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-white via-white/5 to-transparent"></div>
  </section>
  

  <!-- Steps2 Widget ****************** -->

  <div data-section="values" class="bg-gradient-to-b from-white to-slate-50/60 border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <Steps2
        title="Våra värderingar"
        subtitle="Vi vill förena Skandinavien med Montenegro – genom genuina upplevelser som bygger relationer och skapar minnen."
        isReversed={true}
        callToAction={{ text: 'Se utbud', href: '/boka' }}
        items={[
          {
            title: 'Hållbart resande',
            description: 'Vi prioriterar lokala partners så att värdet stannar i regionen och bidrar till positiv utveckling. Vi kan även koppla ert hållbarhets- eller ESG-arbete till lokala initiativ.',
            icon: 'tabler:globe',
          },
          {
            title: 'Lokala leverantörer',
            description: 'Familjeägda hotell, närproducerad mat och lokala transporter – vi väljer omsorgsfullt för att stärka kvalitet och autenticitet.',
            icon: 'tabler:award',
          },
          {
            title: 'Personlig expertis',
            description: 'Vi vistas själva regelbundet i Montenegro och uppdaterar ständigt vårt urval av aktiviteter och platser – för att varje resa ska kännas genomtänkt och unik.',
            icon: 'tabler:message-star',
          },
        ]}
      />
    </div>
  </div>


  <!-- Features2 Widget ************** -->

  <div data-section="cta-final" class="py-20 sm:py-28 relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.06),transparent_60%)]"></div>
    <div class="absolute inset-0 -z-20 bg-gradient-to-br from-[#0F2742] via-[#193455] to-[#0E2034]"></div>
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">Redo att planera nästa resa?</h2>
      <p class="mt-5 text-white/85 max-w-2xl mx-auto text-base md:text-lg leading-relaxed">Berätta kort om era mål så återkommer vi med ett första förslag inom 24 timmar.</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center items-center">
  <CTAButton href="/contact" variant="accent" widthClass="w-[170px]">Begär offert</CTAButton>

      </div>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-6 text-[13px] md:text-sm text-slate-200">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2 5l8 4 12-6-8 14-4-6-8 4z"/></svg>
          Svar inom 24h
        </div>
        <div class="hidden sm:block h-4 w-px bg-slate-500/40"></div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 4h10M6 8h12M6 12h12M6 16h8"/></svg>
          Kostnadsfri offert
        </div>
      </div>
    </div>
  </div>
 
</Layout>
