---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Belgrad – hotell, konferenser & aktiviteter',
  description: 'Din kompletta guide till Belgrad för företag och grupper: hotell, konferenser, aktiviteter och reseupplägg.',
};
---

<Layout metadata={metadata}>
  <!-- Custom Hero (matchar skärmdumpen) -->
  <section id="home" class="relative isolate">
    <img src="/images/bgbest.jpg" alt="Belgrad vid floden i skymning" class="h-[70vh] sm:h-[76vh] lg:h-[82vh] w-full object-cover object-center" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-slate-900/65"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-white text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight">
          Resa till Belgrad –<br class="hidden sm:block" />
          <span>hotell, konferenser & aktiviteter</span>
        </h1>
        <p class="mt-4 max-w-2xl mx-auto text-white/90 text-base sm:text-lg leading-relaxed">
          Din kompletta guide till Belgrad, för både företag och grupper.
        </p>
        <a href="/contact?utm_source=belgrad&utm_medium=hero_cta" class="mt-6 inline-flex rounded-xl bg-amber-400 text-black px-6 py-3 font-semibold shadow hover:bg-amber-300">
          Planera din gruppresa
        </a>
        
      </div>
    </div>
  </section>


    
  
  

  <!-- Hotels + CTA inline section (like screenshot) -->
  <section id="hotels" class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
  <h2 class="text-3xl md:text-5xl font-serif font-medium text-slate-900 text-center reveal-on-scroll">De bästa hotellen i Belgrad</h2>

      <div class="mt-8 grid lg:grid-cols-3 gap-6">
        <!-- Left: two hotel cards -->
        <div class="lg:col-span-2 grid md:grid-cols-2 gap-6">
          <!-- Metropol Palace -->
          <article class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm reveal-on-scroll">
            <img src="/images/majestic.jpg" alt="Metropol Palace" class="w-full h-56 object-cover" loading="lazy" decoding="async" />
            <div class="p-6">
              <h3 class="text-xl font-extrabold text-slate-900">Metropol Palace</h3>
              <p class="mt-2 text-slate-600">Femstjärnig klassiker vid Tašmajdanparken.</p>
              <a href="/contact?utm_source=belgrad&utm_medium=cta&utm_campaign=hotell_metropol" class="mt-4 inline-block text-sm font-semibold text-slate-800 hover:underline">Se mer »</a>
            </div>
          </article>
          <!-- Hyatt Regency -->
          <article class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm reveal-on-scroll">
            <img src="/images/serbien-belgrad.jpeg" alt="Hyatt Regency Belgrade" class="w-full h-56 object-cover" loading="lazy" decoding="async" />
            <div class="p-6">
              <h3 class="text-xl font-extrabold text-slate-900">Hyatt Regency</h3>
              <p class="mt-2 text-slate-600">Modern 5★ standard – nära affärsdistriktet.</p>
              <a href="/contact?utm_source=belgrad&utm_medium=cta&utm_campaign=hotell_hyatt" class="mt-4 inline-block text-sm font-semibold text-slate-800 hover:underline">Se mer »</a>
            </div>
          </article>
        </div>

        <!-- Right: CTA box -->
  <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-6 flex flex-col justify-center shadow-sm reveal-on-scroll">
          <h3 class="text-xl font-bold text-slate-900">Behöver du boka
            <span class="block">för 20+ personer?</span>
          </h3>
          <a href="/contact?utm_source=belgrad&utm_medium=cta&utm_campaign=hotell_20plus" class="mt-6 inline-flex items-center justify-center rounded-xl bg-amber-400 text-black px-6 py-3 font-semibold shadow hover:bg-amber-300">Begär offert</a>
        </aside>
      </div>

      <!-- Feature icons row -->
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center reveal-on-scroll">
          <div class="mx-auto w-16 h-16 rounded-full bg-slate-900 text-white flex items-center justify-center">
            <Icon name="tabler:music" class="w-8 h-8" />
          </div>
          <p class="mt-3 font-semibold text-slate-900">Nattliv vid floden</p>
        </div>
        <div class="text-center reveal-on-scroll">
          <div class="mx-auto w-16 h-16 rounded-full bg-slate-900 text-white flex items-center justify-center">
            <Icon name="tabler:building-castle" class="w-8 h-8" />
          </div>
          <p class="mt-3 font-semibold text-slate-900">Kalemegdan fästning</p>
        </div>
        <div class="text-center reveal-on-scroll">
          <div class="mx-auto w-16 h-16 rounded-full bg-amber-400 text-slate-900 flex items-center justify-center">
            <Icon name="tabler:glass" class="w-8 h-8" />
          </div>
          <p class="mt-3 font-semibold text-slate-900">Vintur & kafékultur</p>
        </div>
        <div class="text-center reveal-on-scroll">
          <div class="mx-auto w-16 h-16 rounded-full bg-slate-900 text-white flex items-center justify-center">
            <Icon name="tabler:sailboat" class="w-8 h-8" />
          </div>
          <p class="mt-3 font-semibold text-slate-900">Flodkryssning</p>
        </div>
      </div>



    
    </div>
  </section>

  <!-- Aktuella paket (priskort) -->
  <section id="paket" class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-6xl font-extrabold text-slate-900 text-center reveal-on-scroll">Utvalda paketerbjudanden</h2>
      <p class="mt-4 text-center text-lg md:text-2xl text-slate-500 reveal-on-scroll">Skräddarsydda paket för den perfekta Belgrad‑upplevelsen</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Weekendpaket -->
        <article class="relative rounded-2xl border border-slate-200 bg-slate-50 shadow-sm reveal-on-scroll">
          <div class="p-6 md:p-8">
            <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center">
              <Icon name="tabler:user" class="w-6 h-6" />
            </div>
            <h3 class="mt-4 text-xl font-extrabold text-slate-900">Weekendpaket</h3>
            <p class="text-slate-600">3 dagar / 2 nätter</p>
            <div class="mt-6">
              <div class="text-slate-900">
                <p class="text-sm uppercase tracking-wide text-slate-500">från</p>
                <p class="text-3xl md:text-4xl font-extrabold">4.995 kr</p>
                <p class="text-xs text-slate-500">per person</p>
              </div>
            </div>
            <ul class="mt-6 space-y-3 text-slate-700">
              {[
                '2 nätter på 4‑stjärnigt hotell',
                'Guidad stadstur på svenska',
                'Besök på Kalemegdan fästning',
                'Flodkryssning på Donau',
                'Välkomstmiddag med lokal mat',
              ].map((item) => (
                <li class="flex gap-3"><Icon name="tabler:circle-check" class="w-5 h-5 text-emerald-600" /> <span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="px-6 md:px-8 pb-6">
            <a href="/paket/weekend" class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 text-white font-semibold py-3 hover:bg-slate-800">Boka nu</a>
          </div>
        </article>

        <!-- Konferenspaket (featured) -->
  <article class="relative rounded-2xl border border-amber-200 bg-amber-50 shadow-sm reveal-on-scroll">
          <span class="absolute -top-3 right-4 inline-flex items-center rounded-full bg-amber-400 text-black text-[11px] font-semibold px-3 py-1 shadow">POPULÄRAST</span>
          <div class="p-6 md:p-8">
            <div class="w-12 h-12 rounded-full bg-amber-400 text-slate-900 flex items-center justify-center">
              <Icon name="tabler:briefcase" class="w-6 h-6" />
            </div>
            <h3 class="mt-4 text-xl font-extrabold text-slate-900">Konferenspaket</h3>
            <p class="text-slate-700">4 dagar / 3 nätter</p>
            <div class="mt-6">
              <div class="text-slate-900">
                <p class="text-sm uppercase tracking-wide text-slate-600">från</p>
                <p class="text-3xl md:text-4xl font-extrabold">7.995 kr</p>
                <p class="text-xs text-slate-600">per person</p>
              </div>
            </div>
            <ul class="mt-6 space-y-3 text-slate-700">
              {[
                '3 nätter på hotell med konferenslokaler',
                'Fullt utrustad konferenssal',
                'All mat & fika inkluderat',
                'Teambuilding-aktivitet',
                'Festmiddag på flodrestaurang',
                'Flygplatstransfer',
              ].map((item) => (
                <li class="flex gap-3"><Icon name="tabler:circle-check" class="w-5 h-5 text-emerald-600" /> <span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="px-6 md:px-8 pb-6">
            <a href="/paket/konferens" class="inline-flex w-full items-center justify-center rounded-full bg-amber-400 text-black font-semibold py-3 hover:bg-amber-300">Begär offert</a>
          </div>
        </article>

        <!-- Kulturpaket -->
  <article class="relative rounded-2xl border border-slate-200 bg-slate-50 shadow-sm reveal-on-scroll">
          <div class="p-6 md:p-8">
            <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center">
              <Icon name="tabler:camera" class="w-6 h-6" />
            </div>
            <h3 class="mt-4 text-xl font-extrabold text-slate-900">Kulturpaket</h3>
            <p class="text-slate-600">5 dagar / 4 nätter</p>
            <div class="mt-6">
              <div class="text-slate-900">
                <p class="text-sm uppercase tracking-wide text-slate-500">från</p>
                <p class="text-3xl md:text-4xl font-extrabold">9.495 kr</p>
                <p class="text-xs text-slate-500">per person</p>
              </div>
            </div>
            <ul class="mt-6 space-y-3 text-slate-700">
              {[
                '4 nätter på boutiquehotell',
                'Guidning på svenska varje dag',
                'Museer & historiska platser',
                'Vinprovning i Šumadija',
                'Kulinarisk upplevelsemiddag',
                'Besök i bohemkvarteret Skadarlija',
              ].map((item) => (
                <li class="flex gap-3"><Icon name="tabler:circle-check" class="w-5 h-5 text-emerald-600" /> <span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="px-6 md:px-8 pb-6">
            <a href="/paket/kultur" class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 text-white font-semibold py-3 hover:bg-slate-800">Boka nu</a>
          </div>
        </article>
      </div>

        <!-- Fotnot + sekundär CTA -->
      <div class="mt-10 text-center reveal-on-scroll">
        <p class="text-slate-500 text-sm">Alla priser är per person vid dubbelbokning. Grupper om 15+ personer får specialpriser.</p>
        <div class="mt-4">
          <a href="/contact?utm_source=belgrad&utm_medium=cta&utm_campaign=skraddarsytt" class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-2.5 text-slate-700 font-semibold hover:bg-slate-50">Skapa eget paket</a>
        </div>
      </div>

      </div>
    </section>

    <!-- Bohemkvarter hero (efter Aktuella paket) -->
    <section id="bohemkvarter" class="relative isolate">
      <img src="/images/bg2.jpeg" alt="Belgrads bohemkvarter" class="h-[64vh] sm:h-[70vh] lg:h-[76vh] w-full object-cover object-center" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-slate-900/65"></div>
      <div class="absolute inset-0 flex items-center">
        <div class="max-w-6xl mx-auto px-4">
          <h2 class="text-white text-4xl sm:text-5xl font-extrabold tracking-tight">Belgrads bohemkvarter</h2>
          <div class="mt-2 h-1.5 w-8 bg-amber-400 rounded"></div>
          <p class="mt-3 text-white font-extrabold leading-tight text-3xl sm:text-4xl">
            <span class="block">mat & dryck för alla</span>
            <span class="block">smaker</span>
          </p>
          <a href="/tours/vinrundtur" class="mt-6 inline-flex rounded-xl bg-amber-400 text-black px-5 py-2.5 font-semibold shadow hover:bg-amber-300">Boka vinrundtur</a>
        </div>
      </div>
    </section>

 

<!-- Större, mer text-rika kort -->
<section class="pt-10 md:pt-14 lg:pt-16 pb-12 md:pb-16 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-4xl md:text-5xl font-serif font-medium text-slate-900 text-center tracking-tighter lg:whitespace-nowrap mb-8 md:mb-12 reveal-on-scroll">
      Belgrad en stad med många ess i rockärmen
    </h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {[
        {
          title: 'Gastronomisk matupplevelse',
          desc:
            'Belgrad är rik på historia, kultur och smak. I små grupper, ledda av en lokal matguide, gör vi en smakrik vandring med flera stopp hos utvalda mataktörer. Ni provar stadens bästa gelato, traditionellt turkiskt kaffe från 1800-talet, färgsprakande marknader och andra kulinariska pärlor.',
          img: '/images/zena3.avif',
          utm: 'belgrad_card_gastro',
        },
        {
          title: 'Skadarlija – bohemisk själ',
          desc:
            'Upptäck Belgrads bohemkvarter Skadarlija med musik, värdshus och levande kvällspuls. Slingrande kullerstensgränder, konstnärlig atmosfär och klassiska kafaner där stammisarna sätter tonen – en tidlös del av stadens identitet.',
          img: '/images/skadarlija2.jpeg',
          utm: 'belgrad_card_skadarlija',
        },
        {
          title: 'Kalemegdan & Nikola Tesla',
          desc:
            'Promenera längs Kalemegdan-fästningens historiska murar och njut av panoramautsikten över Donau och Sava. Kombinera med ett besök på Nikola Tesla-museet och få en djupare inblick i innovation, uppfinningar och serbisk ingenjörstradition.',
          img: '/images/beograd1.jpg',
          utm: 'belgrad_card_kalemegdan',
        },
        {
          title: 'Vojvodina-provinsen',
          desc:
            'Dagstur till Sremski Karlovci med vinprovning i 1800-talskällare och vidare till Novi Sad vid Donau med den ståtliga Petrovaradin-fästningen. En perfekt kontrast till storstaden – kulturarv, natur och smaker i ett.',
          img: '/images/vojvodina.jpg',
          utm: 'belgrad_card_vojvodina',
        },
        {
          title: 'Båttur på Donau',
          desc:
            'Se staden från vattnet med en lugn kryssning på Donau och Sava. Njut av vyer över broar och kajer, och upplev mötet mellan floderna från första parkett. Möjlighet till middag ombord eller stopp vid populära splav-båtar.',
          img: '/images/serbien-belgrad.jpeg',
          utm: 'belgrad_card_boat',
        },
        {
          title: 'Nattliv & rooftops',
          desc:
            'Trendiga barer, klubbar och takterrasser – från bohemiska kvarter till moderna kajområden. Vi kan ordna privat barhopping med guide eller VIP-inträde för en smidig kväll i Belgrads mytomspunna nattliv.',
          img: '/images/beograd.jpg',
          utm: 'belgrad_card_nightlife',
        },
      ].map((card) => (
        <article class="group overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-md hover:shadow-lg transition-shadow reveal-on-scroll">
          <img src={card.img} alt={card.title} class="h-64 w-full object-cover group-hover:scale-[1.02] transition-transform" loading="lazy" decoding="async" />
          <div class="p-6 md:p-8">
            <h3 class="text-xl md:text-2xl font-semibold">{card.title}</h3>
            <p class="mt-3 text-slate-700 text-base leading-relaxed">{card.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>


    <!-- Samlad sektion: Info + Varför Belgrad (ersätter Praktisk info + Steps2) -->
    <section id="info-steps" class="py-16 md:py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
          <!-- Vänster: Rubrik + beskrivning + CTA -->
          <div class="reveal-on-scroll">
            <h2 class="text-3xl sm:text-4xl font-serif font-medium text-slate-900">En lockande Metropolis</h2>
            <p class="mt-4 text-slate-600 leading-relaxed">
              Upplev en av Europas äldsta huvudstäder. Här finner du en stad fylld av liv, präglad av en mångfald av kulturella evenemang och mötesplatser. Med ett överflöd av attraktioner, vackra byggnader, museer, kyrkor, gator och parker utstrålar Belgrad en stark och oemotståndlig urban charm som lockar besökare från hela världen.
            </p>
            <a href="/boka?from=/belgrad" class="mt-6 inline-flex items-center justify-center rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 shadow">Boka</a>
          </div>

          <!-- Höger: Punkter (tidigare Steps2-items) -->
          <div class="grid sm:grid-cols-2 gap-8">
            {[
              { icon: 'tabler:message-star', title: 'Prisvärd destination med direktflyg', desc: 'Belgrad nås inom en kort flygresa från Skandinavien. Flygtid ca 2,5 h och snabb transfer in till centrum.' },
              { icon: 'tabler:globe', title: 'Puls och variation', desc: 'En av Europas mest intressanta och pulserande städer – perfekt för vår och höst.' },
              { icon: 'tabler:award', title: 'Mat & kafékultur', desc: 'Från klassiska grillspecialiteter till moderna restauranger – prisvärt och hög kvalitet.' },
              { icon: 'tabler:award', title: 'Fenomenalt nattliv', desc: 'Staden sover aldrig – barer, klubbar och takterrasser i världsklass.' },
            ].map((it) => (
              <div class="flex items-start gap-4 reveal-on-scroll">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center">
                  <Icon name={it.icon} class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-base font-semibold text-slate-900">{it.title}</h3>
                  <p class="mt-1 text-sm text-slate-600 leading-relaxed">{it.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Praktisk info (infälld i samma sektion) -->
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <article class="rounded-2xl border border-slate-200 bg-white p-6 reveal-on-scroll">
            <h3 class="text-lg font-semibold text-slate-900">Transport</h3>
            <p class="mt-2 text-slate-600">Belgrad har utmärkt kollektivtrafik med spårvagnar, bussar och taxi som är prisvärt och pålitligt.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-white p-6 reveal-on-scroll">
            <h3 class="text-lg font-semibold text-slate-900">Valuta</h3>
            <p class="mt-2 text-slate-600">Serbien använder serbisk dinar (RSD). Växla pengar på banker eller växlingskontor i staden.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-white p-6 reveal-on-scroll">
            <h3 class="text-lg font-semibold text-slate-900">Språk</h3>
            <p class="mt-2 text-slate-600">Serbiska är officiellt språk, men engelska talas ofta på hotell och restauranger.</p>
          </article>
        </div>
      </div>
    </section>


</Layout>

<style>
/* Reveal effekten avaktiverad: elementen är alltid synliga */
.reveal-on-scroll,
.reveal-on-scroll.revealed {
  opacity: 1 !important;
  transform: none !important;
}
</style>
