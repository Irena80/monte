---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Två upplevelser på en dag – Kust & berg i Montenegro',
  description: 'Kombinera hav och berg på samma dag: segling/snorkling i Kotorbukten + jeeptur i bergen. Perfekt för företagsgrupper som vill maximera tiden och upplevelsen.'
};
---
<Layout metadata={metadata}>
  <section class="pt-16 sm:pt-20 md:pt-24">
    <div class="w-full max-w-6xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-serif font-medium text-slate-900 dark:text-white leading-tight text-center">Två upplevelser på en dag</h1>
      <p class="mt-5 max-w-3xl mx-auto text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 leading-relaxed text-center">Kombinera <strong>hav och berg</strong> på samma dag: förmiddag vid Adriatiska havet, eftermiddag bland berg och utsikt – sömlöst planerat för grupper.</p>

      <div class="mt-8 grid md:grid-cols-2 gap-6">
        <img src="/images/brod.jpg" alt="Båttur i Kotorbukten" class="w-full h-64 md:h-80 object-cover rounded-xl shadow" loading="eager" decoding="async" />
        <img src="/images/planina.jpg" alt="Jeeptur i bergen" class="w-full h-64 md:h-80 object-cover rounded-xl shadow" loading="lazy" decoding="async" />
      </div>

      
    </div>
  </section>

   <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">Upplägget i korthet</h2>
        <ul class="mt-4 space-y-3 text-slate-700 dark:text-slate-300">
          <li>• Förmiddag: Båttur/segling i Kotorbukten med badstopp</li>
          <li>• Lunch: Ombord eller vid vattnet</li>
          <li>• Eftermiddag: Jeeptur/vandring i bergen (Orjen/Lovćen)</li>
          <li>• Tidseffektivt: Korta avstånd mellan hav och berg</li>
          <li>• Anpassningsbart: Nivå, tid och innehåll efter gruppens mål</li>
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-slate-200 bg-white dark:bg-slate-800 p-6 shadow">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">Ingår som standard</h3>
          <ul class="mt-3 text-sm text-slate-700 dark:text-slate-300 space-y-2">
            <li>• Lokal guide/koordinator</li>
            <li>• Skipper/båt och säkerhetsutrustning</li>
            <li>• Transporter (marina ⇄ berg)</li>
            <li>• Vatten/snacks, samt lunch</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

 

  <!-- Gallery: more images from the day -->
  <section class="py-12 sm:py-16 bg-slate-50/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8 sm:mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">Bilder från dagen</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Hav på förmiddagen, berg på eftermiddagen – två världar på en dag.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4" id="gallery">
        <figure class="relative group overflow-hidden rounded-xl shadow-sm">
          <img src="/images/jedrenje3.webp" alt="Segling i Kotorbukten i sol" class="w-full h-44 sm:h-56 md:h-60 object-cover transition group-hover:scale-105 cursor-zoom-in" loading="lazy" decoding="async" data-full="/images/jedrenje3.webp" />
        </figure>
        <figure class="relative group overflow-hidden rounded-xl shadow-sm">
          <img src="/images/bluecave.webp" alt="Blue Cave – klarblått vatten och klippor" class="w-full h-44 sm:h-56 md:h-60 object-cover transition group-hover:scale-105 cursor-zoom-in" loading="lazy" decoding="async" data-full="/images/bluecave.webp" />
        </figure>
        <figure class="relative group overflow-hidden rounded-xl shadow-sm">
          <img src="/images/kajak.jpg" alt="Kajak nära kustlinjen – alternativ till segling" class="w-full h-44 sm:h-56 md:h-60 object-cover transition group-hover:scale-105 cursor-zoom-in" loading="lazy" decoding="async" data-full="/images/kajak.jpg" />
        </figure>
        <figure class="relative group overflow-hidden rounded-xl shadow-sm">
          <img src="/images/Durmitor.jpg" alt="Durmitor – dramatiska bergslandskap" class="w-full h-44 sm:h-56 md:h-60 object-cover transition group-hover:scale-105 cursor-zoom-in" loading="lazy" decoding="async" data-full="/images/Durmitor.jpg" />
        </figure>
        <figure class="relative group overflow-hidden rounded-xl shadow-sm">
          <img src="/images/jezero.jpg" alt="Bergssjö i eftermiddagsljus" class="w-full h-44 sm:h-56 md:h-60 object-cover transition group-hover:scale-105 cursor-zoom-in" loading="lazy" decoding="async" data-full="/images/jezero.jpg" />
        </figure>
        <figure class="relative group overflow-hidden rounded-xl shadow-sm">
          <img src="/images/hiking4.jpg" alt="Vandring med utsikt – Orjen eller Lovćen" class="w-full h-44 sm:h-56 md:h-60 object-cover transition group-hover:scale-105 cursor-zoom-in" loading="lazy" decoding="async" data-full="/images/hiking4.jpg" />
        </figure>
      </div>

      <dialog id="lightbox" class="p-0 bg-transparent backdrop:bg-black/80 rounded-lg">
        <button type="button" aria-label="Stäng" class="absolute top-3 right-3 z-10 inline-flex items-center justify-center w-10 h-10 rounded-full bg-black/60 text-white hover:bg-black/80">×</button>
        <img src="" alt="" class="max-h-[85vh] max-w-[90vw] rounded-lg shadow-2xl" />
      </dialog>

      <script>
        const gallery = document.getElementById('gallery');
        const dialogEl = document.getElementById('lightbox');
        if (gallery && dialogEl && dialogEl instanceof HTMLDialogElement) {
          const img = dialogEl.querySelector('img');
          const closeBtn = dialogEl.querySelector('button');
          if (!img || !closeBtn) return;
          gallery.addEventListener('click', (e) => {
            const target = e.target;
            if (!(target instanceof HTMLImageElement)) return;
            const full = target.getAttribute('data-full') || target.src;
            const alt = target.getAttribute('alt') || '';
            img.src = full;
            img.alt = alt;
            dialogEl.showModal();
          });
          const close = () => dialogEl.close();
          closeBtn.addEventListener('click', close);
          dialogEl.addEventListener('click', (e) => {
            const rect = img.getBoundingClientRect();
            const inside = e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom;
            if (!inside) close();
          });
          window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && dialogEl.open) dialogEl.close();
          });
        }
      </script>
    </div>
  </section>

  <section class="py-6 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p class="text-slate-600 dark:text-slate-300">Vill ni byta segling mot kajak eller lägga till vinprovning? Vi skräddarsyr.</p>
      <div class="mt-6">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-slate-900 text-white px-6 py-3 text-sm font-semibold tracking-wide hover:bg-slate-700 transition shadow">
          Kontakta oss
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
