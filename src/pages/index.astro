// Lägg överst i src/pages/index.astro
const metadata = {
  title: 'MediteranoBay — Företags- & gruppresor till Montenegro och Balkan',
  description: 'AI-driven resebyrå som skräddarsyr företags- och gruppresor till Montenegro och utvalda platser i Balkan. Snabb offert, lokal expertis och premiumservice.',
  url: 'https://www.mediteranobay.com',
