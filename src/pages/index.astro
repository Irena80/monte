---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/index.astro
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CTAButton from '~/components/ui/StickyCTA.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';


const metadata = {
  title: 'Mediteranobay — Aktiva resor för grupper och företag',
  description: ' Företags- och gruppresor till Montenegro – Europas mest underskattade pärla. Bygg relationer, idéer och framtid i en miljö som ger plats för något större.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
  actions={[
    {
      variant: 'primary',
      text: 'Företagsresor',
      href: 'resor/foretagsresor',
      target: '_blank',
      icon: 'tabler:plane',
      class: 'hidden sm:inline-flex', // Hide on mobile
    },
    {
      text: 'Gruppresor',
      icon: 'tabler:sun',
      href: 'resor/gruppresor',
      class: 'hidden sm:inline-flex', // Hide on mobile
    },
  ]}
  image={{ src: '~/assets/images/petrovac.png', alt: 'AstroWind Hero Image' }}
>
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">   </span> Aktiva resor för
      <span class="text-accent dark:text-white highlight">  grupper och företag</span> 
    </Fragment>

    <Fragment slot="subtitle">
  
        <span class="font-semibold">Företags- och gruppresor till Montenegro</span> – Europas mest underskattade pärla.<br />
      Bygg relationer, idéer och framtid i en miljö som ger plats för något större.  <span class="hidden sm:block"></span>
      </Fragment>
  </Hero>
   <!-- Features2 Widget ************** -->

 <Features2
  title="Vi säljer inte resor. Vi skapar rum för utveckling."
  subtitle="På MediteranoBay designar vi upplevelser för team, nätverk och grupper som söker något mer än ännu en konferens eller gruppresa."
>


</Features2>
<CTAButton text="Begär offert" link="/kontakt" />
  <!-- Content Widget **************** -->
  <Content
    isReversed
    title="Upplev landet där du på morgonen kan vandra i bergen och på eftermiddag ta ett dopp i havet."
    items={[
      {
        title: 'Kombinera konferens och äventyr för att förbättra teambuildningen',
        description:
          'Segla i den vackra Adriatiska havet med kristallblått vatten, åk linbana över en hissnande kanjon mitt över en forsande flod, kör jeep runt höga berg, prova på extrem canyoning eller bara chilla med en glas lokal vin vid stranden. Montenegro har allt. Sol och vacker natur är i fokus och det är varmt och skönt från slutet av april till oktober.',
      },
      {
        title: 'Upplev Montenegros mångfacitterande skönhet',
        description:
          'Här hittar du en del av av historia som ligger på UNESCO:s världsarvslista. Pittoreska montenegrinska landskap, klippiga toppar, gröna skogar, glasklara sjöar och floder, små fiskebyar och charmiga gamla städer.',
      },
    ]}
    image={{
      src: '~/assets/images/barka.png',
      alt: 'Colorful Image',
    }}
  >
  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2"> Äventyrliga företagsresor</h3>
    Varje företagsresa är en investering och med genomtänkt innehåll, engagemang och en stor dos kreativitet skapar vi nya upplevelser. 
    <br> 
    <a href="resor/gruppresor" class="text-sm text-blue-500">Läs mer</a> <!-- Link instead of button -->
  </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- Content Widget **************** -->
  <Content
    isAfterContent
    items={[
      {
        title: 'Från gömd natur till de bästa attraktionerna, kulturella utflykter och mysiga restauranger',
        description: `Sockersöta kloster, vidunderliga berg och sandstränder med kristallklart vatten. Lilla Montenegro rymmer storslagna upplevelser.
         Utforska medeltidsstäder, vandra i bergen, upplev spa och yoga, ät goda middagar vid stranden i solnedgången. `,
      },
    ]}
    image={{
      src: '~/assets/images/grupp.jpg',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Gruppresor</h3>
      Upplev en smakfull resa med vänner. Oavsett gruppstorlek så hittar ni något i utbudet. Stadsvandring, vinprovning eller varför inte uppleva två upplevelser på samma dag. 
      <br> 
      <a href="resor/gruppresor" class="text-sm text-blue-500">Läs mer</a> <!-- Link instead of button -->
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Från yogapass till vattensport och vandringsexpeditioner',
        description:
          'I morgonsolens värme kan du börja dagen med ett uppfriskande dopp i Adriatiska havets kristallklara vatten, eller paddla längs den natursköna kusten. ',
      },
      {
        title: 'Seglingresor',
        description:
          'Upplev Montenegro från vattnet, lär er grunderna i segling och stärk teamkänslan på samma gång. Det är en enorm känsla att skota hem seglet och känna accelerationen. Det är inte heller helt fel att efter en dags hårt arbete lägga till i en skyddad vik, ta en simtur i solnedgången.',
      },
      {
        title: 'Fotbollsläger',
        description:
          'Med det härligt varmt klimat året runt är både våren och hösten perfekt tid för träningsläger med lagom temperatur och ett lugnt och behagligt tempo.',
      },
    ]}
    image={{
      src: '~/assets/images/biciklizam.jpg',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sportresor</h3>
      Med en imponerande omväxlande natur, fantastiska aktiviteter under varje årstid och sann hållbarhet är Montenegro en helt unik destination att resa till. Vi ses på berget eller i vattnet!
      <br>
      <a href="resor/gruppresor" class="text-sm text-blue-500">Läs mer</a> <!-- Link instead of button -->
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    title="Njut av sol och bad längs magisk turkosblå kust, utforska storslagen natur på spännande vandringar och uppleva charmen hos pittoreska byar."
    items={[
      {
        title: '270 soldagar om året',
        description:
          "Montenegro är känt för sitt behagliga milda klimat, 270 soldagar om året.",
        icon: 'tabler:sun',
      },
      {
        title: 'Hisnande orörd natur',
        description:
          "Trots sin lilla storlek erbjuder Montenegro oändligt med äventyr. Åk till kusten och Budvanska rivieran, upptäck de vita stränderna med stora klippor i bakgrunden, ta en dyktur, åk vattenskidor, vindsurfa eller njut av sol och bad. En båttur ut till de många tillhörande öarna är en härlig upplevelse eller varför inte besöka de magiska Cijevnas vattenfall.",
        icon: 'tabler:tree',
      },
      {
        title: 'Stort utbud av aktiviteter',
        description:
          'Det som gör Montenegro unikt och igenkännbart över hela världen är dess hav, sjöar, kanjoner, berg, och det är just detta som gör det möjligt för alla att hitta det bästa sättet att få en kvalitetsvila i ett litet men stort land. På en dag kan du unna dig ett morgonkaffe på en av de många stränderna i Hercegnovska, Kotor eller Budva rivieran, lunch ombord med fågelsång på sjön Skadar och middag vid brasan på sluttningarna av de magnifika bergen Lovćen, Durmitor eller Biogradska gora.',
        icon: 'tabler:bike',
      },
      {
        title: 'Upptäck!',
        icon: 'tabler:backpack',
      },
    ]}
    image={{
      src: '~/assets/images/Irena.jahta.png',
      alt: 'Bazen',
    }}
  />
<CallToAction
  title="Redo att skapa något minnesvärt med ditt team?"
  description="Låt oss skapa en företagsresa eller gruppupplevelse till Montenegro som ger resultat – och avtryck."
  actions={[
    {
      variant: 'primary',
      text: '🎯 Begär offert',
      href: '/contact',
    },
    {
      variant: 'secondary',
      text: '📄 Se våra upplevelser',
      href: '/resor/foretagsresor',
    },
  ]}
/>
  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Resepaket', amount: '12' },
      { title: 'Aktiviteter', amount: '32+' },
      { title: 'Hotell', amount: '10+' },
      { title: 'Flygplatser', amount: '4' },
    ]}
  />

<!-- BlogLatestPost Widget **************** -->

<section id="blog" class="py-16 bg-blue-50 relative overflow-hidden">
  <div class="max-w-3xl mx-auto text-center mb-12 relative z-10">
    <h2 class="text-3xl md:text-4xl font-bold mb-2 text-blue-900">Låt dig inspireras i vår reseblogg</h2>
    <p class="text-lg text-gray-700">
      Smaka på Montenegro. Dyk ner i vår resa om Montenegro och låt dig inspireras av inhemska maträtter, pampiga sevärdheter och magnifik historia.
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto relative z-10">
    <a href="/skatt" class="group bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col items-center hover:scale-105 transition">
      <div class="relative w-full">
        <img src="/images/muslje.jpg" alt="Mat & Vin i Montenegro" class="w-full h-56 object-cover transition group-hover:scale-110 duration-300" />
        <span class="absolute top-4 left-4 bg-blue-600 text-white px-3 py-1 rounded-full text-xs font-semibold shadow">Mat & Vin</span>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between w-full">
        <h3 class="text-lg font-bold mb-2 text-blue-900">Mat & Vin i Montenegro</h3>
        <p class="text-gray-700 text-sm mb-4">Upptäck Montenegros kulinariska traditioner och vingårdar.</p>
        <span class="inline-flex items-center text-blue-700 font-semibold group-hover:underline text-sm">
          Läs mer
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </a>
    <a href="/skatt"  class="group bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col items-center hover:scale-105 transition">
      <div class="relative w-full">
        <img src="/images/biciklizam.jpg" alt="Äventyr vid kusten" class="w-full h-56 object-cover transition group-hover:scale-110 duration-300" />
        <span class="absolute top-4 left-4 bg-green-600 text-white px-3 py-1 rounded-full text-xs font-semibold shadow">Äventyr</span>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between w-full">
        <h3 class="text-lg font-bold mb-2 text-blue-900">Äventyr vid kusten</h3>
        <p class="text-gray-700 text-sm mb-4">Tips om vandring, cykling och aktiviteter längs Adriatiska havet.</p>
        <span class="inline-flex items-center text-blue-700 font-semibold group-hover:underline text-sm">
          Läs mer
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </a>
    <a href="/skatt" class="group bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col items-center hover:scale-105 transition">
      <div class="relative w-full">
        <img src="/images/Prcanj.jpeg" alt="Kultur & Historia" class="w-full h-56 object-cover transition group-hover:scale-110 duration-300" />
        <span class="absolute top-4 left-4 bg-yellow-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow">Kultur</span>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between w-full">
        <h3 class="text-lg font-bold mb-2 text-blue-900">Kultur & Historia</h3>
        <p class="text-gray-700 text-sm mb-4">Få inspiration om kuststäder, historia och kulturupplevelser.</p>
        <span class="inline-flex items-center text-blue-700 font-semibold group-hover:underline text-sm">
          Läs mer
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </a>
  </div>
  <div class="text-center mt-10 relative z-10">
    <a href="/blog" class="inline-flex items-center gap-2 px-8 py-3 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition text-lg shadow-lg">
      Till bloggen
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="w-96 h-96 bg-blue-200 rounded-full blur-3xl opacity-30 absolute -top-32 -left-32"></div>
    <div class="w-96 h-96 bg-yellow-100 rounded-full blur-3xl opacity-20 absolute -bottom-32 -right-32"></div>
  </div>
</section>


  

 
</Layout>

