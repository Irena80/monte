<script>
  // Mobile menu
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const open = mobileMenu.style.display === 'block';
      mobileMenu.style.display = open ? 'none' : 'block';
      menuBtn.setAttribute('aria-expanded', String(!open));
    });
  }

  // Video pause/play
  const pauseBtn = document.getElementById('pause-btn');
  const video = document.querySelector('.hero-video') as HTMLVideoElement | null;
  const pauseIcon = document.getElementById('pause-icon') as HTMLElement | null;
  const playIcon = document.getElementById('play-icon') as HTMLElement | null;
  if (pauseBtn && video && pauseIcon && playIcon) {
    pauseBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        pauseIcon.style.display = '';
        playIcon.style.display = 'none';
        pauseBtn.setAttribute('aria-label', 'Pausa video');
      } else {
        video.pause();
        pauseIcon.style.display = 'none';
        playIcon.style.display = '';
        pauseBtn.setAttribute('aria-label', 'Spela upp video');
      }
    });
  }

  // Fade-up on scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>

