---
// Startsida – Corporate Offsites landing
import CorporatePackages from '~/components/mbay/CorporatePackages.astro';
---

<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MediteranoBay — Företagsupplevelser i Montenegro</title>
  <meta name="description" content="Vi skapar minnesvärda företagsresor, konferenser och teamupplevelser i en av Europas mest inspirerande destinationer." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://mediteranobay.com/" />
  <meta property="og:title" content="MediteranoBay — Corporate Offsites in Montenegro" />
  <meta property="og:description" content="Vi skapar minnesvärda företagsresor, konferenser och teamupplevelser i en av Europas mest inspirerande destinationer." />
  <meta property="og:image" content="https://mediteranobay.com/images/kotorbukten.jpg" />
  <meta property="og:locale" content="sv_SE" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy: #0b3c5d;
      --navy-dark: #071e2e;
      --gold: #c9a227;
      --gold-light: #e8bb3d;
      --gold-dark: #a88420;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
      color: #1a1a2e;
      background: #fff;
      -webkit-font-smoothing: antialiased;
    }
    .fade-up {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }

    /* ===== NAV ===== */
    #navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(255,255,255,0.97); border-bottom: 1px solid rgba(0,0,0,0.07); backdrop-filter: blur(8px); }
    .nav-inner { max-width: 1280px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-icon { width: 34px; height: 34px; background: var(--navy); border-radius: 4px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .nav-logo-wordmark { display: flex; flex-direction: column; }
    .nav-logo-name { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; color: var(--navy); line-height: 1.1; text-transform: uppercase; }
    .nav-logo-sub { font-size: 8px; font-weight: 500; letter-spacing: 0.16em; color: #9ca3af; text-transform: uppercase; line-height: 1.2; }
    .nav-links { display: none; align-items: center; gap: 28px; }
    .nav-links a { font-size: 11px; font-weight: 700; color: #374151; text-decoration: none; letter-spacing: 0.1em; text-transform: uppercase; }
    .nav-links a:hover { color: var(--navy); }
    .nav-cta { background: var(--gold); color: #fff; font-size: 11px; font-weight: 700; padding: 10px 20px; border-radius: 4px; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
    .nav-cta:hover { background: var(--gold-dark); }
    .hamburger { display: flex; flex-direction: column; gap: 5px; padding: 4px; background: none; border: none; cursor: pointer; }
    .hamburger span { width: 22px; height: 2px; background: #374151; border-radius: 2px; display: block; }
    .mobile-menu { display: none; border-top: 1px solid #f3f4f6; padding: 12px 24px 16px; background: #fff; }
    .mobile-menu a { display: block; padding: 10px 0; font-size: 13px; font-weight: 600; color: #374151; text-decoration: none; border-bottom: 1px solid #f3f4f6; letter-spacing: 0.05em; text-transform: uppercase; }
    .mobile-menu a:last-child { border-bottom: none; }

    /* ===== HERO ===== */
    .hero { position: relative; min-height: 100vh; display: flex; align-items: center; overflow: hidden; margin-top: 68px; }
    .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(7,30,46,0.72) 50%, rgba(7,30,46,0.3) 100%); }
    .hero-pause { position: absolute; bottom: 32px; right: 32px; z-index: 3; background: rgba(255,255,255,0.15); border: 1.5px solid rgba(255,255,255,0.35); border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px); padding: 0; }
    .hero-pause:hover { background: rgba(255,255,255,0.25); }
    .hero-scroll { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; opacity: 0.6; }
    .hero-scroll-line { width: 1px; height: 40px; background: #fff; animation: scrollpulse 1.8s ease-in-out infinite; }
    @keyframes scrollpulse { 0%, 100% { opacity: 0.4; transform: scaleY(1); } 50% { opacity: 1; transform: scaleY(1.2); } }
    .hero-content { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; padding: 80px 32px; width: 100%; }
    .hero-title { font-size: clamp(2.4rem, 5.5vw, 4.4rem); font-weight: 800; line-height: 1.06; color: #fff; letter-spacing: -0.025em; max-width: 680px; margin-bottom: 20px; }
    .hero-sub { font-size: clamp(0.95rem, 1.5vw, 1.05rem); color: rgba(255,255,255,0.78); max-width: 420px; line-height: 1.7; margin-bottom: 36px; }
    .btn-gold { display: inline-flex; align-items: center; gap: 10px; background: var(--gold); color: #fff; font-weight: 700; font-size: 12px; letter-spacing: 0.08em; padding: 14px 28px; border-radius: 4px; text-decoration: none; text-transform: uppercase; border: none; cursor: pointer; }
    .btn-gold:hover { background: var(--gold-dark); }
    .hero-badges { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 40px; }
    .hero-badge { display: flex; align-items: center; gap: 10px; }
    .hero-badge-icon { width: 36px; height: 36px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .hero-badge-label { font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.85); line-height: 1.3; letter-spacing: 0.03em; max-width: 80px; }

    /* ===== DESTINATION SECTION ===== */
    .destination-section { padding: 96px 32px; background: #fff; }
    .destination-inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 5fr 7fr; gap: 80px; align-items: center; }
    .dest-label { font-size: 10px; font-weight: 700; letter-spacing: 0.22em; color: var(--gold); text-transform: uppercase; margin-bottom: 16px; }
    .dest-title { font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; color: #0d2235; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 20px; }
    .dest-desc { font-size: 14px; color: #6b7280; line-height: 1.8; margin-bottom: 28px; }
    .dest-link { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--gold); text-decoration: none; text-transform: uppercase; }
    .dest-link:hover { color: var(--gold-dark); }
    .dest-images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .dest-images img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 4px; display: block; }

    /* ===== ABOUT SECTION ===== */
    .about-section { display: grid; grid-template-columns: 1fr 1fr; min-height: 520px; }
    .about-dark { background: #0d2235; padding: 80px 72px; display: flex; flex-direction: column; justify-content: center; }
    .about-label { font-size: 10px; font-weight: 700; letter-spacing: 0.22em; color: var(--gold); text-transform: uppercase; margin-bottom: 20px; }
    .about-title { font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 800; color: #fff; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 16px; }
    .about-desc { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.8; max-width: 360px; margin-bottom: 28px; }
    .about-link { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--gold); text-decoration: none; text-transform: uppercase; }
    .about-link:hover { color: var(--gold-light); }
    .about-img-wrap { position: relative; overflow: hidden; }
    .about-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(25%); }

    /* ===== CONTACT SECTION ===== */
    .contact-section { position: relative; background: #0d2235; overflow: hidden; }
    .contact-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.12; }
    .contact-inner { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 96px 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .contact-title { font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; color: #fff; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 16px; }
    .contact-desc { font-size: 14px; color: rgba(255,255,255,0.6); line-height: 1.8; max-width: 360px; }
    .contact-form { display: flex; flex-direction: column; gap: 12px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-field { width: 100%; background: rgba(255,255,255,0.95); border: 1px solid transparent; border-radius: 4px; padding: 12px 14px; font-size: 13px; font-family: inherit; outline: none; color: #1a1a2e; }
    .form-field::placeholder { color: #9ca3af; }
    .form-field:focus { border-color: var(--gold); }
    textarea.form-field { resize: vertical; min-height: 100px; }
    .btn-gold-full { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; background: var(--gold); color: #fff; font-weight: 700; font-size: 12px; letter-spacing: 0.1em; padding: 15px; border-radius: 4px; text-transform: uppercase; border: none; cursor: pointer; font-family: inherit; }
    .btn-gold-full:hover { background: var(--gold-dark); }

    /* ===== FOOTER ===== */
    .footer { background: var(--navy); padding: 64px 32px 32px; }
    .footer-inner { max-width: 1280px; margin: 0 auto; }
    .footer-grid { display: grid; grid-template-columns: 2.5fr 1fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
    .footer-logo-wrap { display: flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 14px; }
    .footer-logo-icon { width: 34px; height: 34px; background: rgba(255,255,255,0.1); border-radius: 4px; display: flex; align-items: center; justify-content: center; }
    .footer-logo-name { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: #fff; }
    .footer-tagline { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.7; margin-bottom: 20px; }
    .social-row { display: flex; gap: 10px; }
    .social-btn { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.2s; }
    .social-btn:hover { background: rgba(255,255,255,0.2); }
    .footer-col-label { font-size: 9px; font-weight: 800; letter-spacing: 0.2em; color: rgba(255,255,255,0.3); text-transform: uppercase; margin-bottom: 16px; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-links a { font-size: 13px; color: rgba(255,255,255,0.58); text-decoration: none; }
    .footer-links a:hover { color: #fff; }
    .footer-links li span { font-size: 13px; color: rgba(255,255,255,0.58); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 24px; text-align: center; font-size: 11px; color: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: space-between; }
    .footer-bottom a { color: rgba(255,255,255,0.35); text-decoration: none; }
    .footer-bottom a:hover { color: rgba(255,255,255,0.7); }

    /* ===== RESPONSIVE ===== */
    @media (min-width: 1024px) {
      .nav-links { display: flex; }
      .hamburger { display: none; }
    }
    @media (max-width: 1023px) {
      .about-dark { padding: 56px 40px; }
      .destination-inner { grid-template-columns: 1fr; gap: 40px; }
      .footer-grid { grid-template-columns: 1fr 1fr 1fr; }
    }
    @media (max-width: 767px) {
      .hero { min-height: 92vh; }
      .hero-badges { gap: 16px; }
      .about-section { grid-template-columns: 1fr; }
      .about-img-wrap { min-height: 280px; }
      .about-dark { padding: 48px 24px; }
      .contact-inner { grid-template-columns: 1fr; gap: 40px; padding: 64px 24px; }
      .form-row { grid-template-columns: 1fr; }
      .destination-section { padding: 64px 24px; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
      .footer-bottom { flex-direction: column; gap: 8px; }
    }
  </style>
</head>
<body>

<!-- ========== NAVIGATION ========== -->
<nav id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="MediteranoBay hem">
      <div class="nav-logo-icon">
        <span style="color:#fff;font-weight:900;font-size:16px;letter-spacing:-1px;">M</span>
      </div>
      <div class="nav-logo-wordmark">
        <span class="nav-logo-name">MEDITERANOBAY</span>
        <span class="nav-logo-sub">Företagsupplevelser i Montenegro</span>
      </div>
    </a>

    <div class="nav-links">
      <a href="/upplevelser">Upplevelser</a>
      <a href="/montenegro">Montenegro</a>
      <a href="/blog">Journal</a>
      <a href="/om">Om oss</a>
      <a href="#kontakt">Kontakt</a>
    </div>

    <div style="display:flex;align-items:center;gap:10px;">
      <a href="#kontakt" class="nav-cta">BOKA MÖTE</a>
      <button class="hamburger" id="menu-btn" aria-label="Öppna meny" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/upplevelser">Upplevelser</a>
    <a href="/montenegro">Montenegro</a>
    <a href="/blog">Journal</a>
    <a href="/om">Om oss</a>
    <a href="#kontakt">Kontakt</a>
  </div>
</nav>

<!-- ========== HERO ========== -->
<section class="hero" aria-labelledby="hero-h1">
  <video class="hero-video" autoplay muted loop playsinline>
    <source src="/videos/vildamng.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>

  <button class="hero-pause" type="button" id="pause-btn" aria-label="Pausa video">
    <svg id="pause-icon" width="13" height="13" viewBox="0 0 24 24" fill="#fff"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
    <svg id="play-icon" width="13" height="13" viewBox="0 0 24 24" fill="#fff" style="display:none;"><polygon points="5,3 19,12 5,21"/></svg>
  </button>

  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll-line"></div>
  </div>

  <div class="hero-content">
    <h1 id="hero-h1" class="hero-title fade-up">
      Vandra i bergen<br />på morgonen.<br />Ta ett dopp i havet<br />på kvällen.
    </h1>
    <p class="hero-sub fade-up delay-1">
      Vi skapar skräddarsydda företagsupplevelser i Montenegro där natur, möten och gemenskap blir en del av resan.
    </p>
    <a href="#kontakt" class="btn-gold fade-up delay-2">
      BOKA ETT KOSTNADSFRITT MÖTE
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>

    <div class="hero-badges fade-up delay-3">
      <div class="hero-badge">
        <div class="hero-badge-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
        </div>
        <span class="hero-badge-label">Svensk<br />projektledning</span>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
          </svg>
        </div>
        <span class="hero-badge-label">Lokal<br />destinationsexpert</span>
      </div>
      <div class="hero-badge">
        <div class="hero-badge-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
          </svg>
        </div>
        <span class="hero-badge-label">Skräddarsydda<br />upplevelser</span>
      </div>
    </div>
  </div>
</section>

<!-- ========== FÖRETAGSPAKET ========== -->
<CorporatePackages />

<!-- ========== DESTINATION ========== -->
<section class="destination-section">
  <div class="destination-inner">
    <div class="fade-up">
      <div class="dest-label">Montenegro</div>
      <h2 class="dest-title">En destination.<br />Oändliga möjligheter.</h2>
      <p class="dest-desc">Där berg möter hav och varje dag bjuder på något nytt. Autentiskt, vackert och nära.</p>
      <a href="/kusten" class="dest-link">
        Upptäck Montenegro
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="dest-images fade-up delay-2">
      <img src="/images/morecovek.webp" alt="Hiker overlooking Montenegro coast" loading="lazy" />
      <img src="/images/bluecave.webp" alt="Crystal blue water Montenegro" loading="lazy" />
      <img src="/images/perast.jpg" alt="Perast historic town" loading="lazy" />
    </div>
  </div>
</section>

<!-- ========== ABOUT ========== -->
<section class="about-section" aria-label="Om MediteranoBay">
  <div class="about-dark fade-up">
    <div class="about-label">Vi är MediteranoBay</div>
    <h2 class="about-title">Personliga.<br />Lokala.<br />Engagerade.</h2>
    <p class="about-desc">Vi brinner för Montenegro och för att skapa minnesvärda upplevelser som gör skillnad.</p>
    <a href="/om" class="about-link">
      Läs mer om oss
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
  <div class="about-img-wrap">
    <img src="/images/grupp.jpg" alt="MediteranoBay team" loading="lazy" />
  </div>
</section>

<!-- ========== CONTACT ========== -->
<section id="kontakt" class="contact-section">
  <img class="contact-bg-img" src="/images/kotorbukten.jpg" alt="" aria-hidden="true" loading="lazy" />
  <div class="contact-inner">
    <div class="contact-left fade-up">
      <h2 class="contact-title">Låt oss planera<br />er nästa företagsresa.</h2>
      <p class="contact-desc">Berätta om era planer så återkommer vi med ett förslag som är helt anpassat efter era behov.</p>
    </div>
    <div class="fade-up delay-2">
      <form method="POST" action="/tack" class="contact-form">
        <div class="form-row">
          <input class="form-field" type="text" name="company" placeholder="Företag" required />
          <input class="form-field" type="text" name="name" placeholder="Namn" required />
        </div>
        <div class="form-row">
          <input class="form-field" type="email" name="email" placeholder="E-post" required />
          <input class="form-field" type="text" name="travelers" placeholder="Antal deltagare" required />
        </div>
        <input class="form-field" type="text" name="travel_period" placeholder="Önskad reseperiod" onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'" />
        <textarea class="form-field" name="message" rows="4" placeholder="Meddelande"></textarea>
        <button type="submit" class="btn-gold-full">
          SKICKA FÖRFRÅGAN
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<!-- ========== FOOTER ========== -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">

      <div>
        <a href="/" class="footer-logo-wrap" aria-label="MediteranoBay">
          <div class="footer-logo-icon">
            <span style="color:#fff;font-weight:900;font-size:15px;">M</span>
          </div>
          <span class="footer-logo-name">MEDITERANOBAY</span>
        </a>
        <p class="footer-tagline">Vi skapar minnesvärda företagsupplevelser i Montenegro och västra Balkan.</p>
