---
// filepath: /Users/irena80/Documents/GitHub/monte/src/pages/index.astro
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import CTAButton from '~/components/ui/CTAButton.astro';
import { headerData } from '~/navigation';

import Packages from '~/components/mbay/Packages.astro';


import Features2 from '~/components/widgets/Features2.astro';



// Lägg överst i src/pages/index.astro
const metadata = {
  title: 'MediteranoBay — Företags- & gruppresor till Montenegro och Balkan',
  description: 'AI-driven resebyrå som skräddarsyr företags- och gruppresor till Montenegro och utvalda platser i Balkan. Snabb offert, lokal expertis och premiumservice.',
  url: 'https://www.mediteranobay.com',
  image: '/og-mediteranobay.jpg', // byt till din OG-bild
};
---


<Layout metadata={metadata}>
  <!-- Egen header på startsidan utan RSS & tema-knappar -->
  <Header slot="header" {...headerData} isSticky />

<!-- Global font laddas numera via huvudlayouten -->

<section data-section="hero" class="relative w-full min-h-[520px] sm:min-h-[560px] md:h-[800px] flex items-center justify-center overflow-hidden">
  <picture class="absolute inset-0 w-full h-full z-0">
    <!-- WebP källa kan läggas till om fil genereras: /images/petrovac.webp -->
    <img
      src="/images/petrovac.png"
      alt="Montenegro coastline with crystal blue Adriatic sea"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </picture>
  <!-- Mörkare overlay för bättre kontrast på mobil -->
  <!-- Overlay åter mörkare för vit textkontrast -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/55 to-black/70 md:from-black/60 md:via-black/45 md:to-black/70 z-10"></div>

  <div class="relative z-20 w-full flex flex-col items-center justify-center h-full px-4">
    <h1 class="hero-heading mb-6">
      <span class="hero-line1">Aktiva resor</span>
      <span class="hero-line2">för <span class="hero-accent">grupper & </span>  <span class="hero-accent">företag</span></span>
    </h1>

    <!-- Beskrivning (mindre text) -->
  <p class="max-w-3xl mx-auto mb-8 text-center text-base sm:text-lg md:text-xl text-white/90 leading-relaxed">
      Företags- och gruppresor till Montenegro — Europas mest underskattade pärla.
      <span class="hidden sm:inline"><br />Bygg relationer, idéer och framtid i en miljö som ger plats för något större.</span>
    </p>

    <!-- CTA: Mobil visar endast Boka, desktop visar Företagsresor & Gruppresor -->
    <div class="w-full mb-8 flex flex-col items-center">
      <!-- Mobil: Boka -->
      <div class="w-full max-w-[220px] sm:hidden">
        <CTAButton href="/boka" variant="accent" size="md" class="w-full justify-center text-base py-4">Boka</CTAButton>
      </div>
      <!-- Desktop & tablet: två knappar -->
  <div class="hidden sm:flex gap-4">
    <CTAButton href="/resor/foretagsresor" variant="neutral" size="md" class="px-8 py-4 backdrop-blur-sm bg-white/10 hover:bg-white/15 border border-white/15">Företagsresor</CTAButton>
	<CTAButton href="/resor/gruppresor" variant="neutral" size="md" class="px-8 py-4 backdrop-blur-sm bg-white/10 hover:bg-white/15 border border-white/15">Gruppresor</CTAButton>
  </div>
    </div>

    <!-- Statistik ny stil: rena siffror med separators -->
    <!-- Stats: hidden on mobile per request (hide numbers 270, 32, 25, 10 on small screens) -->
    <div class="hidden sm:flex flex-nowrap items-center justify-center gap-x-6 w-full max-w-4xl mt-1 px-1">
      <div class="flex flex-col items-center min-w-[70px]">
  <span class="hero-stat">270</span>
  <span class="hero-stat-label mt-1">
          Soldagar/år
        </span>
      </div>
  <div class="hidden sm:block h-9 w-px bg-white/40"></div>
  <div class="flex flex-col items-center min-w-[70px]">
  <span class="hero-stat">32+</span>
  <span class="hero-stat-label mt-1">
          Aktiviteter
        </span>
      </div>
  <div class="hidden sm:block h-9 w-px bg-white/40"></div>
  <div class="flex flex-col items-center min-w-[70px]">
  <span class="hero-stat">25+</span>
  <span class="hero-stat-label mt-1">
          Resepaket
        </span>
      </div>
  <div class="hidden sm:block h-9 w-px bg-white/40"></div>
  <div class="flex flex-col items-center min-w-[70px]">
  <span class="hero-stat">10+</span>
  <span class="hero-stat-label mt-1">
          Hotell
        </span>
      </div>
    </div>
    <!-- Mobile compact summary (visible only <640px) -->
  <p class="sm:hidden mt-4 text-center text-[0.72rem] font-semibold tracking-wide text-white/80">
      270 soldagar • 30+ aktiviteter • 25+ paket • 10+ hotell
    </p>
    <!-- Typografi-stilar för hero -->
  <style is:global>
  /* Increased mobile base size for hero heading (större på mobil) */
  .hero-heading { font-family:"Plus Jakarta Sans",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif; @apply text-center font-extrabold tracking-tight text-white; line-height:1.04; letter-spacing:-0.02em; font-size:clamp(2.8rem,8.5vw,5.9rem); text-shadow:0 1px 3px rgba(0,0,0,0.55); }
  /* Större minsta storlek på små skärmar */
  @media (max-width: 639px){
    .hero-heading { font-size: clamp(3.05rem, 10vw, 4.4rem); }
  }
      .hero-line1,.hero-line2 { display:block; }
      .hero-line2 { margin-top:.14em; }
  .hero-accent { @apply text-amber-300 md:text-amber-600; text-shadow:0 1px 2px rgba(0,0,0,.55); }
      /* Hero stats: numbers and labels tuned to match heading aesthetics */
  .hero-stat { position:relative; font-family: var(--font-sans); font-weight:800; letter-spacing:-0.02em; line-height:1; color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.55); font-size:clamp(1.35rem,3.9vw,2.65rem); }
      .hero-stat::after { content:""; position:absolute; left:50%; transform:translateX(-50%); bottom:-6px; height:2px; width:2.25rem; border-radius:9999px; background:linear-gradient(to right, rgba(251,191,36,0), rgba(251,191,36,.85), rgba(251,191,36,0)); }
      @media (min-width:640px){ .hero-stat::after { width:2.75rem; } }
  .hero-stat-label { display:flex; align-items:center; justify-content:center; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:rgba(255,255,255,.85); font-size:clamp(0.6875rem,1vw,0.8125rem); }
      @media (min-width:768px){ .hero-heading { letter-spacing:-0.028em; } }
  @media (min-width:1536px){ .hero-heading { font-size:6.3rem; } }
    </style>
  </div>
</section>

