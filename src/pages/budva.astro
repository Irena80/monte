---
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Stats from '~/components/widgets/Stats.astro';


const metadata = {
  title: 'Budva',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    
    image={{
      src: '/images/Stari grad Budva.jpeg',
      alt: 'Caos Image',
    }}
  >
  <Fragment slot="title">
     <span class="hidden sm:inline"> En historisk pärla</span>  <span
      class="text-blue-900">Budva</span
    > 
  </Fragment>
    <Fragment slot="subtitle">
      "Lilla Dubrovnik" brukar den Budvanska Rivieran kallas som på senare tid lockar allt fler besökare. Medeltidsstaden Budva ger det bästa Montenegro har att erbjuda vad gäller kultur, stränder och pulserande nattliv.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->
  <Stats
    title="Snabb statistik"
    stats={[
      { title: 'Soldagar om året', amount: '250+' },
      { title: 'Strandpromenad', amount: '> 10 km' },
      { title: 'Antal stränder', amount: '20+' },
      { title: 'Kust', amount: '35 km' },
    ]}
  />

  <!-- Intro-block: stor rubrik + text (vänster) och stor bild (höger) -->
  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-10 md:py-12 mt-8 md:mt-12 lg:mt-16">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <!-- Textkolumn -->
      <div class="order-2 md:order-1">
        <h2 class="font-serif uppercase text-slate-600 dark:text-white tracking-tight leading-[0.95] text-[clamp(1.75rem,4.5vw,3.5rem)]">
          En av Adriatiska kustens äldsta städer
        </h2>
        <p class="mt-6 text-gray-700 text-base md:text-lg">
          Budva erbjuder något för alla – från avkoppling vid stranden till kulturella utflykter och natursköna äventyr.
          Staden är känd för sina stränder, sitt pulserande nattliv och sin historiska stadskärna.
        </p>
        <p class="mt-4 text-gray-700 text-base md:text-lg">
          Under sommarmånaderna ökar antalet besökare mångfalt och förvandlar staden till en livfull mötesplats.
          Här är några av våra mest populära aktiviteter.
        </p>
      </div>
      <!-- Bildkolumn -->
      <div class="order-1 md:order-2">
        <img 
          src="/images/budva3.webp"
          alt="Budva – Gamla stan och rivieran" 
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
          class="rounded-2xl w-full h-64 sm:h-80 md:h-[560px] lg:h-[680px] object-cover"
        />
      </div>
    </div>
  </div>

  <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-5xl mb-2 text-center mt-12 md:mt-16">Saker att göra i Budva</h2>

  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-10">
    <!-- Block 1: Gamla stan i Budva -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <img 
        src="/images/budva3.webp"
        alt="Upptäck den charmiga Gamla stan i Budva" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover"
      />
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="bg-blue-900 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M5 7v10a2 2 0 002 2h10a2 2 0 002-2V7" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Upptäck den charmiga Gamla stan</h3>
        </div>
        <p class="text-gray-600 text-base md:text-lg">Medeltida gränder & havsvyer</p>
        <p class="text-gray-700 text-base md:text-lg">
          Budvas mest populära nav och en fristad för historieälskare. Gamla stan har anor från medeltiden – smala gränder och stenklädda byggnader påminner om en mini-Dubrovnik.
        </p>
      </div>
    </div>

    <!-- Block 2: Mogren strand -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <div class="space-y-4 order-2 md:order-1">
        <div class="flex items-center gap-2">
          <div class="bg-cyan-500 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 18l6-6 4 4 8-8" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Simma vid Mogren strand</h3>
        </div>
        <p class="text-gray-600 text-base md:text-lg">Klarblått vatten & klippor</p>
        <p class="text-gray-700 text-base md:text-lg">
          Den spektakulära Mogren-stranden ligger undangömd strax väster om Gamla stan. Glasliknande vatten och dramatiska klippor gör den till en favorit.
        </p>
      </div>
      <img 
        src="/images/mogren.jpg"
        alt="Mogren strand" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover order-1 md:order-2"
      />
    </div>

    <!-- Block 3: Sveti Stefan -->
    <div class="grid md:grid-cols-2 gap-8 mb-16 items-start">
      <img 
        src="/images/svetistefan1-1.jpg"
        alt="Sveti Stefan utsiktsplats" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover"
      />
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="bg-amber-500 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3v5h6v-5c0-1.657-1.343-3-3-3z" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Utsikt mot ikoniska Sveti Stefan</h3>
        </div>
        <p class="text-gray-600 text-base md:text-lg">Vykortsvy & solblekta stränder</p>
        <p class="text-gray-700 text-base md:text-lg">
          Den bildsköna ön är ett landmärke längs Budvas kust. Utsiktsplatserna runt orten bjuder på oförglömliga vyer – perfekta för foto.
        </p>
      </div>
    </div>

    <!-- Block 4: Lovćen National Park -->
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="space-y-4 order-2 md:order-1">
        <div class="flex items-center gap-2">
          <div class="bg-green-600 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l6 6-6 6M21 7l-6 6 6 6" />
            </svg>
          </div>
          <h3 class="display-h3 text-slate-900">Besök Lovćen National Park</h3>
        </div>
        <p class="text-gray-600 text-base md:text-lg">Mausoleum & slingrande vägar</p>
        <p class="text-gray-700 text-base md:text-lg">
          Upplev bergstoppar, historiska platser och vida panoramavyer. Kombinera linbana, serpentinvägar och promenad i Cetinje.
        </p>
      </div>
      <img 
        src="/images/lovcen.webp"
        alt="Lovćen National Park" 
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
        class="rounded-2xl w-full aspect-[4/3] object-cover order-1 md:order-2"
      />
    </div>
  </div>

  <!-- Utvalda aktiviteter – erbjudanden-stil kort -->
  <section class="relative mx-auto max-w-7xl px-4 md:px-6 lg:px-8 mt-8 md:mt-16">
    <div class="text-center">
      <p class="text-[11px] tracking-[0.15em] font-semibold text-amber-600 uppercase">Utvalda aktiviteter</p>
      <h2 class="mt-2 text-3xl md:text-5xl font-semibold md:font-bold tracking-tight text-slate-900 dark:text-white leading-tight">Utvalda aktiviteter i Budva</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg">Tips på saker att göra i och runt Budva</p>
    </div>
    <div class="mt-10 grid gap-6 sm:gap-8 md:grid-cols-2 xl:grid-cols-3">
      <!-- Overlay Card 1 -->
      <a href="/utflykter" class="group relative block rounded-2xl overflow-hidden bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600">
        <img src="/images/Budva.jpg" alt="Gamla stan i Budva" loading="lazy" decoding="async" class="h-72 sm:h-80 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
          <div>
            <h3 class="text-white text-xl sm:text-2xl font-extrabold leading-tight drop-shadow">Gamla stan i Budva</h3>
            <p class="text-white/90 text-sm sm:text-base">Budva, Montenegro</p>
          </div>
        </div>
      </a>

      <!-- Overlay Card 2 -->
      <a href="/kusten" class="group relative block rounded-2xl overflow-hidden bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600">
        <img src="/images/mogren.jpg" alt="Mogren Beach" loading="lazy" decoding="async" class="h-72 sm:h-80 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
          <div>
            <h3 class="text-white text-xl sm:text-2xl font-extrabold leading-tight drop-shadow">Mogren Beach</h3>
            <p class="text-white/90 text-sm sm:text-base">Budva Riviera</p>
          </div>
        </div>
      </a>

      <!-- Overlay Card 3 -->
      <a href="/kusten" class="group relative block rounded-2xl overflow-hidden bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600">
        <img src="/images/svetistefan1-1.jpg" alt="Sveti Stefan" loading="lazy" decoding="async" class="h-72 sm:h-80 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
          <div>
            <h3 class="text-white text-xl sm:text-2xl font-extrabold leading-tight drop-shadow">Sveti Stefan – utsikt</h3>
            <p class="text-white/90 text-sm sm:text-base">Budva Riviera</p>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Äventyret startar här"
    subtitle="Njut av ett stort restaurangutbud, bra nattliv och många stränder. Tack vare dess läge är Budva även en bra utgångspunkt till ett flertal andra intressanta platser."
    isReversed={true}
    callToAction={{
      text: 'Boka paketresa',
      href: 'contact',
    }}
    items={[
      {
        title: 'Flyg',
        description: 'Direktflyg finns från mars till november till Dubrovnik eller Tivat och resan tar ca 2,5 timmar . Alternativ flyg med mellanlandning från  Skandinavien till huvudstaden Podgorica i Montenegro går dagligen. Flygresan tar ca 4-5 timmar. <br> Är ni en större företagsgrupp på ca 100 personer och uppåt, kan vi hjälpa Er att privatchartra Ert egna flyg, som avgår direkt från er närmaste avrese-ort till Tivat i Montenegro.',
        icon: 'tabler:plane',
      },
      {
        title: 'Transfertider',
        description:
          'Från Tivats flygplats till Budva är det ca 30 minuters transfer och till Bay of Kotor är det ca 15 minuters transfer. Från Podgoricias internationella flygplats är det ca 1 timmes transfer till Budva.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Hotell och boende i Montenegro',
        description:
          'I den charmiga orten Budva finns 4* hotell med utmärkta konferensmöjligheter för grupper upp till flera hundra personer. I området runt Tivat med Kotor och Porto Montenegro hittar vi flera läckra 5* hotell.',
        icon: 'tabler:award',
      },
    ]}
  />


  

  
</Layout>
