---
import MBLayout from '../layouts/MBLayout.astro';
---

<MBLayout
  title="Skräddarsydd Företagsresa — MediteranoBay"
  description="Vi skapar en resa helt utifrån era mål, behov och önskemål. Inga standardlösningar — bara er resa."
  ogImage="/images/jedrenje.webp"
  ogUrl="https://mediteranobay.com/skraddarsydd-foretagsresa"
  activeNav="upplevelser"
>

<!-- ===== HERO ===== -->
<section class="hero" aria-labelledby="hero-h1">
  <img class="hero-img" src="/images/jedrenje.webp" alt="Skräddarsydd företagsresa i Montenegro" />
  <div class="hero-overlay"></div>
  <div class="hero-scroll" aria-hidden="true"><div class="hero-scroll-line"></div></div>
  <div class="hero-content">
    <div class="hero-kicker fade-up">Upplevelser</div>
    <h1 id="hero-h1" class="hero-title fade-up delay-1">Skräddarsydd<br />företagsresa</h1>
    <p class="hero-sub fade-up delay-2">
      Vi skapar en resa helt utifrån era mål, behov och önskemål. Inga standardlösningar — bara er resa.
    </p>
    <a href="#kontakt" class="btn-gold fade-up delay-3">
      BOKA ETT MÖTE
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>

<!-- ===== INTRO ===== -->
<section class="page-intro">
  <div class="page-intro-inner">
    <div class="fade-up">
      <div class="intro-kicker">Skräddarsydd resa</div>
      <h2 class="intro-title">Ingen resa är<br />den andra lik.</h2>
    </div>
    <p class="intro-body fade-up delay-1">
      Har ni specifika mål, en ovanlig gruppstorlek eller helt unika önskemål? Vi börjar med ett blankt papper och bygger er resa från grunden — utifrån era behov, er budget och era drömmar.
    </p>
  </div>
</section>

<!-- ===== PLACEHOLDER: Processen ===== -->
<section class="placeholder-section">
  <div class="placeholder-inner">
    <div class="placeholder-label fade-up">Processen</div>
    <div class="placeholder-block fade-up delay-1">
      <span>Innehåll kommer — Hur vi skapar er skräddarsydda resa</span>
    </div>
  </div>
</section>

<!-- ===== PLACEHOLDER: Exempel ===== -->
<section class="placeholder-section">
  <div class="placeholder-inner">
    <div class="placeholder-label fade-up">Exempel</div>
    <div class="placeholder-block fade-up delay-1">
      <span>Innehåll kommer — Exempel på skräddarsydda resor vi skapat</span>
    </div>
  </div>
</section>

<!-- ===== PLACEHOLDER: Galleri ===== -->
<section class="placeholder-section">
  <div class="placeholder-inner">
    <div class="placeholder-label fade-up">Bilder</div>
    <div class="placeholder-block fade-up delay-1" style="min-height:320px;">
      <span>Innehåll kommer — Bildgalleri</span>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-banner" id="kontakt">
  <img class="cta-banner-bg" src="/images/kotorbukten.jpg" alt="" aria-hidden="true" loading="lazy" />
  <div class="cta-banner-inner">
    <h2 class="cta-banner-title fade-up">Berätta om era drömmar.<br />Vi gör dem verklighet.</h2>
    <p class="cta-banner-desc fade-up delay-1">Boka ett kostnadsfritt möte så berättar vi mer och skapar ett förslag helt utifrån era behov.</p>
    <a href="/kontakt" class="btn-gold fade-up delay-2">
      BOKA ETT MÖTE
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>

</MBLayout>
