---
import Layout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
 
import Features from '~/components/widgets/Features.astro';
 
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
 

 

const metadata = {
  title: 'Reseinfo',
};
---

<Layout metadata={metadata}>
  <!-- Full-bleed hero matching Företagsresor -->
  <section data-section="hero" class="relative w-full h-[70vh] min-h-[560px] overflow-hidden">
    <!-- Background image -->
    <img
      src="/images/Tivat.webp"
      alt="Tivat och Montenegros kust"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/35"></div>
    <!-- Bottom fade to white -->
    <div class="absolute inset-x-0 bottom-0 h-56 sm:h-64 bg-gradient-to-b from-transparent to-white"></div>

    <!-- Centered content -->
    <div class="relative h-full flex items-center justify-center px-6 z-10">
      <div class="w-full max-w-3xl text-center">
        <h1 class="text-white text-[2rem] sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] drop-shadow-[0_6px_22px_rgba(0,0,0,0.55)]">
          Reseinfo om <br />
          <span class="text-white">Montenegro</span>
        </h1>
        <p class="mt-3 text-white/90 text-[0.95rem] sm:text-base md:text-lg leading-relaxed max-w-xl mx-auto">
          Användbar information inför din resa: klimat, flyg, praktiska tips och mer.
        </p>
        <div class="mt-6 flex items-center justify-center">
          <a href="/contact" class="inline-flex items-center rounded bg-slate-900/90 hover:bg-slate-900 text-white px-5 py-2.5 text-sm font-semibold shadow focus:outline-none focus:ring-2 focus:ring-white/40">
            Kontakta oss
          </a>
        </div>
      </div>
    </div>
  </section>



  

  <!-- Features2 Widget ************** -->


  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Inför resan till Montenegro"
    subtitle="Montenegro gränsar till Kroatien och Bosnien och Hercegovina i norr, Serbien i öster samt Albanien i söder."
    columns={3}
    items={[
      {
        title: 'Huvudstad',
        description:
          'Podgorica',
        icon: 'tabler:globe',
      },
      {
        title: 'Folkmängd',
        description: '650 000',
        icon: 'tabler:man',
      },
      {
        title: 'Språk',
        description:
          'Montenegriniska',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'Valuta',
        description: 'Euro (EUR)',
        icon: 'tabler:cash',
      },
      {
        title: 'Tid',
        description:
          'Det är ingen tidsskillnad mellan Sverige och Montenegro.',
        icon: 'tabler:clock',
      },
      {
        title: 'Religion',
        description:
          'Kristendom (främst ortodoxt kristna)',
        icon: 'tabler:man',
      },
     
    ]}
  />
 
  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frågor och svar"
    items={[
      {
        title: 'Pass och visum',
        description:
          'För att resa till Montenegro som svensk medborgare krävs endast giltigt pass. Visum för svenska medborgare behövs inte, man får stanna i Montenegro i 90 dagar. Registrering på vistelsen krävs enligt montenegrinsk lag, detta brukar skötas via hotellen. Passets giltighetstid måste överstiga vistelsetiden i Montenegro med 90 dagar.',
      },
      
      {
        title: 'Väder och klimat',
        description:
          'I Montenegro råder medelhavsklimat vid kusten, med torra och varma somrar och milda vintrar. I de bergiga områdena är temperaturerna lägre. Då landet har en stor variation i landskap, klimat, jordmån och höjdskillnader har de en av Europas största biologiska mångfalder.',
      },
      {
        title: 'Bästa reseperiod',
        description:
          'Mellan maj och oktober är vädret som bäst, men högsäsongen med flest besökare är mellan juli och september.',
      },
      {
        title: 'Debit & kredit kort',
        description:
          'Kortbetalningar är accepterade överallt.',
      },
      {
        title: 'Flyg',
        description:
          'Direktflyg finns från Stockholm eller Göteborg till Tivat eller Dubrovnik. Flygtiden är ca 3 timmar. Transfer från Dubrovnik till Montenegro tar ca 30 min.  ',
      },
     
      {
        title: 'Perfekt positionering för internationella flyg:',
        description:
          'Tivat 17km sydväst <br> Dubrovnik 35km nordväst   <br> Podgorica 101km sydöst ',
      },
      
    
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

    

  <!-- Features3 Widget ************** -->

  <Features3
    title="Vi ser framemot att hjälpa er"
    subtitle="Vill ni ha hjälp med ett arrangemang med Mediteranobay? Maila, chatta eller ring!"
    columns={4}
    items={[
      {
        title: 'Kontakt',
        icon: 'tabler:phone',
        callToAction: {
          target: '_blank',
          text: '+46 76 588 53 25',
          href: 'tel:+46765885325',
          variant: 'link',
        },
      },
      {
        title: 'E-post',
        icon: 'tabler:mail',
        callToAction: {
          target: '_blank',
          text: 'info@mediteranobay.com',
          href: 'mailto:info@mediteranobay.com',
          variant: 'link',
        },
      },
      {
        title: 'Chatta med vår support',
        icon: 'tabler:message-circle',
        callToAction: {
          target: '_blank',
          text: 'Chatta',
          href: '/',
          variant: 'link',
        },
      },
      {
        title: 'Chatta med vår sälj',
        icon: 'tabler:message-circle',
        callToAction: {
          target: '_blank',
          text: 'Chatta',
          href: '/',
          variant: 'link',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Kontakta oss',
        href: 'contact',
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">Upptäckt den vilda Montenegro</Fragment>

    <Fragment slot="subtitle">
     Landet där berg och hav förenas.
    </Fragment>
  </CallToAction>
</Layout>
