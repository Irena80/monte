---
// Ekologisk matupplevelse – moderniserad med MBLayout (innehåll oförändrat)
import MBLayout from '../layouts/MBLayout.astro';
---

<MBLayout
  title="Ekologisk matupplevelse i Montenegro – Smaker & hållbarhet"
  description="Upptäck Montenegros ekologiska smaker. Lokala gårdar, hantverk och hållbar gastronomi – perfekt som temaresa eller inslag i konferensen."
  ogImage="/images/ovcepriroda.jpg"
  ogUrl="https://mediteranobay.com/ekologisk"
  activeNav=""
>

<!-- ===== HERO ===== -->
<section class="hero" aria-labelledby="hero-h1">
  <img class="hero-img" src="/images/ovcepriroda.jpg" alt="Ekologisk matupplevelse – natur och gård i Montenegro" />
  <div class="hero-overlay"></div>
  <div class="hero-scroll" aria-hidden="true"><div class="hero-scroll-line"></div></div>
  <div class="hero-content">
    <div class="hero-kicker fade-up">Mat &amp; Dryck</div>
    <h1 id="hero-h1" class="hero-title fade-up delay-1">
      Ekologisk<br />matupplevelse.
    </h1>
    <p class="hero-sub fade-up delay-2">
      Lokala gårdar, hantverk och hållbar gastronomi – perfekt som temaresa eller inslag i konferensen.
    </p>
    <a href="#kontakt" class="btn-gold fade-up delay-3">
      BOKA ETT MÖTE
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>

<!-- ===== FEATURE BAR ===== -->
<div class="pg-feature-bar">
  <div class="pg-feature-bar-inner">
    <div class="pg-feature-item">
      <svg class="pg-feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 3-6 4 10H3z"/></svg>
      <span class="pg-feature-label">Ekologiska råvaror</span>
    </div>
    <div class="pg-feature-item">
      <svg class="pg-feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      <span class="pg-feature-label">Lokala producenter</span>
    </div>
    <div class="pg-feature-item">
      <svg class="pg-feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zM2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
      <span class="pg-feature-label">Hållbar gastronomi</span>
    </div>
    <div class="pg-feature-item">
      <svg class="pg-feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="15" rx="2"/><path d="M3 10h18M8 6V4M16 6V4"/></svg>
      <span class="pg-feature-label">Anpassat för grupper</span>
    </div>
  </div>
</div>

<!-- ===== VARFÖR ===== -->
<section class="pg-section pg-section-white">
  <div class="pg-inner">
    <div class="pg-2col">
      <div class="fade-up">
        <div class="pg-kicker">Varför ekologisk matupplevelse?</div>
        <h2 class="pg-h2">Lokala gårdar och<br />hållbar gastronomi.</h2>
        <p class="pg-body">
          Smaka på Montenegro genom lokala gårdar, ost- och charkhantverk samt ekologiska vingårdar. En upplevelse som passar både som egen resa och som temadel i konferensen.
        </p>
        <ul class="pg-checks">
          <li class="pg-check">
            <svg class="pg-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Lokala ekologiska producenter och vingårdar
          </li>
          <li class="pg-check">
            <svg class="pg-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Mat- och dryckesprovningar med storytelling
          </li>
          <li class="pg-check">
            <svg class="pg-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Hållbarhet i fokus
          </li>
          <li class="pg-check">
            <svg class="pg-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Kan kombineras med konferens eller gruppresa
          </li>
        </ul>
      </div>
      <div class="fade-up delay-2">
        <img class="pg-img-main" src="/images/muslje.jpg" alt="Lokala råvaror från hav och land" loading="lazy" />
        <div class="pg-stats">
          <div class="pg-stat">
            <div class="pg-stat-num">100%</div>
            <div class="pg-stat-label">Lokala råvaror</div>
          </div>
          <div class="pg-stat">
            <div class="pg-stat-num">2–3</div>
            <div class="pg-stat-label">Dagars upplägg</div>
          </div>
          <div class="pg-stat">
            <div class="pg-stat-num">98%</div>
            <div class="pg-stat-label">Nöjda deltagare</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== BILDGALLERI ===== -->
<section class="pg-section pg-section-cream" style="padding-top: 0;">
  <div class="pg-inner">
    <div class="pg-gallery-3 fade-up">
      <img src="/images/muslje.jpg" alt="Lokala råvaror från hav och land" loading="lazy" />
      <img src="/images/vin2.webp" alt="Ekologiska vingårdar i Montenegro" loading="lazy" />
      <img src="/images/ovcepriroda.jpg" alt="Ekologisk gård i inlandet" loading="lazy" />
    </div>
  </div>
</section>

<!-- ===== EXEMPELUPPLÄGG ===== -->
<section class="pg-section pg-section-cream">
  <div class="pg-inner" style="text-align:center;">
    <div class="fade-up">
      <div class="pg-kicker">Exempelupplägg</div>
      <h2 class="pg-h2 pg-h2-center">2–3 dagar för smaker och upplevelser</h2>
    </div>
    <div class="pg-steps pg-steps-3 fade-up delay-1">
      <div class="pg-step">
        <div class="pg-step-day">Dag 1</div>
        <div class="pg-step-circle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-5 7 5v14"/><path d="M9 21V15h6v6"/></svg>
        </div>
        <div class="pg-step-title">Gårdsbesök</div>
        <div class="pg-step-desc">Gårdsbesök, ost- och charkprovning med lokala producenter.</div>
      </div>
      <div class="pg-step">
        <div class="pg-step-day">Dag 2</div>
        <div class="pg-step-circle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/></svg>
        </div>
        <div class="pg-step-title">Vingård &amp; Middag</div>
        <div class="pg-step-desc">Ekologisk vingård och slow-cooking middag med regionens bästa råvaror.</div>
      </div>
      <div class="pg-step">
        <div class="pg-step-day">Dag 3</div>
        <div class="pg-step-circle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 19c2.5-2 5-3 7-2s4 2 6 1 4-2.5 6-1.5"/></svg>
        </div>
        <div class="pg-step-title">Kust &amp; Hav</div>
        <div class="pg-step-desc">Kustens fisk- och skaldjursfokus med havets färskaste råvaror (valfritt).</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== VANLIGA FRÅGOR ===== -->
<section class="pg-section pg-section-white">
  <div class="pg-inner" style="text-align:center;">
    <div class="fade-up">
      <div class="pg-kicker">Vanliga frågor</div>
      <h2 class="pg-h2 pg-h2-center">Allt du behöver veta.</h2>
    </div>
    <div class="pg-faq-list fade-up delay-1" style="text-align:left;">

      <div class="pg-faq-item">
        <button class="pg-faq-q" aria-expanded="false">
          Vad kostar paketet?
          <span class="pg-faq-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="pg-faq-answer"><p>Kontakta oss för offert och upplägg anpassat efter gruppstorlek och datum.</p></div>
      </div>

      <div class="pg-faq-item">
        <button class="pg-faq-q" aria-expanded="false">
          Kan vi anpassa innehållet?
          <span class="pg-faq-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="pg-faq-answer"><p>Ja, vi skräddarsyr helt efter era önskemål.</p></div>
      </div>

      <div class="pg-faq-item">
        <button class="pg-faq-q" aria-expanded="false">
          Passar detta för företag?
          <span class="pg-faq-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="pg-faq-answer"><p>Absolut, det är perfekt som temainslag i konferensen eller som egen företagsresa.</p></div>
      </div>

    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-banner" id="kontakt">
  <img class="cta-banner-bg" src="/images/masline.webp" alt="" aria-hidden="true" loading="lazy" />
  <div class="cta-banner-inner" style="display:grid;grid-template-columns:1fr auto;align-items:center;gap:48px;">
    <div>
      <h2 class="cta-banner-title fade-up">Begär offert på<br />ekologisk matupplevelse.</h2>
      <p class="cta-banner-desc fade-up delay-1">Berätta om er grupp och era önskemål — vi skapar ett förslag anpassat efter era behov.</p>
    </div>
    <div class="fade-up delay-2" style="flex-shrink:0;">
      <a href="/kontakt" class="btn-gold">
        BOKA ETT MÖTE
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>

</MBLayout>
