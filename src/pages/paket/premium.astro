---
import Layout from '../../layouts/PageLayout.astro';

const metadata = {
  title: 'Premium – Paketdetaljer & offert',
  description: 'Premium – skräddarsytt för företag som vill ha det lilla extra. Läs vad som ingår och begär offert.'
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-10">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-6">Premium</h1>
      <p class="text-slate-700 md:text-lg mb-6">Skräddarsytt upplägg med boutiquehotell, exklusiva middagar och unika aktiviteter.</p>

      <h2 class="text-2xl font-bold mb-3">Detta ingår</h2>
      <ul class="list-disc pl-6 space-y-1 text-slate-700 mb-8">
        <li>Flyg tur och retur</li>
        <li>5 nätter på boutiquehotell</li>
        <li>Helpension & exklusiva middagar</li>
        <li>Unika aktiviteter & privat guide</li>
      </ul>

      <div class="mt-2">
        <a href="/kontakt" class="inline-flex items-center rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-white">Begär offert – Premium</a>
      </div>
    </div>
  </section>
</Layout>
