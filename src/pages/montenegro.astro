<!-- ========== VANLIGA FRÅGOR ========== -->
<section class="faq-section">
  <div class="section-inner">
    <div class="fade-up" style="text-align:center;">
      <div class="section-kicker" style="text-align:center;">Vanliga frågor</div>
      <h2 class="section-title" style="max-width:100%;text-align:center;">Allt du behöver veta.</h2>
