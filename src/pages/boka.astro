---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import { travelPackages as packages } from '~/data/packages';

const metadata = {
  title: 'Boka din resa',
  description: 'Boka konferensresa, gruppresa eller sportresa till Montenegro.',
};

// Removed back-link support and variables
---

<Layout metadata={metadata}>
  <HeroText
    title="Vi sammanför Montenegro med Skandinavien"
    subtitle="Välj mellan salig utbud av redan paketerade helhetsupplevelser eller hör av er så tar vi fram skräddarsydda paket utifrån era behov."
  />

  <!-- Back link removed per request -->

<section class="py-6 sm:py-8">
  <div class="max-w-5xl mx-auto flex flex-col gap-10 sm:gap-12">
    {packages.map((pkg) => (
      <a
        href={pkg.link?.startsWith('/') ? pkg.link : `/${pkg.link || ''}`}
        class="bg-white rounded-2xl shadow-xl p-5 sm:p-8 flex flex-col md:flex-row items-center gap-6 md:gap-8 md:min-h-[340px] hover:scale-[1.015] md:hover:scale-105 transition group cursor-pointer"
        style="text-decoration: none;"
      >
        <img
          src={pkg.imageUrl}
          alt={pkg.title}
          class="w-full h-56 sm:h-72 md:w-[420px] md:h-80 object-cover rounded-xl sm:rounded-2xl group-hover:brightness-90 transition"
        />
        <div class="flex-1 flex flex-col justify-center w-full">
          <h3 class="text-xl sm:text-2xl font-bold mb-1.5 sm:mb-2 text-blue-900 group-hover:underline group-active:no-underline leading-snug">{pkg.title}</h3>
          <p class="text-gray-600 mb-1 text-sm sm:text-base">{pkg.location}</p>
          <p class="text-gray-700 mb-3 sm:mb-4 text-sm sm:text-base line-clamp-3 sm:line-clamp-none">{pkg.description}</p>
          {pkg.price && (
            <div class="flex items-center mb-3 sm:mb-4">
              <p class="text-blue-700 font-semibold text-base sm:text-lg flex items-center">
                {pkg.price}
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600 group-hover:text-blue-800 transition-colors duration-200 ml-2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="2"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 8l4 4-4 4" />
                </svg>
              </p>
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</section>



  <Prices
    title="Välj mellan våra färdiga resepaket"
    subtitle="Några av våra färdiga resepaket"
    prices={[
      {
        title: 'Bas',
        subtitle: 'För mindre grupper',
  price: 12999,
  period: 'per person',
        items: [
          { description: 'Flyg t/r' },
          { description: '3 nätter på hotell' },
          { description: 'Frukost & middag' },
          { description: 'Transfer & aktiviteter' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Boka nu',
          href: '/contact',
        },
      },
      {
        title: 'Standard',
        subtitle: 'För företag & större grupper',
  price: 14999,
  period: 'per person',
        items: [
          { description: 'Flyg t/r' },
          { description: '4 nätter på hotell' },
          { description: 'Helpension' },
          { description: 'Konferenspaket & aktiviteter' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Boka nu',
          href: '/contact',
        },
        hasRibbon: true,
        ribbonTitle: 'Populär',
      },
      {
        title: 'Premium',
        subtitle: 'Skräddarsytt för företag',
  price: 19999,
  period: 'per person',
        items: [
          { description: 'Flyg t/r' },
          { description: '5 nätter på boutiquehotell' },
          { description: 'Helpension & exklusiva middagar' },
          { description: 'Unika aktiviteter & privat guide' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Boka nu',
          href: '/contact',
        },
      },
    ]}
  />

   
</Layout>

<!-- Ensure browser back goes to index if user arrived from outside the site or with no referrer -->
<script>
  (function () {
    try {
      const params = new URLSearchParams(window.location.search);
      // If a specific internal origin is provided via ?from=, keep default back behavior
      if (params.has('from')) return;
      const ref = document.referrer;
      let sameOrigin = false;
      if (ref) {
        try { sameOrigin = new URL(ref).origin === window.location.origin; } catch { /* ignore parse errors */ }
      }
      if (!sameOrigin) {
        // Create a history entry so back triggers popstate; then route to home
        history.pushState({ redirectBackToHome: true }, '', window.location.href);
        window.addEventListener('popstate', function () {
          window.location.href = '/';
        });
      }
    } catch {
      // noop
    }
  })();
  </script>
<!-- Back-link script removed -->