        callToAction: {
          target: '_blank',
          text: 'Boka nu',
          href: '/kontakt',
        },
      },
      {
        title: 'Standard',
        subtitle: 'För företag & större grupper',
        price: 14999,
        period: 'per person',
        currency: 'sek', // Lägg till denna rad
        items: [
          { description: 'Flyg t/r' },
          { description: '4 nätter på hotell' },
          { description: 'Helpension' },
          { description: 'Konferenspaket & aktiviteter' },
