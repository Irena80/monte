        callToAction: {
          target: '_blank',
          text: 'Boka nu',
          href: '/kontakt',
        },
        hasRibbon: true,
        ribbonTitle: 'Populär',
      },
      {
        title: 'Premium',
        subtitle: 'Skräddarsytt för företag',
        price: 19999,
        period: 'per person',
        currency: 'sek', // Lägg till denna rad
        items: [
          { description: 'Flyg t/r' },
          { description: '5 nätter på boutiquehotell' },
          { description: 'Helpension & exklusiva middagar' },
