---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Costcard from '~/components/Costcard.astro';


const metadata = {
  title: 'Pris',
};
const costs = [
	{
		title:"Konferensresa till Budva",
		location:"Avresa februari-oktober 2025 | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Här spenderar ni tre dagar i Budva området där ni mellan konferenser och teambuildning njuter av salta bad, middagar och fest. ",
		price:"12999",
		imageUrl:"friends.webp",
    href:"/budva", // Ensure the href property is set correctly
	},
  

	{
		title:"Konferensresa till Herceg Novi",
		location:"Avresa februari-oktober 2025|Flyg från Stockholm, Göteborg| 4* hotell",
		description:"Här spenderar ni tre dagar i Herceg Novi området där ni mellan konferenser och teambuildning njuter av salta bad, middagar och fest. ",
		price:"12900",
		imageUrl:"portonovi.webp",
    href:"/hercegnovi", // Ensure the href property is set correctly
    },
	
	{
		title:"Gruppresor till Montenegro",
		location:"Avresa året om | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Hör av er till oss så tar vi fram det bästa resepaket som passar just er. ",
		imageUrl:"friends.webp",
    href:"/contact", // Ensure the href property is set correctly
	},
  {
		title:"Sportresor till Montenegro",
		location:"Avresa året om | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Kontakta oss så tar vi fram ett sportarrangemang som passar just er. ",
		imageUrl:"yoga.jpg",
    href:"/contact", // Ensure the href property is set correctly
	},
  {
		title:"Konferensresa till Belgrad",
		location:"Avresa året runt | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Här spenderar ni tre dagar i Belgrad där ni mellan konferenser och teambuildning njuter av den pulserade staden. ",
		price:"9000",
		imageUrl:"beograd.jpg",
    href:"/belgrad", // Ensure the href property is set correctly
	},
  {
		title:"Höstpaket",
		location:"Avresa året om | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Hör av er till oss så tar vi fram det bästa resepaket som passar just er ",
		
		imageUrl:"jesen.jpg",
    href:"/contact", // Ensure the href property is set correctly
	},
  {
		title:"Ekologik matupplevelse",
		location:"Avresa året om | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Hör av er till oss så tar vi fram det bästa resepaket som passar just er ",
		
		imageUrl:"ovcepriroda.jpg",
    href:"/contact", // Ensure the href property is set correctly
	},
  {
		title:"Kolašin Village vinteräventyr",
		location:"Avresa november-april | Flyg från Stockholm, Göteborg | 4* hotell",
		description:"Hör av er till oss så tar vi fram det bästa resepaket som passar just er ",

		imageUrl:"kolasin2.jpg",
    href:"/contact", // Ensure the href property is set correctly
	},
]

---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    
    title="Vi sammanför Montenegro med Skandinavien"
    subtitle="Välj mellan salig utbud av redan paketerade helhetsupplevelser eller hör av er så tar vi fram skräddarsydda paket utifrån era behov."
  />

  
  {costs.map(cost => (
    <Costcard 
        title={cost.title}
        location={cost.location}
        description={cost.description}
        price={cost.price}
        imageURL={cost.imageUrl}
        href={cost.href} 
    />
))}

 

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Upplev landet full av möjligheter"
    subtitle="Vi är inspirerade av Montenegros hisnande skönhet och är dedikerade till att dela vår passion för denna fantastiska destination med dig"
    actions={[
      {
        variant: 'primary',
        text: 'Kontakta oss',
        href: 'contact',
      },
    ]}
  />
</Layout>
