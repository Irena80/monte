---
// filepath: /Users/irena80/Documents/GitHub/monte/src/components/widgets/Carousel.astro
export interface Props {
  images: { src: string; alt: string }[];
}
const { images } = Astro.props;
---

<div class="carousel w-full relative overflow-hidden rounded-lg">
  {images.map((image, index) => (
    <div id={`slide${index + 1}`} class="carousel-item relative w-full">
      <img src={image.src} alt={image.alt} class="w-full h-64 sm:h-80 md:h-96 lg:h-[500px] object-cover" />
      <div
        class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between"
      >
        <a href={`#slide${index === 0 ? images.length : index}`} class="btn btn-circle">❮</a>
        <a href={`#slide${(index + 2) > images.length ? 1 : index + 2}`} class="btn btn-circle">❯</a>
      </div>
    </div>
  ))}
</div>

<!-- Daisy UI powers carousel -->
<link
  href="https://cdn.jsdelivr.net/npm/daisyui@4.12.23/dist/full.min.css"
  rel="stylesheet"
  type="text/css"
/>
<script src="https://cdn.tailwindcss.com"></script>