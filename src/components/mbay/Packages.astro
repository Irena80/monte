---
import { travelPackages } from '~/data/packages';
---

<section id="paket" aria-labelledby="paket-title" class="bg-slate-50 py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-start justify-between gap-4">
  <h2 id="paket-title" class="text-3xl font-extrabold tracking-tight sm:text-4xl">Upptäck våra reseupplevelser</h2>
  <a href="/boka" class="text-sm font-semibold text-slate-800 hover:text-slate-900">Se alla paket</a>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {travelPackages.slice(0,3).map(p => (
        <a href={p.link || '/contact'} aria-label={`Läs mer: ${p.title}`} class="group flex flex-col rounded-[34px] border border-slate-200 bg-white shadow-sm overflow-hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400/50 transition transform hover:shadow-lg hover:-translate-y-0.5 hover:border-slate-300 active:translate-y-0">
          <img src={p.imageUrl} alt={p.title} class="h-60 w-full object-cover transition duration-300 group-hover:scale-[1.03]" loading="lazy" />
          <div class="p-8 flex flex-col flex-1">
            <h3 class="text-xl font-semibold text-slate-900 mb-3 leading-snug group-hover:text-slate-950">{p.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">{p.description}</p>
            {p.price && <p class="text-sm font-semibold text-slate-900 mb-6">{p.price}</p>}
            <span class="mt-auto inline-flex items-center text-sm font-medium text-slate-400 group-hover:text-slate-500">
              <svg class="w-4 h-4 mr-1 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              <span class="sr-only">Öppna {p.title}</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>