---
import { travelPackages } from '~/data/packages';
---

<section id="paket" aria-labelledby="paket-title" class="bg-slate-50 py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-start justify-between gap-4">
  <h2 id="paket-title" class="text-3xl font-extrabold tracking-tight sm:text-4xl">Upptäck våra reseupplevelser</h2>
  <a href="/boka" class="text-sm font-semibold text-slate-800 hover:text-slate-900">Se alla paket</a>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {travelPackages.slice(0,3).map(p => (
        <div class="flex flex-col rounded-[34px] border border-slate-200 bg-white shadow-sm overflow-hidden">
          <img src={p.imageUrl} alt={p.title} class="h-60 w-full object-cover" loading="lazy" />
          <div class="p-8 flex flex-col flex-1">
            <h3 class="text-xl font-semibold text-slate-900 mb-3 leading-snug">{p.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">{p.description}</p>
            {p.price && <p class="text-sm font-semibold text-slate-900 mb-6">{p.price}</p>}
            <div class="mt-auto">
              <a href={p.link || '/contact'} class="inline-flex items-center rounded-full bg-slate-900 text-white px-8 py-3 text-sm font-semibold hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400/40 transition">
                Läs mer
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>