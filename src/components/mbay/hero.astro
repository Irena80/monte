---
/* Ingen frontmatter behövs här. */
---
<section class="relative isolate" aria-label="Hero – företagsresor till Montenegro">
  <picture>
    <source srcset="/images/hero-montenegro.avif" type="image/avif" />
    <source srcset="/images/hero-montenegro.webp" type="image/webp" />
    <img
      src="/images/hero-montenegro.jpg"
      alt="Montenegros kust med Adriatiska havet och gröna berg"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="absolute inset-0 -z-10 bg-slate-900/40"></div>

  <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
        Skräddarsydda företags- & gruppresor till Montenegro
      </h1>
      <p class="mt-4 max-w-xl text-base text-slate-100 sm:text-lg">
        AI-drivet. Personligt. Oförglömligt. Vi planerar flyg, boende, aktiviteter och allt däremellan.
      </p>
      <div class="mt-8 flex flex-wrap gap-3" role="group" aria-label="Primära åtgärder">
        <a href="#kontakt" class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow hover:opacity-95">
          Begär offert
        </a>
        <a href="#paket" class="rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white ring-1 ring-white/50 backdrop-blur hover:bg-white/20">
          Utforska paket
        </a>
      </div>
    </div>
  </div>
</section>