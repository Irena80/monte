<section id="foretagspaket" aria-labelledby="foretagspaket-title" class="company-packages py-20 bg-[#f8f9fc]">
  <div class="company-packages-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="company-packages-heading text-center mb-14">
      <span
        class="inline-block text-xs font-semibold tracking-widest uppercase mb-4"
        style="color: #a88420;"
      >
        Företagspaket
      </span>
      <h2 id="foretagspaket-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight" style="color: #0B3C5D;">
        Välj ert konferenspaket
      </h2>
      <p class="mt-4 text-gray-500 max-w-xl mx-auto text-base sm:text-lg">
        Tre genomtänkta paket för svenska företag – alla kan anpassas exakt efter era behov.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="package-grid grid lg:grid-cols-3 gap-8 items-start">
      {packages.map((pkg) => (
        <a
          href={pkg.href}
          aria-label={`Se mer om ${pkg.name}`}
          class={[
            'package-card group flex flex-col rounded-3xl overflow-hidden transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500',
            pkg.highlight
              ? 'package-card--highlight relative shadow-2xl hover:shadow-[0_30px_60px_rgba(11,60,93,0.25)] hover:-translate-y-1'
              : 'bg-white border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-0.5',
          ].join(' ')}
          style={pkg.highlight ? 'background: #0B3C5D;' : ''}
        >
          {/* Popular badge */}
          {pkg.badgeLabel && (
            <div class="absolute top-0 left-0 right-0 flex justify-center z-10">
              <span
                class="text-xs font-bold uppercase tracking-widest px-5 py-1.5 rounded-b-2xl text-white"
                style="background: #C9A227;"
              >
                {pkg.badgeLabel}
              </span>
            </div>
          )}

          {/* Image */}
          <div class="package-image-wrap relative overflow-hidden h-52 flex-shrink-0">
            <img
              src={pkg.image}
              alt={pkg.imageAlt}
              class="package-image w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div
              class="absolute inset-0"
              style={`background: linear-gradient(to top, ${pkg.highlight ? 'rgba(11,60,93,0.75)' : 'rgba(11,60,93,0.6)'}, transparent);`}
            />
            <span class="absolute bottom-4 left-5 text-white text-xs font-semibold uppercase tracking-wider bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full">
              {pkg.people}
            </span>
          </div>

          {/* Content */}
          <div class="package-card-content p-7 flex flex-col flex-1">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3
                  class={['package-title text-xl font-bold', pkg.highlight ? 'text-white' : ''].join(' ')}
                  style={pkg.highlight ? '' : 'color: #0B3C5D;'}
                >
                  {pkg.name}
                </h3>
                <p class={['package-subtitle text-sm mt-1', pkg.highlight ? 'text-blue-200/70' : 'text-gray-500'].join(' ')}>
                  {pkg.subtitle}
                </p>
              </div>
              <div class="text-right">
                <p class={['text-xs', pkg.highlight ? 'text-blue-200/60' : 'text-gray-400'].join(' ')}>
                  {pkg.priceLabel}
                </p>
                <p
                  class="package-price text-lg font-bold"
                  style={pkg.highlight ? 'color: #e8bb3d;' : 'color: #a88420;'}
                >
                  {pkg.price}
                </p>
                <p class={['package-price-unit text-xs', pkg.highlight ? 'text-blue-200/60' : 'text-gray-400'].join(' ')}>
                  {pkg.priceUnit}
                </p>
              </div>
            </div>

            <div class="mb-5">
              <span class="package-duration"
                class={[
                  'text-xs px-3 py-1 rounded-full font-medium',
                  pkg.highlight
                    ? 'bg-white/10 text-blue-100'
                    : pkg.id === 'premium-offsite'
                    ? 'bg-amber-50 text-amber-700'
                    : 'bg-blue-50 text-blue-700',
                ].join(' ')}
              >
                {pkg.days}
              </span>
            </div>

            <ul class="package-features space-y-2.5 mb-7 flex-1">
              {pkg.features.map((f) => (
                <li
                  class={['package-feature flex items-center gap-2.5 text-sm', pkg.highlight ? 'text-blue-100/80' : 'text-gray-600'].join(' ')}
                >
                  <svg
                    class="w-4 h-4 flex-shrink-0"
                    style={pkg.highlight ? 'color: #e8bb3d;' : 'color: #C9A227;'}
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <div
              class={[
                'package-cta',
                'flex items-center justify-center gap-2 py-3.5 rounded-xl font-semibold text-sm transition-all duration-300 group-hover:shadow-lg mt-auto',
                pkg.ctaStyle === 'gold'
                  ? 'text-white group-hover:opacity-90'
                  : 'text-white',
              ].join(' ')}
              style={pkg.ctaStyle === 'gold' ? 'background: #C9A227;' : 'background: #0B3C5D;'}
            >
              {pkg.ctaLabel}
              <svg
                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="package-bottom-cta-wrap mt-12 text-center">
      <a
        href="#kontakt"
        class="package-bottom-cta inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold text-sm text-white transition-all duration-300 hover:scale-105 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
        style="background: #0B3C5D; box-shadow: 0 6px 24px rgba(11,60,93,0.25);"
      >
        Boka ett kostnadsfritt möte
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

