---
/* Ingen frontmatter behövs */
---
<section id="varfor" aria-labelledby="usp" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <h2 id="usp" class="sr-only">Varför välja MediteranoBay</h2>
  <div class="grid gap-6 sm:grid-cols-3">
    <!-- Kort 1 -->
    <div class="rounded-2xl border border-slate-200 p-6 bg-white shadow-sm">
      <div class="mb-3 text-2xl">🌍</div>
      <h3 class="text-lg font-semibold">Lokal expertis</h3>
      <p class="mt-1 text-sm text-slate-600">
        Team på plats i Montenegro & Balkan — rätt partnernätverk och bästa säsongstipsen.
      </p>
    </div>
    <!-- Kort 2 -->
    <div class="rounded-2xl border border-slate-200 p-6 bg-white shadow-sm">
      <div class="mb-3 text-2xl">🤖</div>
      <h3 class="text-lg font-semibold">AI-planering</h3>
      <p class="mt-1 text-sm text-slate-600">
        Snabb offert och smart resplan — effektivt, transparent och anpassat ert team.
      </p>
    </div>
    <!-- Kort 3 -->
    <div class="rounded-2xl border border-slate-200 p-6 bg-white shadow-sm">
      <div class="mb-3 text-2xl">✨</div>
      <h3 class="text-lg font-semibold">Premiumservice</h3>
      <p class="mt-1 text-sm text-slate-600">
        Från första samtal till hemresa — en kontakt, full service.
      </p>
    </div>
  </div>
</section>