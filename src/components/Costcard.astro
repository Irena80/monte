---
// filepath: /Users/irena80/Documents/GitHub/monte/src/components/Costcard.astro
interface Props {
    title: string;
    price?: string; // Make price optional
    location: string;
    description: string;
    imageURL: string;
    href: string;
}
const { title, price, location, description, imageURL, href } = Astro.props;
---

<div class="flex flex-col md:flex-row mb-6 p-4 bg-white shadow-md hover:shadow-lg rounded-lg">
    <!-- Image Section -->
    <a href={href} class="block md:w-1/3 flex-shrink-0">
        <img
            src={`../images/${imageURL}`}
            class="h-64 w-full object-cover rounded-lg"
            alt={title}
        />
    </a>

    <!-- Text Section -->
    <div class="flex flex-col justify-between md:w-2/3 md:ml-6 mt-4 md:mt-0">
        <div>
            <a href={href} class="block">
                <h1 class="font-bold text-2xl mb-2">{title}</h1>
            </a>
            <h2 class="text-gray-600 mb-4">{location}</h2>
            <p class="text-gray-700 mb-4 pr-6"> <!-- Added padding-right -->
                {description}
            </p>
        </div>
        {price && (
            <div class="mt-4">
                <h3 class="text-xl font-bold text-blue-600">Pris från: {price} sek</h3>
            </div>
        )}
    </div>
</div>