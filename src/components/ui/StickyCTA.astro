---
/**
 * Props:
 * - text: knapptext
 * - link: länk till kontakt/offer
 * - hideOn: array av paths där knappen INTE ska synas (t.ex. ['/kontakt'])
 */
const { text = 'Begär offert', link = '/kontakt', hideOn = [] } = Astro.props;
const currentPath = Astro.url.pathname || '/';
const shouldShow = !hideOn.includes(currentPath);
---

{shouldShow && (
  <a href={link} class="sticky" aria-label={text}>
    {text}
  </a>
)}

<style>
  .sticky{
    position: fixed;
    left: 0;
    bottom: 0;
    width: 100%;
    background: var(--brand-cta-bg, #E17A3D);
    color: var(--brand-cta-text, #fff);
    text-align: center;
    font: inherit;
    font-weight: 800;
    font-size: 1.1rem;
    padding: calc(env(safe-area-inset-bottom) + .9rem) .9rem .9rem;
    text-decoration: none;
    z-index: 999;
    box-shadow: 0 -2px 6px rgba(0,0,0,.2);
    transition: .2s;
  }
  .sticky:hover{ background: var(--brand-cta-bg-hover, #F18C4F); }
  /* Visa bara på mobil */
  @media (min-width: 768px){ .sticky{ display:none; } }
</style>