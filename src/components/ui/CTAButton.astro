---
const { text = 'Begär offert', link = '/kontakt', ariaLabel = '' } = Astro.props;
---

<a href={link} class="cta" aria-label={ariaLabel || text}>
  {text}
</a>

<style>
  .cta{
    display:inline-block;
    background: var(--brand-cta-bg, #E17A3D);
    color: var(--brand-cta-text, #fff);
    font: inherit;                /* tar ditt nuvarande typsnitt */
    font-weight: 700;
    font-size: 1.1rem;
    padding: .75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: .2s ease-in-out;
  }
  .cta:hover{
    background: var(--brand-cta-bg-hover, #F18C4F);
    box-shadow: 0 4px 8px rgba(0,0,0,.2);
    transform: translateY(-2px);
  }
  @media (max-width: 768px){
    .cta{ font-size: 1rem; padding: .65rem 1.2rem; }
  }
</style>